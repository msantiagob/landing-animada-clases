# Configuración para producción
NODE_ENV=production
PORT=3000

# JWT Secret - CAMBIA ESTO EN PRODUCCIÓN
# Genera una clave segura con: openssl rand -hex 32
JWT_SECRET=your-super-secret-production-jwt-key-change-this-immediately

# Database
DATABASE_PATH=./database.sqlite

# Configuración de Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password

# Analytics (opcional)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Configuración de dominio (opcional)
DOMAIN=https://tu-dominio.com

# Configuración de SSL (opcional)
SSL_KEY_PATH=./ssl/key.pem
SSL_CERT_PATH=./ssl/cert.pem