# --- Obligatorias -------------------------------------------------------------
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Secreto de firma de JWT. Mínimo 32 caracteres. El servidor NO arranca sesiones
# sin esto. Generalo con: openssl rand -hex 32
JWT_SECRET=

# Ruta del SQLite. En Railway tiene que apuntar al volumen persistente.
DATABASE_PATH=/app/data/database.sqlite

# --- Notificaciones por email (opcional) --------------------------------------
# Si faltan, los formularios se guardan igual en la base; solo no se envía aviso.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@sonmyd.com
CONTACT_NOTIFICATION_EMAIL=hola@sonmyd.com

# --- Seed del admin (solo para correr scripts/create-admin.mjs) ----------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
