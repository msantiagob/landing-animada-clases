---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import LeadCapture from '~/components/widgets/LeadCapture.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { breadcrumbSchema, itemListSchema } from '~/utils/seo';

/**
 * Página HUB, no landing.
 *
 * "Servicios" no es una keyword: nadie busca eso. Esta página no compite por
 * posiciones; su trabajo es distribuir autoridad hacia las páginas pilar y dar
 * una entrada única a quien llega sin saber qué necesita. Por eso no repite el
 * contenido de los pilares: los enlaza.
 */
const PATH = '/servicios';

const metadata = {
  title: 'Servicios: IA, automatización, desarrollo y seguridad | Sonmyd',
  description:
    'Todos los servicios de Sonmyd en un lugar: clases de IA y Python, asistentes de WhatsApp, automatizaciones, desarrollo de software a medida, servidores y ciberseguridad.',
  ignoreTitleTemplate: true,
  canonical: PATH,
};

const pilares = [
  { name: 'Asistente de WhatsApp con IA', path: '/asistente-de-whatsapp' },
  { name: 'WhatsApp Business API', path: '/whatsapp-business-api' },
  { name: 'Llamadas de marketing con IA', path: '/llamadas-de-marketing' },
  { name: 'Gestor de llamadas', path: '/gestor-de-llamadas' },
  { name: 'Clases de IA', path: '/clases-de-ia' },
  { name: 'Clases de Python', path: '/clases-de-python' },
  { name: 'Capacitaciones para empresas', path: '/capacitaciones' },
  { name: 'Automatizaciones e integraciones', path: '/automatizaciones' },
  { name: 'Desarrollo de software a medida', path: '/desarrollo-de-software' },
  { name: 'Servidores y VPS', path: '/servidores-y-vps' },
  { name: 'Ciberseguridad', path: '/ciberseguridad' },
];
---

<Layout metadata={metadata}>
  <StructuredData
    schema={[
      itemListSchema(pilares),
      breadcrumbSchema([
        { name: 'Inicio', path: '/' },
        { name: 'Servicios', path: PATH },
      ]),
    ]}
  />

  <Hero
    tagline="Servicios"
    actions={[
      { variant: 'primary', text: 'Agendar una consulta', href: '/booking', icon: 'tabler:calendar' },
      { text: 'Escribirnos', href: '#contacto', variant: 'tertiary' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?auto=format&fit=crop&w=2070&q=80',
      alt: 'Servicios de tecnología e inteligencia artificial',
    }}
  >
    <Fragment slot="title">
      Formación, automatización y <span class="text-accent">tecnología que sostiene</span> tu operación
    </Fragment>

    <Fragment slot="subtitle">
      Trabajamos en tres frentes: enseñar a tu equipo, automatizar lo que hoy se hace a mano y construir y cuidar la
      tecnología sobre la que corre tu negocio. Elegí por dónde empezar.
    </Fragment>

    <Fragment slot="trust">
      <span>Primera consulta sin costo</span>
      <span>·</span>
      <span>Hablás con quien hace el trabajo</span>
      <span>·</span>
      <span>Todo lo que construimos queda tuyo</span>
    </Fragment>
  </Hero>

  <Features
    id="ia-whatsapp"
    tagline="IA y WhatsApp"
    title="Atención automática que no parece automática"
    subtitle="Asistentes y agentes de voz que atienden, califican y agendan 24/7, sobre canales oficiales."
    columns={2}
    items={[
      {
        title: 'Asistente de WhatsApp con IA',
        description:
          'Responde en lenguaje natural, califica interesados, agenda y deriva a una persona cuando hace falta. Conectado a tu CRM.',
        icon: 'tabler:message-chatbot',
        callToAction: { text: 'Ver detalle', href: '/asistente-de-whatsapp' },
      },
      {
        title: 'WhatsApp Business API',
        description:
          'Habilitación completa con Meta: verificación del negocio, número oficial, plantillas aprobadas e integración.',
        icon: 'tabler:brand-whatsapp',
        callToAction: { text: 'Ver detalle', href: '/whatsapp-business-api' },
      },
      {
        title: 'Llamadas de marketing con IA',
        description: 'Campañas de voz automatizadas que contactan, presentan y registran el resultado de cada llamada.',
        icon: 'tabler:phone-outgoing',
        callToAction: { text: 'Ver detalle', href: '/llamadas-de-marketing' },
      },
      {
        title: 'Gestor de llamadas',
        description:
          'Recepcionista virtual que atiende, deriva y toma mensajes las 24 horas, sin que se pierda una llamada.',
        icon: 'tabler:phone-call',
        callToAction: { text: 'Ver detalle', href: '/gestor-de-llamadas' },
      },
    ]}
  />

  <Features
    id="formacion"
    tagline="Formación"
    title="Que tu equipo pueda sin depender de nadie"
    subtitle="Enseñamos los conceptos antes que las herramientas. Es más lento al principio y es lo único que sirve después."
    columns={3}
    items={[
      {
        title: 'Clases de IA',
        description:
          'Desde usar bien las herramientas hasta construir con modelos. Con un profesor que trabaja en esto todos los días.',
        icon: 'tabler:brain',
        callToAction: { text: 'Ver detalle', href: '/clases-de-ia' },
      },
      {
        title: 'Clases de Python',
        description:
          'De cero a automatizar tareas reales de tu trabajo. Individuales o para equipos, online o presencial.',
        icon: 'tabler:code',
        callToAction: { text: 'Ver detalle', href: '/clases-de-python' },
      },
      {
        title: 'Capacitaciones para empresas',
        description: 'Programas armados sobre los procesos de tu organización, con casos del área que participa.',
        icon: 'tabler:school',
        callToAction: { text: 'Ver detalle', href: '/capacitaciones' },
      },
    ]}
  />

  <Features
    id="tecnologia"
    tagline="Tecnología"
    title="Construir, conectar y sostener"
    subtitle="El software que tu operación necesita, la infraestructura donde corre y la seguridad que lo protege."
    columns={2}
    items={[
      {
        title: 'Automatizaciones e integraciones',
        description:
          'WhatsApp, Google Workspace, tu CRM y tus sistemas conectados para que los datos dejen de copiarse a mano.',
        icon: 'tabler:arrows-shuffle',
        callToAction: { text: 'Ver detalle', href: '/automatizaciones' },
      },
      {
        title: 'Desarrollo de software a medida',
        description:
          'Aplicaciones internas, APIs e integraciones con pruebas automatizadas. El código queda en tu repositorio.',
        icon: 'tabler:app-window',
        callToAction: { text: 'Ver detalle', href: '/desarrollo-de-software' },
      },
      {
        title: 'Servidores y VPS',
        description: 'Despliegue, backups probados, monitoreo con alertas y parches de seguridad al día.',
        icon: 'tabler:server',
        callToAction: { text: 'Ver detalle', href: '/servidores-y-vps' },
      },
      {
        title: 'Ciberseguridad',
        description:
          'Auditoría de accesos, segundo factor, plan de backups y capacitación del equipo. Sin vender miedo.',
        icon: 'tabler:shield-lock',
        callToAction: { text: 'Ver detalle', href: '/ciberseguridad' },
      },
    ]}
  />

  <LeadCapture
    formId="lead-servicios"
    title="¿No sabés por dónde empezar?"
    subtitle="Contanos el problema, no la solución. Con eso alcanza para decirte qué te conviene y qué no necesitás."
    button="Quiero que me orienten"
    bullets={[
      'Primera consulta sin costo ni compromiso',
      'Si no somos los indicados, te lo decimos',
      'Hablás con quien va a hacer el trabajo',
      'No compartimos tus datos con terceros',
    ]}
  />
</Layout>
