---
import Layout from '~/layouts/LandingLayout.astro';
import CyberHero from '~/components/ui/CyberHero.astro';
import TechCard from '~/components/ui/TechCard.astro';
import SuperButton from '~/components/ui/SuperButton.astro';
import StatsSection from '~/components/ui/StatsSection.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'MetaVerse Platform - Tu Universo Digital',
  description: 'Construye, explora y monetiza en el metaverso más avanzado',
};

const stats = [
  { value: '10M+', label: 'Usuarios Activos', icon: 'tabler:users', color: 'blue' },
  { value: '500K+', label: 'Mundos Creados', icon: 'tabler:world', color: 'purple' },
  { value: '$2.5B', label: 'Economia Digital', icon: 'tabler:coin', color: 'green' },
  { value: '99.9%', label: 'Uptime', icon: 'tabler:server', color: 'orange' },
];
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <CyberHero
    title="METAVERSE"
    subtitle="Tu Universo Digital Infinito"
    description="Construye mundos imposibles, conecta con personas globalmente, y crea experiencias que desafían la realidad."
    primaryButton={{
      text: "Entrar al Metaverso",
      href: "#enter",
      icon: "tabler:vr"
    }}
    secondaryButton={{
      text: "Crear Mundo",
      href: "#create",
      icon: "tabler:planet"
    }}
    background="matrix"
    particles={true}
  />

  <!-- Features Section -->
  <section class="py-20 bg-black relative overflow-hidden">
    <!-- 3D Grid Background -->
    <div class="absolute inset-0 opacity-20">
      <div class="absolute inset-0" style="background-image: 
        linear-gradient(rgba(0,212,255,0.1) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,212,255,0.1) 1px, transparent 1px);
        background-size: 100px 100px;
        transform: perspective(1000px) rotateX(45deg) scale(2);
        animation: grid3D 20s linear infinite;"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-5xl font-bold text-white mb-6">
          Experiencias <span class="text-gradient">Inmersivas</span>
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Tecnología de vanguardia que hace posible lo imposible
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <TechCard
          title="Realidad Virtual"
          description="Inmersión total con gráficos fotorealistas y física avanzada en tiempo real."
          icon="tabler:augmented-reality"
          variant="neon"
          animate={true}
        >
          <SuperButton
            variant="neon"
            size="sm"
            text="Explorar VR"
            href="#vr"
            icon="tabler:eye"
          />
        </TechCard>

        <TechCard
          title="Realidad Aumentada"
          description="Superpone elementos digitales en el mundo real con precisión milimétrica."
          icon="tabler:scan"
          variant="gradient"
          animate={true}
        >
          <SuperButton
            variant="glass"
            size="sm"
            text="Probar AR"
            href="#ar"
            icon="tabler:camera"
          />
        </TechCard>

        <TechCard
          title="Mundos Procedurales"
          description="Genera universos infinitos usando algoritmos de inteligencia artificial."
          icon="tabler:planet"
          variant="modern"
          animate={true}
        >
          <SuperButton
            variant="primary"
            size="sm"
            text="Generar"
            href="#generate"
            icon="tabler:wand"
          />
        </TechCard>

        <TechCard
          title="Avatares Hiperrealistas"
          description="Crea tu identidad digital con tecnología de escaneo facial avanzada."
          icon="tabler:user-scan"
          variant="neon"
          animate={true}
        >
          <SuperButton
            variant="neon"
            size="sm"
            text="Crear Avatar"
            href="#avatar"
            icon="tabler:user-plus"
          />
        </TechCard>

        <TechCard
          title="Economía Digital"
          description="Monetiza tus creaciones con NFTs, criptomonedas y marketplace integrado."
          icon="tabler:currency-bitcoin"
          variant="gradient"
          animate={true}
        >
          <SuperButton
            variant="glass"
            size="sm"
            text="Monetizar"
            href="#economy"
            icon="tabler:coin"
          />
        </TechCard>

        <TechCard
          title="Colaboración Global"
          description="Trabaja y socializa con personas de todo el mundo en tiempo real."
          icon="tabler:world-share"
          variant="modern"
          animate={true}
        >
          <SuperButton
            variant="primary"
            size="sm"
            text="Conectar"
            href="#collaborate"
            icon="tabler:link"
          />
        </TechCard>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <StatsSection
    title="Ecosistema Metaverso"
    subtitle="Una comunidad global que crece exponencialmente"
    stats={stats}
    variant="glass"
    columns={4}
    animate={true}
  />

  <!-- Use Cases Section -->
  <section class="py-20 bg-cyber relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute w-full h-full bg-gradient-to-r from-pink-500/10 via-purple-500/10 to-blue-500/10 animate-pulse"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-5xl font-bold text-white mb-6">
          Casos de <span class="text-neon">Uso</span>
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Descubre cómo el metaverso está transformando industrias
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Education -->
        <div class="glass rounded-3xl p-8 hover-lift">
          <div class="text-center mb-6">
            <div class="w-20 h-20 bg-gradient-to-br from-green-500 to-emerald-600 rounded-3xl flex items-center justify-center mx-auto mb-4 animate-float">
              <Icon name="tabler:school" class="w-10 h-10 text-white" />
            </div>
            <h3 class="text-2xl font-bold text-gradient mb-4">Educación</h3>
            <p class="text-gray-300 mb-6">Aprende historia visitando Roma antigua o estudia biología dentro de una célula.</p>
          </div>
          <SuperButton
            variant="glass"
            size="sm"
            text="Explorar Educación"
            href="#education"
            icon="tabler:book"
            class="w-full"
          />
        </div>

        <!-- Business -->
        <div class="glass rounded-3xl p-8 hover-lift">
          <div class="text-center mb-6">
            <div class="w-20 h-20 bg-gradient-to-br from-blue-500 to-purple-600 rounded-3xl flex items-center justify-center mx-auto mb-4 animate-float">
              <Icon name="tabler:briefcase" class="w-10 h-10 text-white" />
            </div>
            <h3 class="text-2xl font-bold text-gradient mb-4">Negocios</h3>
            <p class="text-gray-300 mb-6">Oficinas virtuales, reuniones inmersivas y colaboración sin límites geográficos.</p>
          </div>
          <SuperButton
            variant="glass"
            size="sm"
            text="Crear Oficina"
            href="#business"
            icon="tabler:building"
            class="w-full"
          />
        </div>

        <!-- Entertainment -->
        <div class="glass rounded-3xl p-8 hover-lift">
          <div class="text-center mb-6">
            <div class="w-20 h-20 bg-gradient-to-br from-pink-500 to-red-600 rounded-3xl flex items-center justify-center mx-auto mb-4 animate-float">
              <Icon name="tabler:device-gamepad" class="w-10 h-10 text-white" />
            </div>
            <h3 class="text-2xl font-bold text-gradient mb-4">Entretenimiento</h3>
            <p class="text-gray-300 mb-6">Conciertos virtuales, juegos multijugador y experiencias cinematográficas.</p>
          </div>
          <SuperButton
            variant="glass"
            size="sm"
            text="Jugar Ahora"
            href="#entertainment"
            icon="tabler:play"
            class="w-full"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Creator Economy Section -->
  <section id="create" class="py-20 bg-tech relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute w-96 h-96 bg-yellow-500/10 rounded-full blur-3xl animate-pulse top-1/4 left-1/4"></div>
      <div class="absolute w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl animate-pulse bottom-1/4 right-1/4"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-5xl font-bold text-white mb-6">
          Economía de <span class="text-gradient">Creadores</span>
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Monetiza tu creatividad como nunca antes
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-8">
          <div class="flex items-start space-x-4">
            <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center flex-shrink-0">
              <Icon name="tabler:brush" class="w-6 h-6 text-white" />
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-2">Herramientas de Creación</h3>
              <p class="text-gray-300">Editor visual intuitivo para crear mundos, objetos y experiencias sin programar.</p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center flex-shrink-0">
              <Icon name="tabler:currency-dollar" class="w-6 h-6 text-white" />
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-2">Monetización Directa</h3>
              <p class="text-gray-300">Vende NFTs, cobra por acceso a mundos premium y recibe donaciones de fans.</p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-600 rounded-xl flex items-center justify-center flex-shrink-0">
              <Icon name="tabler:users" class="w-6 h-6 text-white" />
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-2">Comunidad Global</h3>
              <p class="text-gray-300">Conecta con millones de usuarios y construye tu audiencia en el metaverso.</p>
            </div>
          </div>
        </div>

        <div class="glass rounded-3xl p-8">
          <div class="text-center mb-6">
            <h3 class="text-3xl font-bold text-gradient mb-4">Ganancias Promedio</h3>
            <div class="space-y-4">
              <div class="flex justify-between items-center">
                <span class="text-gray-300">Creadores Nuevos</span>
                <span class="text-2xl font-bold text-green-400">$500/mes</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-300">Creadores Establecidos</span>
                <span class="text-2xl font-bold text-blue-400">$5,000/mes</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-300">Creadores Elite</span>
                <span class="text-2xl font-bold text-purple-400">$50,000/mes</span>
              </div>
            </div>
          </div>
          
          <SuperButton
            variant="glow"
            size="lg"
            text="Comenzar a Crear"
            href="#start-creating"
            icon="tabler:rocket"
            pulse={true}
            class="w-full"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section id="enter" class="py-20 bg-matrix relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute w-full h-full bg-gradient-to-r from-transparent via-cyan-500/20 to-transparent animate-pulse"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-6xl font-bold text-white mb-6">
        El Futuro es <span class="text-neon">Ahora</span>
      </h2>
      <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
        Únete a la revolución digital y construye el metaverso del mañana
      </p>
      
      <div class="flex flex-col sm:flex-row gap-6 justify-center">
        <SuperButton
          variant="glow"
          size="xl"
          text="Entrar Gratis"
          href="/signup"
          icon="tabler:login"
          pulse={true}
        />
        
        <SuperButton
          variant="neon"
          size="xl"
          text="Ver Demostración"
          href="/demo"
          icon="tabler:play"
        />
      </div>
      
      <p class="text-sm text-gray-400 mt-6">
        Compatible con PC, Mac, iOS, Android y VR headsets
      </p>
    </div>
  </section>
</Layout>

<style>
  @keyframes grid3D {
    0% { transform: perspective(1000px) rotateX(45deg) scale(2) translateX(0); }
    100% { transform: perspective(1000px) rotateX(45deg) scale(2) translateX(-100px); }
  }
</style>