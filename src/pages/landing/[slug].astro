---
export const prerender = false;

import { dbHelpers } from '../../lib/database';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Contact from '~/components/widgets/Contact.astro';

const { slug } = Astro.params;

// Get the landing page by slug
const page = dbHelpers.getLandingPageBySlug(slug as string);

// If page doesn't exist or is not published, return 404
if (!page || page.status !== 'published') {
  return Astro.redirect('/404');
}
const config = page.config ? JSON.parse(page.config) : {};

const metadata = {
  title: page.seo_title || page.name,
  description: page.seo_description || config.description,
  robots: {
    index: page.status === 'published',
    follow: page.status === 'published',
  },
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <HeroText 
    tagline={config.type === 'sales' ? 'Oferta especial' : config.type === 'event' ? 'Evento exclusivo' : 'Descubre más'}
    title={page.name}
    subtitle={config.description || 'Descubre todo lo que tenemos para ofrecerte'}
  />

  <!-- Content based on template -->
  {page.template === 'hero-form' && (
    <Contact
      id="landing-form"
      title="¡Contáctanos ahora!"
      subtitle="Completa el formulario y nos pondremos en contacto contigo"
      inputs={[
        {
          type: 'text',
          name: 'name',
          label: 'Nombre *',
          placeholder: 'Tu nombre completo'
        },
        {
          type: 'email',
          name: 'email',
          label: 'Email *',
          placeholder: 'tu@email.com'
        },
        {
          type: 'tel',
          name: 'phone',
          label: 'Teléfono',
          placeholder: '+57 300 123 4567'
        }
      ]}
      textarea={{
        label: 'Mensaje *',
        placeholder: 'Cuéntanos sobre tu interés...',
        rows: 4
      }}
      disclaimer={{
        label: 'Acepto recibir comunicaciones comerciales y ofertas especiales'
      }}
      description="Respuesta garantizada en menos de 2 horas."
    />
  )}

  {page.template === 'features' && (
    <div class="px-6 py-16 mx-auto max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 bg-blue-100 rounded-full flex items-center justify-center">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Rápido</h3>
          <p class="text-gray-600">Implementación y resultados en tiempo récord</p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 bg-green-100 rounded-full flex items-center justify-center">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Confiable</h3>
          <p class="text-gray-600">Calidad garantizada y soporte 24/7</p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 bg-purple-100 rounded-full flex items-center justify-center">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Escalable</h3>
          <p class="text-gray-600">Crece junto con tu negocio</p>
        </div>
      </div>
    </div>
  )}

  {page.template === 'pricing' && (
    <div class="px-6 py-16 mx-auto max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg shadow-lg p-8 text-center">
          <h3 class="text-2xl font-bold mb-4">Básico</h3>
          <div class="text-4xl font-bold text-blue-600 mb-4">$99<span class="text-lg text-gray-600">/mes</span></div>
          <ul class="space-y-3 mb-8">
            <li>✓ Funcionalidad básica</li>
            <li>✓ Soporte por email</li>
            <li>✓ 1 GB de almacenamiento</li>
          </ul>
          <button class="w-full bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700">Comenzar</button>
        </div>

        <div class="bg-blue-600 text-white rounded-lg shadow-lg p-8 text-center transform scale-105">
          <h3 class="text-2xl font-bold mb-4">Profesional</h3>
          <div class="text-4xl font-bold mb-4">$199<span class="text-lg opacity-75">/mes</span></div>
          <ul class="space-y-3 mb-8">
            <li>✓ Todas las funciones básicas</li>
            <li>✓ Soporte prioritario</li>
            <li>✓ 10 GB de almacenamiento</li>
            <li>✓ Análisis avanzados</li>
          </ul>
          <button class="w-full bg-white text-blue-600 py-3 rounded-lg hover:bg-gray-100">Comenzar</button>
        </div>

        <div class="bg-white rounded-lg shadow-lg p-8 text-center">
          <h3 class="text-2xl font-bold mb-4">Empresarial</h3>
          <div class="text-4xl font-bold text-blue-600 mb-4">$399<span class="text-lg text-gray-600">/mes</span></div>
          <ul class="space-y-3 mb-8">
            <li>✓ Funciones ilimitadas</li>
            <li>✓ Soporte 24/7</li>
            <li>✓ Almacenamiento ilimitado</li>
            <li>✓ API personalizada</li>
          </ul>
          <button class="w-full bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700">Contactar</button>
        </div>
      </div>
    </div>
  )}

  <!-- CTA Section -->
  {config.conversionGoal && (
    <div class="bg-blue-600 text-white py-16">
      <div class="px-6 mx-auto max-w-4xl text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">
          {config.conversionGoal === 'email-signup' ? '¡No te pierdas ninguna novedad!' :
           config.conversionGoal === 'contact-form' ? '¿Listo para comenzar?' :
           config.conversionGoal === 'appointment' ? 'Agenda tu consulta gratuita' :
           '¡Actúa ahora!'}
        </h2>
        <p class="text-xl mb-8 opacity-90">
          {config.conversionGoal === 'email-signup' ? 'Suscríbete para recibir las últimas actualizaciones' :
           config.conversionGoal === 'contact-form' ? 'Contáctanos y transformemos tu negocio juntos' :
           config.conversionGoal === 'appointment' ? 'Reserva tu cita y descubre cómo podemos ayudarte' :
           'Aprovecha esta oportunidad única'}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          {config.conversionGoal === 'appointment' ? (
            <a href="/booking" class="bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors">
              Agendar Cita
            </a>
          ) : (
            <a href="/contact" class="bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors">
              Contactar Ahora
            </a>
          )}
          <a href="/" class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white hover:text-blue-600 transition-colors">
            Explorar Más
          </a>
        </div>
      </div>
    </div>
  )}

  <!-- Analytics tracking -->
  {config.trackingCode && (
    <script type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${config.trackingCode}`}></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', config.trackingCode);
    </script>
  )}
</Layout>

<script>
  // Track page view for landing page analytics
  document.addEventListener('DOMContentLoaded', () => {
    // Send analytics event
    fetch('/api/analytics', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        eventType: 'page_view',
        pageUrl: window.location.pathname,
        referrer: document.referrer,
        metadata: {
          landingPage: true,
          template: '${page.template}',
          status: '${page.status}'
        }
      })
    }).catch(error => {
      console.log('Analytics tracking failed:', error);
    });
  });
</script>