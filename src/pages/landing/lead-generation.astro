---
import Layout from '~/layouts/LandingLayout.astro';
import CyberHero from '~/components/ui/CyberHero.astro';
import TechCard from '~/components/ui/TechCard.astro';
import SuperButton from '~/components/ui/SuperButton.astro';
import StatsSection from '~/components/ui/StatsSection.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'LeadGen AI - Generación de Leads con IA',
  description: 'Convierte visitantes en clientes con inteligencia artificial avanzada',
};

const stats = [
  { value: '340%', label: 'Aumento Conversiones', icon: 'tabler:trending-up', color: 'green' },
  { value: '65%', label: 'Reducción Costo/Lead', icon: 'tabler:coin', color: 'blue' },
  { value: '2.5M+', label: 'Leads Generados', icon: 'tabler:users', color: 'purple' },
  { value: '24hrs', label: 'Setup Promedio', icon: 'tabler:clock', color: 'orange' },
];
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <CyberHero
    title="LEADGEN AI"
    subtitle="Generación de Leads con Inteligencia Artificial"
    description="Transforma visitantes casuales en clientes de alto valor usando IA avanzada, automatización inteligente y análisis predictivo."
    primaryButton={{
      text: "Prueba Gratis 14 Días",
      href: "#trial",
      icon: "tabler:magnet"
    }}
    secondaryButton={{
      text: "Ver Demo en Vivo",
      href: "#demo",
      icon: "tabler:play"
    }}
    background="cyber"
    particles={true}
  />

  <!-- Features Section -->
  <section class="py-20 bg-black relative overflow-hidden">
    <!-- AI Neural Network Background -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: 
        radial-gradient(circle at 25% 25%, rgba(59, 130, 246, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 75% 75%, rgba(147, 51, 234, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 75% 25%, rgba(34, 197, 94, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 25% 75%, rgba(251, 146, 60, 0.3) 0%, transparent 50%);
        animation: neuralPulse 8s ease-in-out infinite;"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-5xl font-bold text-white mb-6">
          IA <span class="text-gradient">Revolucionaria</span>
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Herramientas de próxima generación que convierten más visitantes en leads calificados
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <TechCard
          title="Behavioral AI"
          description="Analiza el comportamiento del visitante en tiempo real y predice la intención de compra."
          icon="tabler:brain"
          variant="neon"
          animate={true}
        >
          <SuperButton
            variant="neon"
            size="sm"
            text="Ver en Acción"
            href="#behavior"
            icon="tabler:eye"
          />
        </TechCard>

        <TechCard
          title="Smart Forms"
          description="Formularios adaptativos que se personalizan según el perfil del visitante."
          icon="tabler:forms"
          variant="gradient"
          animate={true}
        >
          <SuperButton
            variant="glass"
            size="sm"
            text="Crear Formulario"
            href="#forms"
            icon="tabler:plus"
          />
        </TechCard>

        <TechCard
          title="Predictive Scoring"
          description="Algoritmos ML que califican leads automáticamente por probabilidad de conversión."
          icon="tabler:target"
          variant="modern"
          animate={true}
        >
          <SuperButton
            variant="primary"
            size="sm"
            text="Configurar"
            href="#scoring"
            icon="tabler:settings"
          />
        </TechCard>

        <TechCard
          title="Real-time Personalization"
          description="Personaliza contenido, ofertas y CTAs basado en datos del visitante."
          icon="tabler:user-check"
          variant="neon"
          animate={true}
        >
          <SuperButton
            variant="neon"
            size="sm"
            text="Personalizar"
            href="#personalization"
            icon="tabler:wand"
          />
        </TechCard>

        <TechCard
          title="Automation Flows"
          description="Secuencias automatizadas multicanal que nutren leads hasta la conversión."
          icon="tabler:robot"
          variant="gradient"
          animate={true}
        >
          <SuperButton
            variant="glass"
            size="sm"
            text="Automatizar"
            href="#automation"
            icon="tabler:play"
          />
        </TechCard>

        <TechCard
          title="Analytics Dashboard"
          description="Insights avanzados y métricas predictivas para optimizar continuamente."
          icon="tabler:chart-line"
          variant="modern"
          animate={true}
        >
          <SuperButton
            variant="primary"
            size="sm"
            text="Ver Dashboard"
            href="#analytics"
            icon="tabler:dashboard"
          />
        </TechCard>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <StatsSection
    title="Resultados Comprobados"
    subtitle="Datos reales de más de 10,000 empresas"
    stats={stats}
    variant="glass"
    columns={4}
    animate={true}
  />

  <!-- Demo Section -->
  <section id="demo" class="py-20 bg-matrix relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute w-full h-full bg-gradient-to-r from-blue-500/10 via-purple-500/10 to-pink-500/10 animate-pulse"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-5xl font-bold text-white mb-6">
          Demo <span class="text-neon">Interactivo</span>
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Experimenta el poder de LeadGen AI en tiempo real
        </p>
      </div>

      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Before/After Comparison -->
          <div class="glass rounded-3xl p-8">
            <h3 class="text-2xl font-bold text-gradient mb-6 text-center">Comparación Antes/Después</h3>
            
            <div class="space-y-6">
              <div class="bg-red-500/10 border border-red-500/30 rounded-2xl p-6">
                <h4 class="text-lg font-bold text-red-400 mb-4">Sin LeadGen AI</h4>
                <div class="space-y-3">
                  <div class="flex justify-between">
                    <span class="text-gray-300">Conversión Landing Page</span>
                    <span class="text-red-400">2.1%</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-300">Lead Quality Score</span>
                    <span class="text-red-400">45/100</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-300">Costo por Lead</span>
                    <span class="text-red-400">$85</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-300">Setup Time</span>
                    <span class="text-red-400">3 semanas</span>
                  </div>
                </div>
              </div>

              <div class="bg-green-500/10 border border-green-500/30 rounded-2xl p-6">
                <h4 class="text-lg font-bold text-green-400 mb-4">Con LeadGen AI</h4>
                <div class="space-y-3">
                  <div class="flex justify-between">
                    <span class="text-gray-300">Conversión Landing Page</span>
                    <span class="text-green-400">7.2%</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-300">Lead Quality Score</span>
                    <span class="text-green-400">88/100</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-300">Costo por Lead</span>
                    <span class="text-green-400">$29</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-300">Setup Time</span>
                    <span class="text-green-400">24 horas</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Live Demo Interface -->
          <div class="glass rounded-3xl p-8">
            <h3 class="text-2xl font-bold text-gradient mb-6 text-center">Demo en Vivo</h3>
            
            <div class="space-y-4">
              <div class="bg-white/5 rounded-2xl p-4">
                <div class="flex items-center space-x-3 mb-3">
                  <div class="w-3 h-3 bg-green-400 rounded-full animate-pulse"></div>
                  <span class="text-sm text-gray-400">Analizando visitante...</span>
                </div>
                <div class="text-sm text-gray-300">
                  📍 Madrid, España<br/>
                  💼 Empresa: 50-200 empleados<br/>
                  🎯 Intención: Alta (92% confianza)<br/>
                  ⏱️ Tiempo en página: 2:34
                </div>
              </div>

              <div class="bg-blue-500/10 border border-blue-500/30 rounded-2xl p-4">
                <div class="text-sm font-semibold text-blue-400 mb-2">IA Recommendation:</div>
                <div class="text-sm text-gray-300">
                  Mostrar formulario simplificado + demo personalizado<br/>
                  Probabilidad conversión: 84%
                </div>
              </div>

              <div class="bg-purple-500/10 border border-purple-500/30 rounded-2xl p-4">
                <div class="text-sm font-semibold text-purple-400 mb-2">Trigger Activado:</div>
                <div class="text-sm text-gray-300">
                  Popup inteligente con oferta personalizada activado<br/>
                  Descuento: 20% (optimizado para este perfil)
                </div>
              </div>
            </div>

            <div class="mt-6">
              <SuperButton
                variant="neon"
                size="lg"
                text="Probar Demo Completo"
                href="#full-demo"
                icon="tabler:rocket"
                pulse={true}
                class="w-full"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-20 bg-tech relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute w-96 h-96 bg-blue-500/10 rounded-full blur-3xl animate-pulse top-1/4 left-1/4"></div>
      <div class="absolute w-80 h-80 bg-purple-500/10 rounded-full blur-3xl animate-pulse bottom-1/4 right-1/4"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-5xl font-bold text-white mb-6">
          Casos de <span class="text-gradient">Éxito</span>
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Empresas que transformaron sus resultados con LeadGen AI
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="glass rounded-3xl p-8 text-center">
          <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <Icon name="tabler:building" class="w-8 h-8 text-white" />
          </div>
          <blockquote class="text-gray-300 italic mb-4">
            "En 3 meses aumentamos conversiones 425% y redujimos el costo por lead 70%. ROI increíble."
          </blockquote>
          <div class="text-gradient font-semibold">Carlos Mendoza</div>
          <div class="text-gray-400 text-sm">CEO, TechStartup Inc.</div>
        </div>

        <div class="glass rounded-3xl p-8 text-center">
          <div class="w-16 h-16 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <Icon name="tabler:chart-line" class="w-8 h-8 text-white" />
          </div>
          <blockquote class="text-gray-300 italic mb-4">
            "La IA de LeadGen identificó patrones que nunca hubiéramos visto. Nuestras ventas se triplicaron."
          </blockquote>
          <div class="text-gradient font-semibold">Ana García</div>
          <div class="text-gray-400 text-sm">CMO, Digital Agency Pro</div>
        </div>

        <div class="glass rounded-3xl p-8 text-center">
          <div class="w-16 h-16 bg-gradient-to-br from-orange-500 to-red-600 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <Icon name="tabler:rocket" class="w-8 h-8 text-white" />
          </div>
          <blockquote class="text-gray-300 italic mb-4">
            "Setup en menos de 24 horas y resultados inmediatos. La mejor inversión que hemos hecho."
          </blockquote>
          <div class="text-gradient font-semibold">Luis Rodríguez</div>
          <div class="text-gray-400 text-sm">Founder, E-commerce Plus</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section id="trial" class="py-20 bg-cyber relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute w-full h-full bg-gradient-to-r from-transparent via-cyan-500/20 to-transparent animate-pulse"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-6xl font-bold text-white mb-6">
        Transforma tus <span class="text-neon">Conversiones</span>
      </h2>
      <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
        Únete a más de 10,000 empresas que ya están generando más leads con IA
      </p>
      
      <div class="flex flex-col sm:flex-row gap-6 justify-center mb-8">
        <SuperButton
          variant="glow"
          size="xl"
          text="Prueba Gratis 14 Días"
          href="/trial"
          icon="tabler:rocket"
          pulse={true}
        />
        
        <SuperButton
          variant="neon"
          size="xl"
          text="Agendar Demo Personal"
          href="/demo"
          icon="tabler:calendar"
        />
      </div>
      
      <div class="flex flex-col sm:flex-row items-center justify-center space-y-4 sm:space-y-0 sm:space-x-8 text-sm text-gray-400">
        <div class="flex items-center space-x-2">
          <Icon name="tabler:check" class="w-4 h-4 text-green-400" />
          <span>Sin tarjeta de crédito</span>
        </div>
        <div class="flex items-center space-x-2">
          <Icon name="tabler:check" class="w-4 h-4 text-green-400" />
          <span>Setup en 24 horas</span>
        </div>
        <div class="flex items-center space-x-2">
          <Icon name="tabler:check" class="w-4 h-4 text-green-400" />
          <span>Soporte 24/7</span>
        </div>
        <div class="flex items-center space-x-2">
          <Icon name="tabler:check" class="w-4 h-4 text-green-400" />
          <span>Garantía 30 días</span>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  @keyframes neuralPulse {
    0%, 100% { opacity: 0.1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(1.1); }
  }
</style>