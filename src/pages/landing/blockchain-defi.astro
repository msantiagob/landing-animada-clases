---
import Layout from '~/layouts/LandingLayout.astro';
import CyberHero from '~/components/ui/CyberHero.astro';
import TechCard from '~/components/ui/TechCard.astro';
import SuperButton from '~/components/ui/SuperButton.astro';
import StatsSection from '~/components/ui/StatsSection.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'DeFi Protocol - Finanzas Descentralizadas',
  description: 'El protocolo DeFi más avanzado para el futuro de las finanzas',
};

const stats = [
  { value: '$5.2B', label: 'TVL Bloqueado', icon: 'tabler:lock', color: 'green' },
  { value: '250K+', label: 'Usuarios Activos', icon: 'tabler:users', color: 'blue' },
  { value: '15%', label: 'APY Promedio', icon: 'tabler:trending-up', color: 'purple' },
  { value: '99.8%', label: 'Uptime', icon: 'tabler:shield-check', color: 'cyan' },
];
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <CyberHero
    title="DEFI PROTOCOL"
    subtitle="El Futuro de las Finanzas"
    description="Desbloquea el poder de las finanzas descentralizadas. Gana, presta, intercambia y administra tus activos sin intermediarios."
    primaryButton={{
      text: "Conectar Wallet",
      href: "#connect",
      icon: "tabler:wallet"
    }}
    secondaryButton={{
      text: "Explorar Pools",
      href: "#pools",
      icon: "tabler:pool"
    }}
    background="tech"
    particles={true}
  />

  <!-- Features Section -->
  <section class="py-20 bg-black relative overflow-hidden">
    <!-- Blockchain grid background -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: 
        repeating-linear-gradient(0deg, rgba(0,255,0,0.1), rgba(0,255,0,0.1) 1px, transparent 1px, transparent 50px),
        repeating-linear-gradient(90deg, rgba(0,255,0,0.1), rgba(0,255,0,0.1) 1px, transparent 1px, transparent 50px);
        animation: blockchainGrid 15s linear infinite;"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-5xl font-bold text-white mb-6">
          Protocolos <span class="text-gradient">Avanzados</span>
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Tecnología blockchain de próxima generación para finanzas sin límites
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <TechCard
          title="Yield Farming"
          description="Maximiza tus rendimientos con estrategias automatizadas y optimización de gas."
          icon="tabler:plant"
          variant="neon"
          animate={true}
        >
          <SuperButton
            variant="neon"
            size="sm"
            text="Farmear Ahora"
            href="#farming"
            icon="tabler:seed"
          />
        </TechCard>

        <TechCard
          title="Liquidity Mining"
          description="Proporciona liquidez y gana recompensas en tokens nativos del protocolo."
          icon="tabler:currency-bitcoin"
          variant="gradient"
          animate={true}
        >
          <SuperButton
            variant="glass"
            size="sm"
            text="Agregar Liquidez"
            href="#liquidity"
            icon="tabler:plus"
          />
        </TechCard>

        <TechCard
          title="Flash Loans"
          description="Préstamos instantáneos sin colateral para arbitraje y estrategias avanzadas."
          icon="tabler:bolt"
          variant="modern"
          animate={true}
        >
          <SuperButton
            variant="primary"
            size="sm"
            text="Pedir Préstamo"
            href="#flash"
            icon="tabler:zap"
          />
        </TechCard>

        <TechCard
          title="Cross-Chain Bridge"
          description="Transfiere activos entre diferentes blockchains de forma segura y rápida."
          icon="tabler:bridge"
          variant="neon"
          animate={true}
        >
          <SuperButton
            variant="neon"
            size="sm"
            text="Transferir"
            href="#bridge"
            icon="tabler:arrows-exchange"
          />
        </TechCard>

        <TechCard
          title="Governance DAO"
          description="Participa en la gobernanza del protocolo y vota sobre propuestas de mejora."
          icon="tabler:vote"
          variant="gradient"
          animate={true}
        >
          <SuperButton
            variant="glass"
            size="sm"
            text="Votar"
            href="#governance"
            icon="tabler:check"
          />
        </TechCard>

        <TechCard
          title="Smart Vaults"
          description="Bóvedas inteligentes que ejecutan estrategias DeFi complejas automáticamente."
          icon="tabler:safe"
          variant="modern"
          animate={true}
        >
          <SuperButton
            variant="primary"
            size="sm"
            text="Depositar"
            href="#vaults"
            icon="tabler:upload"
          />
        </TechCard>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <StatsSection
    title="Métricas del Protocolo"
    subtitle="Números que hablan por sí mismos"
    stats={stats}
    variant="modern"
    columns={4}
    animate={true}
  />

  <!-- Trading Interface -->
  <section id="pools" class="py-20 bg-cyber relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute w-full h-full bg-gradient-to-r from-green-500/10 via-blue-500/10 to-purple-500/10 animate-pulse"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-5xl font-bold text-white mb-6">
          Interface de <span class="text-neon">Trading</span>
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          La plataforma de trading DeFi más avanzada del mercado
        </p>
      </div>

      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Swap Interface -->
          <div class="glass rounded-3xl p-8">
            <h3 class="text-2xl font-bold text-gradient mb-6 text-center">Intercambio Instantáneo</h3>
            
            <div class="space-y-4">
              <div class="bg-white/5 rounded-2xl p-4">
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-400 text-sm">Desde</span>
                  <span class="text-gray-400 text-sm">Balance: 1,234.56</span>
                </div>
                <div class="flex items-center space-x-4">
                  <input 
                    type="text" 
                    placeholder="0.0"
                    class="flex-1 bg-transparent text-2xl text-white focus:outline-none"
                  />
                  <div class="flex items-center space-x-2 bg-white/10 rounded-xl px-4 py-2">
                    <div class="w-6 h-6 bg-orange-500 rounded-full"></div>
                    <span class="text-white font-semibold">BTC</span>
                    <Icon name="tabler:chevron-down" class="w-4 h-4 text-gray-400" />
                  </div>
                </div>
              </div>

              <div class="flex justify-center">
                <button class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center hover:scale-110 transition-transform">
                  <Icon name="tabler:arrow-down" class="w-5 h-5 text-white" />
                </button>
              </div>

              <div class="bg-white/5 rounded-2xl p-4">
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-400 text-sm">Hacia</span>
                  <span class="text-gray-400 text-sm">Balance: 5,678.90</span>
                </div>
                <div class="flex items-center space-x-4">
                  <input 
                    type="text" 
                    placeholder="0.0"
                    class="flex-1 bg-transparent text-2xl text-white focus:outline-none"
                  />
                  <div class="flex items-center space-x-2 bg-white/10 rounded-xl px-4 py-2">
                    <div class="w-6 h-6 bg-blue-500 rounded-full"></div>
                    <span class="text-white font-semibold">ETH</span>
                    <Icon name="tabler:chevron-down" class="w-4 h-4 text-gray-400" />
                  </div>
                </div>
              </div>

              <div class="space-y-2 text-sm text-gray-400">
                <div class="flex justify-between">
                  <span>Tasa de cambio</span>
                  <span class="text-white">1 BTC = 15.24 ETH</span>
                </div>
                <div class="flex justify-between">
                  <span>Impacto en precio</span>
                  <span class="text-green-400">0.12%</span>
                </div>
                <div class="flex justify-between">
                  <span>Comisión de red</span>
                  <span class="text-white">~$12.50</span>
                </div>
              </div>

              <SuperButton
                variant="glow"
                size="lg"
                text="Intercambiar"
                icon="tabler:arrows-exchange"
                class="w-full"
                pulse={true}
              />
            </div>
          </div>

          <!-- Liquidity Pools -->
          <div class="glass rounded-3xl p-8">
            <h3 class="text-2xl font-bold text-gradient mb-6 text-center">Pools de Liquidez</h3>
            
            <div class="space-y-4">
              <div class="bg-white/5 rounded-2xl p-4 hover:bg-white/10 transition-colors cursor-pointer">
                <div class="flex justify-between items-center">
                  <div class="flex items-center space-x-3">
                    <div class="flex -space-x-2">
                      <div class="w-8 h-8 bg-orange-500 rounded-full border-2 border-black"></div>
                      <div class="w-8 h-8 bg-blue-500 rounded-full border-2 border-black"></div>
                    </div>
                    <div>
                      <div class="font-semibold text-white">BTC/ETH</div>
                      <div class="text-sm text-gray-400">$2.1M TVL</div>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="text-green-400 font-bold">24.5% APY</div>
                    <div class="text-sm text-gray-400">0.3% Fee</div>
                  </div>
                </div>
              </div>

              <div class="bg-white/5 rounded-2xl p-4 hover:bg-white/10 transition-colors cursor-pointer">
                <div class="flex justify-between items-center">
                  <div class="flex items-center space-x-3">
                    <div class="flex -space-x-2">
                      <div class="w-8 h-8 bg-green-500 rounded-full border-2 border-black"></div>
                      <div class="w-8 h-8 bg-blue-500 rounded-full border-2 border-black"></div>
                    </div>
                    <div>
                      <div class="font-semibold text-white">USDC/ETH</div>
                      <div class="text-sm text-gray-400">$5.8M TVL</div>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="text-green-400 font-bold">18.2% APY</div>
                    <div class="text-sm text-gray-400">0.3% Fee</div>
                  </div>
                </div>
              </div>

              <div class="bg-white/5 rounded-2xl p-4 hover:bg-white/10 transition-colors cursor-pointer">
                <div class="flex justify-between items-center">
                  <div class="flex items-center space-x-3">
                    <div class="flex -space-x-2">
                      <div class="w-8 h-8 bg-purple-500 rounded-full border-2 border-black"></div>
                      <div class="w-8 h-8 bg-green-500 rounded-full border-2 border-black"></div>
                    </div>
                    <div>
                      <div class="font-semibold text-white">DEFI/USDC</div>
                      <div class="text-sm text-gray-400">$892K TVL</div>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="text-green-400 font-bold">45.7% APY</div>
                    <div class="text-sm text-gray-400">0.3% Fee</div>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-6 pt-6 border-t border-white/10">
              <SuperButton
                variant="glass"
                size="lg"
                text="Ver Todos los Pools"
                href="#all-pools"
                icon="tabler:pool"
                class="w-full"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Security Section -->
  <section class="py-20 bg-matrix relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl animate-pulse top-1/4 right-1/4"></div>
      <div class="absolute w-80 h-80 bg-green-500/10 rounded-full blur-3xl animate-pulse bottom-1/4 left-1/4"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-5xl font-bold text-white mb-6">
          Seguridad <span class="text-gradient">Máxima</span>
        </h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Auditorías múltiples y protocolos de seguridad de grado institucional
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-20 h-20 bg-gradient-to-br from-green-500 to-emerald-600 rounded-3xl flex items-center justify-center mx-auto mb-6 animate-float">
            <Icon name="tabler:shield-check" class="w-10 h-10 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">Auditorías Múltiples</h3>
          <p class="text-gray-300">Auditado por CertiK, Trail of Bits y ConsenSys Diligence</p>
        </div>

        <div class="text-center">
          <div class="w-20 h-20 bg-gradient-to-br from-blue-500 to-cyan-600 rounded-3xl flex items-center justify-center mx-auto mb-6 animate-float">
            <Icon name="tabler:lock" class="w-10 h-10 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">Multi-Sig Wallets</h3>
          <p class="text-gray-300">Fondos protegidos con carteras multi-firma de 7-12</p>
        </div>

        <div class="text-center">
          <div class="w-20 h-20 bg-gradient-to-br from-purple-500 to-pink-600 rounded-3xl flex items-center justify-center mx-auto mb-6 animate-float">
            <Icon name="tabler:bug" class="w-10 h-10 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">Bug Bounty</h3>
          <p class="text-gray-300">Programa de recompensas de hasta $1M por vulnerabilidades</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section id="connect" class="py-20 bg-tech relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute w-full h-full bg-gradient-to-r from-transparent via-green-500/20 to-transparent animate-pulse"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-6xl font-bold text-white mb-6">
        Comienza tu Viaje <span class="text-neon">DeFi</span>
      </h2>
      <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
        Únete a la revolución financiera descentralizada y toma control de tus finanzas
      </p>
      
      <div class="flex flex-col sm:flex-row gap-6 justify-center mb-8">
        <SuperButton
          variant="glow"
          size="xl"
          text="Conectar Wallet"
          href="/connect"
          icon="tabler:wallet"
          pulse={true}
        />
        
        <SuperButton
          variant="neon"
          size="xl"
          text="Explorar Protocolo"
          href="/explore"
          icon="tabler:compass"
        />
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-2xl mx-auto">
        <div class="flex items-center justify-center space-x-2 glass rounded-xl p-3">
          <div class="w-6 h-6 bg-orange-500 rounded-full"></div>
          <span class="text-white font-semibold">MetaMask</span>
        </div>
        <div class="flex items-center justify-center space-x-2 glass rounded-xl p-3">
          <div class="w-6 h-6 bg-blue-500 rounded-full"></div>
          <span class="text-white font-semibold">WalletConnect</span>
        </div>
        <div class="flex items-center justify-center space-x-2 glass rounded-xl p-3">
          <div class="w-6 h-6 bg-purple-500 rounded-full"></div>
          <span class="text-white font-semibold">Ledger</span>
        </div>
        <div class="flex items-center justify-center space-x-2 glass rounded-xl p-3">
          <div class="w-6 h-6 bg-green-500 rounded-full"></div>
          <span class="text-white font-semibold">Trezor</span>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  @keyframes blockchainGrid {
    0% { transform: translateX(0) translateY(0); }
    100% { transform: translateX(-50px) translateY(-50px); }
  }
</style>