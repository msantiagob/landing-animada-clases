---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Acerca de Sonmyd - Líderes en Soluciones Tecnológicas',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Acerca de nosotros"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Caos Image',
    }}
  >
    <Fragment slot="title">
      Transformamos negocios con <br />
      <span class="text-accent dark:text-white"> Soluciones Tecnológicas de Vanguardia</span>
    </Fragment>

    <Fragment slot="subtitle">
      Somos una empresa líder en el desarrollo de soluciones tecnológicas avanzadas, especializados en Inteligencia Artificial,
      desarrollo web, aplicaciones multiplataforma y automatizaciones empresariales. Con más de 15 años de experiencia,
      hemos transformado digitalmente a cientos de empresas en América Latina.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Nuestro Impacto en Números"
    stats={[
      { title: 'Países Atendidos', amount: '8' },
      { title: 'Especialistas', amount: '50+' },
      { title: 'Proyectos Exitosos', amount: '500+' },
      { title: 'Certificaciones', amount: '45+' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Nuestras Especialidades"
    subtitle="Ofrecemos soluciones tecnológicas integrales que abarcan desde IA hasta desarrollo multiplataforma, respaldadas por certificaciones internacionales y experiencia comprobada."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Inteligencia Artificial',
        description:
          'Desarrollamos chatbots inteligentes, sistemas de análisis predictivo y automatización con IA para optimizar operaciones empresariales.',
        icon: 'tabler:template',
      },
      {
        title: 'Desarrollo Web Avanzado',
        description:
          'Creamos aplicaciones web escalables, APIs robustas y sistemas de e-commerce con las últimas tecnologías del mercado.',
        icon: 'tabler:template',
      },
      {
        title: 'Apps Multiplataforma',
        description:
          'Desarrollamos aplicaciones nativas y híbridas para iOS y Android con React Native, Flutter y tecnologías nativas.',
        icon: 'tabler:template',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: 'Automatización de Procesos',
        description:
          'Implementamos RPA, workflows inteligentes y sistemas de automatización que reducen costos operativos hasta un 60%.',
        icon: 'tabler:template',
      },
      {
        title: 'Blog',
        description:
          'Nullam efficitur volutpat sem sed fringilla. Suspendisse et enim eu orci volutpat laoreet ac vitae libero.',
        icon: 'tabler:template',
      },
      {
        title: 'Capacitaciones Técnicas',
        description:
          'Programas de formación especializada en IA, desarrollo web, DevOps y metodologías ágiles con certificación internacional.',
        icon: 'tabler:template',
      },
      {
        title: 'Consultoría Digital',
        description:
          'Asesoramos en transformación digital, arquitectura de software, migración cloud y estrategias de innovación tecnológica.',
        icon: 'tabler:template',
      },
      {
        title: 'Médico',
        description:
          'Vestibulum malesuada lacus id nibh posuere feugiat. Nam volutpat nulla a felis ultrices, id suscipit mauris congue. In hac habitasse platea dictumst.',
        icon: 'tabler:template',
      },
      {
        title: 'Diseño de Moda',
        description:
          'Maecenas eu tellus eget est scelerisque lacinia et a diam. Aliquam velit lorem, vehicula id fermentum et, rhoncus et purus.',
        icon: 'tabler:template',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'Colorful Image',
    }}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Nuestros valores"
    subtitle="Nuestros valores fundamentales guían cada proyecto y relación. Creemos en la excelencia técnica, la innovación continua y el compromiso absoluto con el éxito de nuestros clientes."
    items={[
      {
        title: 'Orientación al Cliente',
        description:
          'Cada solución que desarrollamos está diseñada pensando en las necesidades específicas del cliente, garantizando resultados que superan expectativas.',
      },
      {
        title: 'Innovación Continua',
        description:
          'Mantenemos a nuestro equipo actualizado con las últimas tecnologías y tendencias, asegurando soluciones de vanguardia.',
      },
      {
        title: 'Excelencia Técnica',
        description:
          'Aplicamos las mejores prácticas de desarrollo, estándares de calidad internacional y metodologías probadas en cada proyecto.',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Logros"
    subtitle="Nuestros logros respaldan nuestra experiencia y compromiso con la excelencia. Cada reconocimiento representa la confianza de nuestros clientes y socios estratégicos."
    isReversed={true}
    callToAction={{
      text: 'Ver más',
      href: '/',
    }}
    items={[
      {
        title: 'Presencia Internacional',
        description: 'Operamos en 8 países de América Latina, con proyectos exitosos en sectores financiero, retail, salud y educación.',
        icon: 'tabler:globe',
      },
      {
        title: '98% de Satisfacción del Cliente',
        description:
          'Nuestros clientes nos evalúan consistentemente con puntuaciones superiores al 98%, respaldando nuestro compromiso con la calidad.',
        icon: 'tabler:message-star',
      },
      {
        title: 'Líderes en Innovación Tecnológica',
        description:
          'Reconocidos por Microsoft, Google y AWS como partners especializados. Certificaciones en Azure, AWS y Google Cloud Platform.',
        icon: 'tabler:award',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Oficinas Principales"
    tagline="Encuéntranos"
    columns={4}
    items={[
      {
        title: 'Colombia',
        description: 'Bogotá - Sede Principal y Centro de Innovación',
      },
      {
        title: 'México',
        description: 'Ciudad de México - Hub de Expansión Norte',
      },
      {
        title: 'Perú',
        description: 'Lima - Centro de Operaciones Regionales',
      },
      {
        title: 'Chile',
        description: 'Santiago - Oficina de Desarrollo y Soporte',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Soporte Técnico"
    tagline="Contáctanos"
    columns={2}
    items={[
      {
        title: 'Soporte en Línea 24/7',
        description:
          'Chat especializado con nuestros ingenieros para resolver dudas técnicas, consultas de proyectos y soporte de emergencia.',
        icon: 'tabler:messages',
      },
      {
        title: 'Consulta Telefónica',
        description:
          'Línea directa con nuestros especialistas para asesoría personalizada, cotizaciones y planificación de proyectos.',
        icon: 'tabler:headset',
      },
    ]}
  />
</Layout>
