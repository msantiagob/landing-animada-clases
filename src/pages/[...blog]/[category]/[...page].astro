---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogCategoryRobots, getStaticPathsBlogCategory } from '~/utils/blog';
import { getCategoryDescription, getCategorySeo } from '~/utils/blog-seo';
import type { Taxonomy } from '~/types';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogCategory({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths> & { category: Taxonomy };

const { page, category } = Astro.props as Props;

const currentPage = page.currentPage ?? 1;

/**
 * Las categorías SÍ se indexan (config.yaml) y entran al sitemap. Por eso cada una
 * lleva su propio título y su propia descripción en español: sin ellas heredaban la
 * descripción genérica del sitio, idéntica en todas las categorías.
 */
const seo = getCategorySeo(category, currentPage);

const metadata = {
  title: seo.title,
  description: seo.description,
  ignoreTitleTemplate: true,
  robots: {
    index: blogCategoryRobots?.index,
    follow: blogCategoryRobots?.follow,
  },
};
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline>
      {seo.heading}
      <Fragment slot="subtitle">{getCategoryDescription(category)}</Fragment>
    </Headline>
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</Layout>
