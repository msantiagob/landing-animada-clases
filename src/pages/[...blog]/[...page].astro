---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { breadcrumbSchema, itemListSchema } from '~/utils/seo';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

/**
 * Página pilar del blog.
 *
 * No es solo un listado: lleva texto propio que explica de qué trata el blog y
 * enlaza a las páginas de servicio. Un índice sin contenido no tiene nada por
 * lo que posicionar y no transmite autoridad hacia ningún lado.
 *
 * Solo la primera página se indexa. Las paginadas tienen títulos y contenido
 * casi idénticos: indexarlas genera competencia interna sin sumar tráfico.
 */
const metadata = {
  title:
    currentPage > 1
      ? `Blog de IA, automatización y desarrollo — Página ${currentPage}`
      : 'Blog: IA, Python, WhatsApp, automatización y seguridad | Sonmyd',
  description:
    'Artículos técnicos en español sobre inteligencia artificial, Python, WhatsApp Business API, automatización de procesos, servidores y ciberseguridad. Escritos desde proyectos reales.',
  ignoreTitleTemplate: currentPage === 1,
  canonical: currentPage > 1 ? `/blog/${currentPage}` : '/blog',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};

const TEMAS = [
  { name: 'Clases de IA', path: '/clases-de-ia' },
  { name: 'Clases de Python', path: '/clases-de-python' },
  { name: 'WhatsApp Business API', path: '/whatsapp-business-api' },
  { name: 'Automatizaciones', path: '/automatizaciones' },
  { name: 'Servidores y VPS', path: '/servidores-y-vps' },
  { name: 'Ciberseguridad', path: '/ciberseguridad' },
];
---

<Layout metadata={metadata}>
  <StructuredData
    schema={[
      itemListSchema(TEMAS),
      breadcrumbSchema([
        { name: 'Inicio', path: '/' },
        { name: 'Blog', path: '/blog' },
      ]),
    ]}
  />

  <Breadcrumbs
    items={[
      { name: 'Inicio', path: '/' },
      { name: 'Blog', path: '/blog' },
    ]}
  />

  <section class="mx-auto max-w-4xl px-6 py-12 sm:py-16">
    {
      currentPage === 1 ? (
        <header>
          <p class="eyebrow">Blog</p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-heading sm:text-5xl">Cómo funciona esto por dentro</h1>
          <p class="mt-5 text-xl leading-relaxed text-muted">
            Artículos técnicos en español sobre inteligencia artificial, Python, WhatsApp Business API, automatización,
            servidores y seguridad. Salen de proyectos reales, no de repetir documentación.
          </p>
          <p class="mt-4 text-muted">
            Cuando la respuesta honesta es que no necesitás contratar nada, también está escrita. Un artículo que solo
            te empuja a comprar no es contenido: es un anuncio largo.
          </p>

          <nav aria-label="Temas del blog" class="mt-8">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-muted">Temas</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {TEMAS.map((tema) => (
                <li>
                  <a class="pill transition-colors hover:text-heading" href={tema.path}>
                    {tema.name}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </header>
      ) : (
        <header>
          <h1 class="text-3xl font-bold tracking-tight text-heading">Blog — página {currentPage}</h1>
          <p class="mt-3 text-muted">
            <a class="underline underline-offset-4 hover:text-heading" href="/blog">
              Volver al inicio del blog
            </a>
          </p>
        </header>
      )
    }

    <div class="mt-12">
      <BlogList posts={page.data} />
      <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    </div>
  </section>
</Layout>
