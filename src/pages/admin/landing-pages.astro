    // Advanced Page Builder with full editing capabilities
    let selectedComponent = null;
    let pageBuilderData = [];
    let componentCounter = 0;

    function initAdvancedPageBuilder() {
      // Initialize drag and drop
      initDragAndDrop();
      
      // Initialize event listeners
      initPageBuilderEventListeners();
    }

    function initDragAndDrop() {
      const draggableComponents = document.querySelectorAll('.draggable-component');
      const canvas = document.getElementById('builderCanvas');
      
      draggableComponents.forEach(component => {
        component.draggable = true;
        component.addEventListener('dragstart', (e) => {
          e.dataTransfer.setData('text/plain', e.target.dataset.component);
          e.dataTransfer.effectAllowed = 'copy';
        });
      });
      
      canvas.addEventListener('dragover', (e) => {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'copy';
      });
      
      canvas.addEventListener('drop', (e) => {
        e.preventDefault();
        const componentType = e.dataTransfer.getData('text/plain');
        addComponentToCanvas(componentType);
      });
    }

    function initPageBuilderEventListeners() {
      // Preview button
      document.getElementById('previewPageBuilder').addEventListener('click', () => {
        previewPage();
      });
      
      // Save button
      document.getElementById('savePageBuilder').addEventListener('click', () => {
        savePage();
      });
    }

    function addComponentToCanvas(componentType) {
      const canvas = document.getElementById('builderCanvas');
      const emptyState = document.getElementById('emptyCanvasState');
      
      // Hide empty state if it exists
      if (emptyState) {
        emptyState.style.display = 'none';
      }
      
      // Create unique component ID
      const componentId = `component-${componentCounter++}`;
      
      // Create component data
      const componentData = {
        id: componentId,
        type: componentType,
        ...getDefaultComponentData(componentType)
      };
      
      // Add to page data
      pageBuilderData.push(componentData);
      
      // Create component element
      const componentElement = document.createElement('div');
      componentElement.className = 'component-wrapper relative group border-2 border-dashed border-gray-300 rounded-lg p-6 bg-white hover:border-blue-500 transition-all duration-300 mb-4 cursor-pointer';
      componentElement.dataset.componentId = componentId;
      componentElement.dataset.componentType = componentType;
      
      // Add component HTML
      componentElement.innerHTML = getComponentHTML(componentType, componentData);
      
      // Add controls overlay
      const controlsOverlay = document.createElement('div');
      controlsOverlay.className = 'component-controls absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex space-x-2 z-10';
      controlsOverlay.innerHTML = `
        <button class="edit-component-btn bg-blue-500 text-white p-2 rounded-lg hover:bg-blue-600 transition-colors" title="Edit Component">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
        </button>
        <button class="duplicate-component-btn bg-green-500 text-white p-2 rounded-lg hover:bg-green-600 transition-colors" title="Duplicate Component">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
        </button>
        <button class="delete-component-btn bg-red-500 text-white p-2 rounded-lg hover:bg-red-600 transition-colors" title="Delete Component">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
        </button>
      `;
      
      componentElement.appendChild(controlsOverlay);
      
      // Add event listeners
      componentElement.addEventListener('click', (e) => {
        if (!e.target.closest('.component-controls')) {
          selectComponent(componentId);
        }
      });
      
      // Add control button listeners
      controlsOverlay.querySelector('.edit-component-btn').addEventListener('click', (e) => {
        e.stopPropagation();
        selectComponent(componentId);
      });
      
      controlsOverlay.querySelector('.duplicate-component-btn').addEventListener('click', (e) => {
        e.stopPropagation();
        duplicateComponent(componentId);
      });
      
      controlsOverlay.querySelector('.delete-component-btn').addEventListener('click', (e) => {
        e.stopPropagation();
        deleteComponent(componentId);
      });
      
      // Add to canvas
      canvas.appendChild(componentElement);
      
      // Auto-select the new component
      selectComponent(componentId);
    }

