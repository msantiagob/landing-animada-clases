    // Generate slug from name
    function generateSlug(name) {
      return name
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .trim();
    }

    // Modal functions
    function showPageModal(page = null) {
      const modal = document.getElementById('pageModal');
      const title = document.getElementById('pageModalTitle');
      
      if (page) {
        isEditMode = true;
        currentPageId = page.id;
        title.textContent = 'Editar Landing Page';
        populateForm(page);
      } else {
        isEditMode = false;
        currentPageId = null;
        title.textContent = 'Nueva Landing Page';
        document.getElementById('pageForm').reset();
      }
      
      modal.classList.remove('hidden');
    }

    function populateForm(page) {
      document.getElementById('pageName').value = page.name || '';
      document.getElementById('pageSlug').value = page.slug || '';
      document.getElementById('pageType').value = page.type || '';
      document.getElementById('pageStatus').value = page.status || 'draft';
      document.getElementById('pageDescription').value = page.description || '';
      document.getElementById('pageMetaTitle').value = page.metaTitle || '';
      document.getElementById('pageMetaDescription').value = page.metaDescription || '';
      document.getElementById('pageTemplate').value = page.template || 'clean';
      document.getElementById('conversionGoal').value = page.conversionGoal || '';
      document.getElementById('trackingCode').value = page.trackingCode || '';
    }

    // Global functions
    function viewPage(slug) {
      // Open page in new tab (works for both published and draft pages)
      window.open(`/landing/${slug}`, '_blank');
    }

    async function editPage(id) {
      try {
        const response = await fetch(`/api/admin/landing-pages?id=${id}`, {
          credentials: 'include'
        });
        const data = await response.json();
        
        if (data.success && data.pages.length > 0) {
          const page = data.pages[0];
          // Map database fields to form fields
          const pageData = {
            id: page.id,
            name: page.name,
            slug: page.slug,
            type: page.config.type || 'custom',
            status: page.status,
            description: page.config.description || '',
            metaTitle: page.seo_title || '',
            metaDescription: page.seo_description || '',
            template: page.template || 'clean',
            conversionGoal: page.config.conversionGoal || '',
            trackingCode: page.config.trackingCode || ''
          };
          showPageModal(pageData);
        } else {
          alert('Error cargando la página');
        }
      } catch (error) {
        console.error('Error loading page:', error);
        alert('Error de conexión');
      }
    }

    function duplicatePage(id) {
      if (confirm('¿Quieres duplicar esta página?')) {
        console.log('Duplicating page', id);
        loadPages();
      }
    }

    async function deletePage(id) {
      if (confirm('¿Estás seguro de que quieres eliminar esta página?')) {
        try {
          const response = await fetch('/api/admin/landing-pages', {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json',
            },
            credentials: 'include',
            body: JSON.stringify({ id })
          });

          const result = await response.json();
          
          if (result.success) {
            loadPages();
            loadStats();
          } else {
            alert('Error eliminando la página: ' + result.error);
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Error de conexión');
        }
      }
    }

    // Event listeners
    document.getElementById('pageName').addEventListener('input', function() {
      if (!isEditMode) {
        document.getElementById('pageSlug').value = generateSlug(this.value);
      }
    });

    document.getElementById('statusFilter').addEventListener('change', (e) => {
      currentFilters.status = e.target.value;
      loadPages();
    });

    document.getElementById('typeFilter').addEventListener('change', (e) => {
      currentFilters.type = e.target.value;
      loadPages();
    });

    document.getElementById('refreshBtn').addEventListener('click', () => {
      loadPages();
      loadStats();
    });

    document.getElementById('newPageBtn').addEventListener('click', () => showPageModal());
    document.getElementById('pageBuilderBtn').addEventListener('click', () => {
      showPageBuilderModal();
    });
    document.getElementById('templatesBtn').addEventListener('click', () => {
      showTemplatesModal();
    });

    document.getElementById('closePageModal').addEventListener('click', () => {
      document.getElementById('pageModal').classList.add('hidden');
    });

    document.getElementById('cancelPageBtn').addEventListener('click', () => {
      document.getElementById('pageModal').classList.add('hidden');
    });

    document.getElementById('previewPageBtn').addEventListener('click', () => {
      const slug = document.getElementById('pageSlug').value;
      if (slug) {
        const previewUrl = `/landing/${slug}`;
        window.open(previewUrl, '_blank');
      } else {
        alert('Por favor ingresa un slug para generar la vista previa');
      }
    });

    document.getElementById('pageForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = {
        name: document.getElementById('pageName').value,
        slug: document.getElementById('pageSlug').value,
        type: document.getElementById('pageType').value,
        status: document.getElementById('pageStatus').value,
        description: document.getElementById('pageDescription').value,
        metaTitle: document.getElementById('pageMetaTitle').value,
        metaDescription: document.getElementById('pageMetaDescription').value,
        template: document.getElementById('pageTemplate').value,
        conversionGoal: document.getElementById('conversionGoal').value,
        trackingCode: document.getElementById('trackingCode').value
      };

      if (isEditMode) {
        formData.id = currentPageId;
      }

      // Loading state
      const saveBtn = document.getElementById('savePageBtn');
      const originalText = saveBtn.textContent;
      saveBtn.textContent = isEditMode ? 'Actualizando...' : 'Creando...';
      saveBtn.disabled = true;

      try {
        console.log('💾 Enviando datos:', formData);
        console.log('💾 Método:', isEditMode ? 'PUT' : 'POST');
        
        const response = await fetch('/api/admin/landing-pages', {
          method: isEditMode ? 'PUT' : 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'include',
          body: JSON.stringify(formData)
        });

        console.log('💾 Response status:', response.status);
        console.log('💾 Response headers:', [...response.headers.entries()]);
        
        if (!response.ok) {
          const errorText = await response.text();
          console.error('❌ Error response:', errorText);
          throw new Error(`HTTP ${response.status}: ${errorText}`);
        }

        const result = await response.json();
        console.log('💾 Response data:', result);
        
        if (result.success) {
          document.getElementById('pageModal').classList.add('hidden');
          loadPages();
          loadStats();
        } else {
          alert('Error: ' + result.error);
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error de conexión');
      } finally {
        saveBtn.textContent = originalText;
        saveBtn.disabled = false;
      }
    });

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        const response = await fetch('/api/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'logout' })
        });
        if (response.ok) {
          window.location.href = '/admin/login';
        }
      } catch (error) {
        console.error('Error logging out:', error);
      }
    });

    // Initialize page
    document.addEventListener('DOMContentLoaded', () => {
      loadStats();
      loadPages();
    });

