      loadTemplate(templateType) {
        // Limpiar canvas
        this.canvas.innerHTML = '';
        this.pageData = [];
        this.componentCounter = 0;
        
        // Cargar plantillas predefinidas
        const templates = {
          'landing-saas': ['hero-basico', 'caracteristicas', 'tabla-precios', 'form-contacto'],
          'portfolio': ['hero-imagen', 'caracteristicas', 'form-contacto'],
          'ecommerce': ['hero-imagen', 'caracteristicas', 'tabla-precios']
        };
        
        const components = templates[templateType] || [];
        
        // Agregar componentes de la plantilla
        components.forEach(componentType => {
          setTimeout(() => {
            this.addComponent(componentType);
          }, 100);
        });
        
        // Mostrar canvas
        if (this.emptyCanvas) {
          this.emptyCanvas.style.display = 'none';
        }
      }
      
      filterComponents(searchTerm) {
        const components = document.querySelectorAll('.draggable-component');
        components.forEach(component => {
          const text = component.textContent.toLowerCase();
          if (text.includes(searchTerm.toLowerCase())) {
            component.style.display = 'block';
          } else {
            component.style.display = 'none';
          }
        });
      }
      
      switchDevice(device) {
        this.currentDevice = device;
        
        // Actualizar botones
        document.querySelectorAll('.device-toggle').forEach(btn => {
          btn.classList.remove('bg-blue-600', 'text-white');
          btn.classList.add('bg-gray-300', 'text-gray-700');
        });
        
        const activeBtn = document.querySelector(`[data-device="${device}"]`);
        if (activeBtn) {
          activeBtn.classList.remove('bg-gray-300', 'text-gray-700');
          activeBtn.classList.add('bg-blue-600', 'text-white');
        }
        
        // Actualizar canvas (implementar responsive preview)
        this.updateCanvasDevice(device);
      }
      
      updateCanvasDevice(device) {
        const canvas = this.canvas;
        if (!canvas) return;
        
        // Remover clases anteriores
        canvas.classList.remove('desktop-view', 'tablet-view', 'mobile-view');
        
        // Agregar clase correspondiente
        canvas.classList.add(`${device}-view`);
        
        // Actualizar ancho del canvas
        const widths = {
          'desktop': '100%',
          'tablet': '768px',
          'mobile': '375px'
        };
        
        canvas.style.maxWidth = widths[device];
        canvas.style.margin = device !== 'desktop' ? '0 auto' : '0';
      }
      
