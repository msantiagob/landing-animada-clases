      renderPropertyInput(prop, value) {
        switch (prop.type) {
          case 'text':
            return `<input type="text" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md" value="${value || ''}" data-field="${prop.field}">`;
          case 'textarea':
            return `<textarea class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md" rows="2" data-field="${prop.field}">${value || ''}</textarea>`;
          case 'color':
            return `<input type="color" class="w-full h-10 border border-gray-300 rounded-md" value="${value || prop.defaultValue}" data-field="${prop.field}">`;
          case 'select':
            return `<select class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md" data-field="${prop.field}">
              ${prop.options.map(opt => `<option value="${opt.value}" ${opt.value === (value || prop.defaultValue) ? 'selected' : ''}>${opt.label}</option>`).join('')}
            </select>`;
          case 'checkbox':
            return `<label class="flex items-center">
              <input type="checkbox" class="mr-2" ${value ? 'checked' : ''} data-field="${prop.field}">
              <span class="text-sm">${value ? 'Sí' : 'No'}</span>
            </label>`;
          default:
            return `<input type="text" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md" value="${value || ''}" data-field="${prop.field}">`;
        }
      }
      
