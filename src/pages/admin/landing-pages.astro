          '.component-wrapper { border: none !important; }' +
          '.component-controls { display: none !important; }' +
          '</style>' +
          '</head>' +
          '<body class="bg-gray-50">' +
          '<div class="max-w-7xl mx-auto">' +
          componentsHTML +
          '</div>' +
          '</body>' +
          '</html>';
      }
      
      handleImageUpload(btn, componentId) {
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = 'image/*';
        input.style.display = 'none';
        
        input.addEventListener('change', (e) => {
          const file = e.target.files[0];
          if (file) {
            const reader = new FileReader();
            reader.onload = (e) => {
              const imageUrl = e.target.result;
              const field = btn.dataset.field;
              
              // Actualizar el componente con la nueva imagen
              this.updateComponentProperty(componentId, field, imageUrl);
              
              // Actualizar la vista del componente
              this.refreshComponent(componentId);
            };
            reader.readAsDataURL(file);
          }
        });
        
        document.body.appendChild(input);
        input.click();
        document.body.removeChild(input);
      }
      
      handleVideoUpload(btn, componentId) {
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = 'video/*';
        input.style.display = 'none';
        
        input.addEventListener('change', (e) => {
          const file = e.target.files[0];
          if (file) {
            const reader = new FileReader();
            reader.onload = (e) => {
              const videoUrl = e.target.result;
              const field = btn.dataset.field;
              
              // Actualizar el componente con el nuevo video
              this.updateComponentProperty(componentId, field, videoUrl);
              
              // Actualizar la vista del componente
              this.refreshComponent(componentId);
            };
            reader.readAsDataURL(file);
          }
        });
        
        document.body.appendChild(input);
        input.click();
        document.body.removeChild(input);
      }
      
      refreshComponent(componentId) {
        const componentElement = document.querySelector(`[data-component-id="${componentId}"]`);
        const componentData = this.pageData.find(item => item.id === componentId);
        
        if (componentElement && componentData) {
          // Regenerar el HTML del componente
          const newHTML = this.renderComponent(componentData.type, componentData.data, componentId);
          componentElement.innerHTML = newHTML;
          
          // Reconfigurar los event listeners
          this.setupComponentEvents(componentElement, componentId, componentData.type);
        }
      }
      
      makeEditable(element) {
        const originalText = element.textContent;
        const field = element.dataset.field;
        
        if (element.tagName === 'INPUT' || element.tagName === 'TEXTAREA') {
          return; // Ya es editable
        }
        
        // Crear input temporal
        const input = document.createElement('input');
        input.type = 'text';
        input.value = originalText;
        input.className = element.className + ' inline-edit';
        input.style.width = '100%';
        input.style.border = '2px solid #3B82F6';
        input.style.borderRadius = '4px';
        input.style.padding = '4px 8px';
        input.style.background = '#FFFFFF';
        
        // Reemplazar elemento con input
        element.parentNode.replaceChild(input, element);
        input.focus();
        input.select();
        
        // Manejar guardado
        const saveEdit = () => {
          const newText = input.value;
          const newElement = document.createElement(element.tagName);
          newElement.className = element.className;
          newElement.textContent = newText;
          newElement.dataset.field = field;
          
          // Restaurar event listeners
          newElement.addEventListener('click', (e) => {
            e.stopPropagation();
            this.makeEditable(newElement);
          });
          
          input.parentNode.replaceChild(newElement, input);
          
          // Actualizar datos del componente
          const componentElement = newElement.closest('[data-component-id]');
          if (componentElement) {
            const componentId = componentElement.dataset.componentId;
            this.updateComponentProperty(componentId, field, newText);
          }
        };
        
        // Eventos para guardar
        input.addEventListener('blur', saveEdit);
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            saveEdit();
          }
          if (e.key === 'Escape') {
            element.textContent = originalText;
            input.parentNode.replaceChild(element, input);
          }
        });
      }
    }
    
    // Inicializar el constructor cuando se abra el modal
    let pageBuilder = null;
    
    function showPageBuilderModal() {
      console.log('Abriendo Constructor de Páginas...');
      const modal = document.getElementById('pageBuilderModal');
      if (modal) {
        modal.classList.remove('hidden');
        
        // Inicializar el constructor
        setTimeout(() => {
          try {
            pageBuilder = new UnifiedPageBuilder();
            // Hacer disponible globalmente para los botones
            window.pageBuilder = pageBuilder;
            console.log('Constructor de Páginas inicializado correctamente');
          } catch (error) {
            console.error('Error al inicializar el Constructor de Páginas:', error);
          }
        }, 200);
      } else {
        console.error('Modal del Constructor de Páginas no encontrado');
      }
    }
    
    // Función alternativa para abrir el modal
    function openPageBuilder() {
      console.log('Abriendo Constructor de Páginas (método alternativo)...');
      showPageBuilderModal();
    }
    
    // Hacer disponible globalmente
    window.openPageBuilder = openPageBuilder;
    
    // Make functions globally available
    window.viewPage = viewPage;
    window.editPage = editPage;
    window.duplicatePage = duplicatePage;
    window.deletePage = deletePage;
    window.showPageModal = showPageModal;
    window.showTemplatesModal = showTemplatesModal;
    window.showPageBuilderModal = showPageBuilderModal;
    
    // Configure page builder button click event
    document.addEventListener('DOMContentLoaded', function() {
      const pageBuilderBtn = document.getElementById('pageBuilderBtn');
      if (pageBuilderBtn) {
        pageBuilderBtn.addEventListener('click', function(e) {
          e.preventDefault();
          showPageBuilderModal();
        });
      }
    });
    
    // Also set up the function to be available immediately
    setTimeout(() => {
      const pageBuilderBtn = document.getElementById('pageBuilderBtn');
      if (pageBuilderBtn && !pageBuilderBtn.hasAttribute('data-click-setup')) {
        pageBuilderBtn.setAttribute('data-click-setup', 'true');
        pageBuilderBtn.addEventListener('click', function(e) {
          e.preventDefault();
          showPageBuilderModal();
        });
      }
    }, 100);
  </script>
</body>
</html>