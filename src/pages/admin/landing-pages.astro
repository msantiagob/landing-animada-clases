    // Constructor de Páginas Unificado - Clase Principal
    class UnifiedPageBuilder {
      constructor() {
        this.canvas = null;
        this.emptyCanvas = null;
        this.propertiesPanel = null;
        this.selectedComponent = null;
        this.pageData = [];
        this.componentCounter = 0;
        this.currentDevice = 'desktop';
        this.isDropInProgress = false;
        this.dragAndDropInitialized = false;
        
        this.init();
      }
      
      init() {
        this.setupEventListeners();
        this.loadComponents();
      }
      
      setupEventListeners() {
        // Botones del modal
        document.getElementById('savePageBuilderBtn')?.addEventListener('click', () => {
          this.savePage();
        });
        
        document.getElementById('previewPageBuilderBtn')?.addEventListener('click', () => {
          this.previewPage();
        });
        
        document.getElementById('closePageBuilderModal')?.addEventListener('click', () => {
          document.getElementById('pageBuilderModal').classList.add('hidden');
        });
        
        // Plantillas rápidas
        document.querySelectorAll('.template-quick').forEach(template => {
          template.addEventListener('click', (e) => {
            const templateType = e.currentTarget.dataset.template;
            this.loadTemplate(templateType);
          });
        });
        
        // Filtro de componentes
        document.getElementById('componentSearch')?.addEventListener('input', (e) => {
          this.filterComponents(e.target.value);
        });
        
        // Cambio de dispositivo
        document.querySelectorAll('.device-toggle').forEach(btn => {
          btn.addEventListener('click', (e) => {
            this.switchDevice(e.target.dataset.device);
          });
        });
      }
      
      loadComponents() {
        setTimeout(() => {
          this.canvas = document.getElementById('pageCanvas');
          this.emptyCanvas = document.getElementById('emptyCanvas');
          this.propertiesPanel = document.getElementById('propertiesPanel');
          
          if (this.canvas) {
            this.initDragAndDrop();
          }
        }, 100);
      }
      
      initDragAndDrop() {
        // Prevenir múltiples inicializaciones
        if (this.dragAndDropInitialized) return;
        this.dragAndDropInitialized = true;
        
        // Configurar componentes arrastrables
        const draggableComponents = document.querySelectorAll('.draggable-component');
        draggableComponents.forEach(component => {
          component.draggable = true;
          // Remover event listeners existentes para evitar duplicados
          component.removeEventListener('dragstart', this.handleDragStart);
          component.addEventListener('dragstart', this.handleDragStart.bind(this));
          
          // Agregar event listener para click directo (alternativa al drag)
          component.removeEventListener('click', this.handleComponentClick);
          component.addEventListener('click', this.handleComponentClick.bind(this));
        });
        
        // Configurar zona de drop - remover listeners existentes primero
        this.canvas.removeEventListener('dragover', this.handleDragOver);
        this.canvas.removeEventListener('drop', this.handleDrop);
        
        this.canvas.addEventListener('dragover', this.handleDragOver.bind(this));
        this.canvas.addEventListener('drop', this.handleDrop.bind(this));
      }
      
      handleDragStart(e) {
        e.dataTransfer.setData('text/plain', e.target.dataset.component);
        e.dataTransfer.effectAllowed = 'copy';
      }
      
      handleDragOver(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'copy';
      }
      
      handleDrop(e) {
        e.preventDefault();
        e.stopPropagation();
        const componentType = e.dataTransfer.getData('text/plain');
        if (componentType && !this.isDropInProgress) {
          this.isDropInProgress = true;
          this.addComponent(componentType);
          // Resetear el flag después de un breve delay
          setTimeout(() => {
            this.isDropInProgress = false;
          }, 100);
        }
      }
      
      handleComponentClick(e) {
        e.preventDefault();
        e.stopPropagation();
        
        // Verificar si es un click simple (no drag)
        if (e.detail === 1) {
          const componentType = e.currentTarget.dataset.component;
          if (componentType && !this.isDropInProgress) {
            this.isDropInProgress = true;
            this.addComponent(componentType);
            // Resetear el flag después de un breve delay más largo
            setTimeout(() => {
              this.isDropInProgress = false;
            }, 300);
          }
        }
      }
      
      addComponent(componentType) {
        const componentData = this.getComponentTemplate(componentType);
        if (!componentData) return;
        
        const componentId = `component-${++this.componentCounter}`;
        const componentHTML = this.renderComponent(componentType, componentData, componentId);
        
        // Agregar al canvas
        const componentElement = document.createElement('div');
        componentElement.innerHTML = componentHTML;
        componentElement.className = 'component-item mb-4';
        componentElement.dataset.componentId = componentId;
        componentElement.dataset.componentType = componentType;
        
        this.canvas.appendChild(componentElement);
        
        // Ocultar estado vacío
        if (this.emptyCanvas) {
          this.emptyCanvas.style.display = 'none';
        }
        
        // Configurar eventos del componente
        this.setupComponentEvents(componentElement, componentId, componentType);
        
        // Guardar en pageData
        this.pageData.push({
          id: componentId,
          type: componentType,
          data: componentData
        });
        
        // Seleccionar el componente recién agregado
        this.selectComponent(componentElement);
      }
      
      setupComponentEvents(componentElement, componentId, componentType) {
        // Botón de edición
        const editBtn = componentElement.querySelector('.edit-component');
        editBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          this.selectComponent(componentElement);
        });
        
        // Botón de duplicar
        const duplicateBtn = componentElement.querySelector('.duplicate-component');
        duplicateBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          this.duplicateComponent(componentId);
        });
        
        // Botón de eliminar
        const deleteBtn = componentElement.querySelector('.delete-component');
        deleteBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          this.deleteComponent(componentId);
        });
        
        // Click en el componente para seleccionar
        componentElement.addEventListener('click', () => {
          this.selectComponent(componentElement);
        });
        
        // Elementos editables
        const editableElements = componentElement.querySelectorAll('.editable');
        editableElements.forEach(element => {
          element.addEventListener('click', (e) => {
            e.stopPropagation();
            this.makeEditable(element);
          });
        });
        
        // Botones de subida de imagen
        const uploadImageBtns = componentElement.querySelectorAll('.upload-image-btn');
        uploadImageBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            this.handleImageUpload(btn, componentId);
          });
        });
        
        // Botones de subida de video
        const uploadVideoBtns = componentElement.querySelectorAll('.upload-video-btn');
        uploadVideoBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            this.handleVideoUpload(btn, componentId);
          });
        });
      }
      
      selectComponent(componentElement) {
        // Remover selección anterior
        document.querySelectorAll('.component-item').forEach(item => {
          item.classList.remove('selected');
        });
        
        // Seleccionar componente
        componentElement.classList.add('selected');
        this.selectedComponent = componentElement;
        
        // Actualizar panel de propiedades
        const componentType = componentElement.dataset.componentType;
        const componentId = componentElement.dataset.componentId;
        this.updatePropertiesPanel(componentType, componentId);
      }
      
      updatePropertiesPanel(componentType, componentId) {
        const componentData = this.pageData.find(item => item.id === componentId);
        if (!componentData) return;
        
        const properties = this.getComponentProperties(componentType);
        
        let html = `
          <div class="mb-4">
            <h5 class="text-sm font-semibold text-gray-900 mb-2">📝 ${this.getComponentTitle(componentType)}</h5>
            <p class="text-xs text-gray-600 mb-4">${this.getComponentDescription(componentType)}</p>
          </div>
        `;
        
        properties.forEach(prop => {
          html += `
            <div class="mb-3">
              <label class="block text-xs font-medium text-gray-700 mb-1">
                ${prop.label}
              </label>
              ${this.renderPropertyInput(prop, componentData.data[prop.field] || prop.defaultValue)}
            </div>
          `;
        });
        
        html += `
          <div class="mt-6 pt-4 border-t border-gray-200">
            <div class="flex space-x-2">
              <button onclick="pageBuilder.duplicateComponent('${componentId}')" class="flex-1 px-3 py-2 bg-blue-100 text-blue-700 rounded text-xs font-medium hover:bg-blue-200">
                📋 Duplicar
              </button>
              <button onclick="pageBuilder.deleteComponent('${componentId}')" class="flex-1 px-3 py-2 bg-red-100 text-red-700 rounded text-xs font-medium hover:bg-red-200">
                🗑️ Eliminar
              </button>
            </div>
          </div>
        `;
        
        this.propertiesPanel.innerHTML = html;
        
        // Configurar eventos de los inputs
        this.setupPropertyInputEvents(componentId);
      }
      
      setupPropertyInputEvents(componentId) {
        const inputs = this.propertiesPanel.querySelectorAll('input, textarea, select');
        inputs.forEach(input => {
          const eventType = input.type === 'checkbox' ? 'change' : 'input';
          input.addEventListener(eventType, (e) => {
            const value = input.type === 'checkbox' ? e.target.checked : e.target.value;
            this.updateComponentProperty(componentId, input.dataset.field, value);
          });
        });
      }
      
      updateComponentProperty(componentId, field, value) {
        // Actualizar datos
        const componentData = this.pageData.find(item => item.id === componentId);
        if (componentData) {
          componentData.data[field] = value;
        }
        
        // Actualizar UI
        const componentElement = document.querySelector(`[data-component-id="${componentId}"]`);
        if (componentElement) {
          const targetElement = componentElement.querySelector(`[data-field="${field}"]`);
          if (targetElement) {
            targetElement.textContent = value;
          }
        }
      }
      
      duplicateComponent(componentId) {
        const componentData = this.pageData.find(item => item.id === componentId);
        if (componentData) {
          this.addComponent(componentData.type);
        }
      }
      
      deleteComponent(componentId) {
        // Remover del DOM
        const componentElement = document.querySelector(`[data-component-id="${componentId}"]`);
        if (componentElement) {
          componentElement.remove();
        }
        
        // Remover de pageData
        this.pageData = this.pageData.filter(item => item.id !== componentId);
        
        // Mostrar estado vacío si no hay componentes
        if (this.pageData.length === 0 && this.emptyCanvas) {
          this.emptyCanvas.style.display = 'flex';
