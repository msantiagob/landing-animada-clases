  <script>
    let currentFilters = { status: '', type: '' };
    let isEditMode = false;
    let currentPageId = null;

    // Load stats
    async function loadStats() {
      try {
        console.log('🔄 Cargando estadísticas...');
        const response = await fetch('/api/admin/landing-pages', {
          credentials: 'include'
        });
        console.log('📊 Response status:', response.status);
        console.log('📊 Response headers:', [...response.headers.entries()]);
        
        if (!response.ok) {
          const errorText = await response.text();
          console.error('❌ Error response:', errorText);
          throw new Error(`HTTP ${response.status}: ${errorText}`);
        }
        
        const data = await response.json();
        console.log('📊 Response data:', data);
        
        if (data.success) {
          document.getElementById('totalPages').textContent = data.stats.total || 0;
          document.getElementById('publishedPages').textContent = data.stats.published || 0;
          document.getElementById('monthlyViews').textContent = '0'; // TODO: Implement analytics
          document.getElementById('conversions').textContent = '0'; // TODO: Implement analytics
        }
      } catch (error) {
        console.error('Error loading stats:', error);
        document.getElementById('totalPages').textContent = '0';
        document.getElementById('publishedPages').textContent = '0';
        document.getElementById('monthlyViews').textContent = '0';
        document.getElementById('conversions').textContent = '0';
      }
    }

    // Load pages
    async function loadPages() {
      const grid = document.getElementById('pagesGrid');
      const emptyState = document.getElementById('emptyState');
      
      try {
        console.log('🔄 Cargando páginas...');
        console.log('🔄 Filtros actuales:', currentFilters);
        
        const params = new URLSearchParams();
        if (currentFilters.status) params.append('status', currentFilters.status);
        if (currentFilters.type) params.append('type', currentFilters.type);
        
        console.log('🔄 URL final:', `/api/admin/landing-pages?${params}`);
        
        const response = await fetch(`/api/admin/landing-pages?${params}`, {
          credentials: 'include'
        });
        
        console.log('📄 Response status:', response.status);
        
        if (!response.ok) {
          const errorText = await response.text();
          console.error('❌ Error response:', errorText);
          throw new Error(`HTTP ${response.status}: ${errorText}`);
        }
        
        const data = await response.json();
        console.log('📄 Response data:', data);
        
        if (!data.success) {
          console.error('Error loading pages:', data.error);
          grid.classList.add('hidden');
          emptyState.classList.remove('hidden');
          return;
        }
        
        const pages = data.pages || [];
        console.log('📄 Páginas encontradas:', pages.length);
        console.log('📄 Páginas:', pages);
        
        if (pages.length === 0) {
          console.log('📄 No hay páginas, mostrando empty state');
          grid.classList.add('hidden');
          emptyState.classList.remove('hidden');
          return;
        }

        console.log('📄 Mostrando grid con', pages.length, 'páginas');
        grid.classList.remove('hidden');
        emptyState.classList.add('hidden');

        grid.innerHTML = pages.map(page => `
          <div class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow">
            <div class="page-preview relative overflow-hidden">
              <div class="bg-gradient-to-br from-blue-50 to-purple-50 h-full p-4">
                <div class="text-center">
                  <div class="mb-3">
                    ${getTemplateIcon(page.template)}
                  </div>
                  <h4 class="font-semibold text-gray-800 text-sm mb-1">${getTemplateTitle(page.template)}</h4>
                  <p class="text-xs text-gray-600">${page.config.description || 'Sin descripción'}</p>
                  <div class="mt-3 flex justify-center">
                    <a href="/landing/${page.slug}" target="_blank" class="bg-blue-600 text-white text-xs px-3 py-1 rounded hover:bg-blue-700">
                      Ver página
                    </a>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="p-4">
              <div class="flex justify-between items-start mb-2">
                <h3 class="font-semibold text-gray-900 truncate">${page.name}</h3>
                <span class="px-2 py-1 text-xs rounded-full status-${page.status}">
                  ${getStatusText(page.status)}
                </span>
              </div>
              
              <p class="text-sm text-gray-600 mb-3 line-clamp-2">${page.config.description || 'Sin descripción'}</p>
              
              <div class="grid grid-cols-3 gap-2 text-center mb-3 text-xs">
                <div>
                  <div class="font-semibold text-gray-900">0</div>
                  <div class="text-gray-500">Visitas</div>
                </div>
                <div>
                  <div class="font-semibold text-gray-900">0</div>
                  <div class="text-gray-500">Conversiones</div>
                </div>
                <div>
                  <div class="font-semibold text-gray-900">0%</div>
                  <div class="text-gray-500">Tasa conv.</div>
                </div>
              </div>
              
              <div class="flex justify-between items-center">
                <span class="text-xs text-gray-400">/${page.slug}</span>
                <div class="flex space-x-1">
                  <button onclick="viewPage('${page.slug}')" class="text-blue-600 hover:text-blue-800 text-sm" title="Ver página">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                  </button>
                  <button onclick="editPage(${page.id})" class="text-green-600 hover:text-green-800 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                  </button>
                  <button onclick="duplicatePage(${page.id})" class="text-purple-600 hover:text-purple-800 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
