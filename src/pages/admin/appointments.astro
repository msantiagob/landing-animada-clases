---
export const prerender = false;

import { authHelpers } from '../../lib/auth';
import '../../assets/styles/tailwind.css';

// Verificar autenticación
const authData = authHelpers.requireAuthFromCookies(Astro.request);
if (!authData) {
  return Astro.redirect('/admin/login');
}

const user = authHelpers.getUserById(authData.userId);
if (!user) {
  return Astro.redirect('/admin/login');
}

const metadata = {
  title: 'Gestión de Citas - Admin Sonmyd',
  robots: {
    index: false,
    follow: false,
  },
};
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{metadata.title}</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    .sidebar-link.active {
      @apply bg-blue-100 text-blue-700 border-r-4 border-blue-700;
    }
    .calendar-day {
      @apply w-10 h-10 flex items-center justify-center text-sm cursor-pointer hover:bg-gray-100 rounded;
    }
    .calendar-day.today {
      @apply bg-blue-500 text-white;
    }
    .calendar-day.selected {
      @apply bg-blue-100 text-blue-700;
    }
    .calendar-day.has-appointments {
      @apply bg-green-100 text-green-700;
    }
  </style>
</head>
<body class="bg-gray-100">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="w-64 bg-white shadow-lg">
      <div class="p-6 border-b">
        <h2 class="text-xl font-bold text-gray-800">Admin Sonmyd</h2>
        <p class="text-sm text-gray-600">Bienvenido, {user.name}</p>
      </div>
      
      <nav class="mt-6">
        <a href="/admin/dashboard" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 5 4-4 4 4"></path>
          </svg>
          Dashboard
        </a>
        
        <a href="/admin/forms" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.34a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          Formularios
          <span id="pendingFormsCount" class="ml-auto bg-red-500 text-white text-xs px-2 py-1 rounded-full">0</span>
        </a>
        
        <a href="/admin/appointments" class="sidebar-link active flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v14a2 2 0 002 2z"></path>
          </svg>
          Citas
        </a>
        
        <a href="/admin/blog" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Blog
        </a>
        
        <a href="/admin/emails" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
          </svg>
          Emails
        </a>
        
        <a href="/admin/landing-pages" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
          </svg>
          Landing Pages
        </a>
      </nav>
      
      <!-- Logout -->
      <div class="absolute bottom-0 w-64 p-6 border-t">
        <button id="logoutBtn" class="flex items-center text-gray-700 hover:text-red-600">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          Cerrar Sesión
        </button>
      </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1 overflow-auto">
      <!-- Header -->
      <div class="bg-white shadow-sm p-6 border-b">
        <div class="flex justify-between items-center">
          <div>
            <h1 class="text-2xl font-bold text-gray-800">Gestión de Citas</h1>
            <p class="text-gray-600">Administra las citas y reuniones programadas</p>
          </div>
          
          <!-- Filters -->
          <div class="flex space-x-4">
            <select id="statusFilter" class="border border-gray-300 rounded-lg px-3 py-2 text-sm">
              <option value="">Todos los estados</option>
              <option value="pending">Pendientes</option>
              <option value="confirmed">Confirmadas</option>
              <option value="completed">Completadas</option>
              <option value="cancelled">Canceladas</option>
              <option value="no_show">No se presentó</option>
            </select>
            
            <input type="date" id="dateFilter" class="border border-gray-300 rounded-lg px-3 py-2 text-sm">
            
            <button id="refreshBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 text-sm">
              Actualizar
            </button>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="p-6">
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 rounded-full bg-blue-100 text-blue-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v14a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">Hoy</h3>
                <p id="todayCount" class="text-2xl font-bold text-gray-900">-</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 rounded-full bg-yellow-100 text-yellow-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">Pendientes</h3>
                <p id="pendingCount" class="text-2xl font-bold text-gray-900">-</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 rounded-full bg-green-100 text-green-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">Esta Semana</h3>
                <p id="weeklyCount" class="text-2xl font-bold text-gray-900">-</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 rounded-full bg-purple-100 text-purple-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">Total</h3>
                <p id="totalCount" class="text-2xl font-bold text-gray-900">-</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Loading State -->
        <div id="loadingState" class="flex justify-center items-center py-12">
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
          <span class="ml-3 text-gray-600">Cargando citas...</span>
        </div>

        <!-- Appointments Table -->
        <div id="appointmentsContainer" class="bg-white rounded-lg shadow hidden">
          <div class="px-6 py-4 border-b">
            <h3 class="text-lg font-semibold text-gray-800">Citas Programadas</h3>
          </div>
          
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cliente</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Servicio</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha/Hora</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                </tr>
              </thead>
              <tbody id="appointmentsTableBody" class="bg-white divide-y divide-gray-200">
                <!-- Appointments will be loaded here -->
              </tbody>
            </table>
          </div>
          
          <!-- Pagination -->
          <div id="paginationContainer" class="px-6 py-4 border-t bg-gray-50">
            <!-- Pagination will be loaded here -->
          </div>
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="text-center py-12 hidden">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v14a2 2 0 002 2z"></path>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No hay citas</h3>
          <p class="mt-1 text-sm text-gray-500">No se encontraron citas con los filtros aplicados.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Appointment Detail Modal -->
  <div id="appointmentModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full">
    <div class="relative top-20 mx-auto p-5 border w-11/12 md:w-3/4 lg:w-1/2 shadow-lg rounded-md bg-white">
      <div class="mt-3">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold text-gray-800">Detalles de la Cita</h3>
          <button id="closeModal" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <div id="appointmentDetails" class="space-y-4">
          <!-- Appointment details will be loaded here -->
        </div>
        
        <div class="mt-6 flex justify-end space-x-3">
          <button id="closeModalBtn" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400">
            Cerrar
          </button>
          <button id="updateStatusBtn" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
            Actualizar Estado
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentPage = 1;
    let currentStatusFilter = '';
    let currentDateFilter = '';
    let selectedAppointmentId = null;

    // Load appointments data
    async function loadAppointments(page = 1, status = '', date = '') {
      const loadingState = document.getElementById('loadingState');
      const appointmentsContainer = document.getElementById('appointmentsContainer');
      const emptyState = document.getElementById('emptyState');

      loadingState.classList.remove('hidden');
      appointmentsContainer.classList.add('hidden');
      emptyState.classList.add('hidden');

      try {
        const params = new URLSearchParams({
          page: page.toString(),
          limit: '20'
        });

        if (status) params.append('status', status);
        if (date) params.append('date', date);

        const response = await fetch(`/api/admin/appointments?${params}`);
        const data = await response.json();

        if (data.success && data.appointments.length > 0) {
          displayAppointments(data.appointments);
          displayPagination(data.pagination);
          appointmentsContainer.classList.remove('hidden');
        } else {
          emptyState.classList.remove('hidden');
        }
      } catch (error) {
        console.error('Error loading appointments:', error);
        emptyState.classList.remove('hidden');
      } finally {
        loadingState.classList.add('hidden');
      }
    }

    // Load dashboard stats
    async function loadStats() {
      try {
        const response = await fetch('/api/admin/dashboard');
        const data = await response.json();

        if (data.success) {
          document.getElementById('todayCount').textContent = data.stats.appointments.today || 0;
          document.getElementById('pendingCount').textContent = data.stats.appointments.pending || 0;
          document.getElementById('weeklyCount').textContent = data.stats.appointments.thisWeek || 0;
          document.getElementById('totalCount').textContent = data.stats.appointments.total || 0;
        }
      } catch (error) {
        console.error('Error loading stats:', error);
      }
    }

    function displayAppointments(appointments) {
      const tbody = document.getElementById('appointmentsTableBody');
      tbody.innerHTML = '';

      appointments.forEach(appointment => {
        const row = document.createElement('tr');
        row.className = 'hover:bg-gray-50 cursor-pointer';
        row.onclick = () => showAppointmentDetails(appointment);
        
        row.innerHTML = `
          <td class="px-6 py-4 whitespace-nowrap">
            <div>
              <div class="text-sm font-medium text-gray-900">${appointment.name}</div>
              <div class="text-sm text-gray-500">${appointment.email}</div>
              ${appointment.phone ? `<div class="text-xs text-gray-400">${appointment.phone}</div>` : ''}
            </div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm text-gray-900">${appointment.service_type}</div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm text-gray-900">${appointment.date}</div>
            <div class="text-sm text-gray-500">${appointment.time}</div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <span class="px-2 py-1 text-xs rounded-full ${getStatusColor(appointment.status)}">${getStatusText(appointment.status)}</span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
            <button onclick="event.stopPropagation(); showAppointmentDetails(${JSON.stringify(appointment).replace(/"/g, '&quot;')})" class="text-blue-600 hover:text-blue-900">Ver</button>
          </td>
        `;
        
        tbody.appendChild(row);
      });
    }

    function displayPagination(pagination) {
      const container = document.getElementById('paginationContainer');
      container.innerHTML = `
        <div class="flex items-center justify-between">
          <div class="text-sm text-gray-700">
            Mostrando ${((pagination.page - 1) * pagination.limit) + 1} a ${Math.min(pagination.page * pagination.limit, pagination.total)} de ${pagination.total} resultados
          </div>
          <div class="flex space-x-2">
            <button onclick="changePage(${pagination.page - 1})" ${!pagination.hasPrev ? 'disabled' : ''} class="px-3 py-1 border rounded text-sm ${!pagination.hasPrev ? 'text-gray-400 cursor-not-allowed' : 'text-gray-700 hover:bg-gray-100'}">
              Anterior
            </button>
            <span class="px-3 py-1 text-sm text-gray-700">
              Página ${pagination.page} de ${pagination.totalPages}
            </span>
            <button onclick="changePage(${pagination.page + 1})" ${!pagination.hasNext ? 'disabled' : ''} class="px-3 py-1 border rounded text-sm ${!pagination.hasNext ? 'text-gray-400 cursor-not-allowed' : 'text-gray-700 hover:bg-gray-100'}">
              Siguiente
            </button>
          </div>
        </div>
      `;
    }

    function showAppointmentDetails(appointment) {
      selectedAppointmentId = appointment.id;
      const modal = document.getElementById('appointmentModal');
      const details = document.getElementById('appointmentDetails');
      
      details.innerHTML = `
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Nombre</label>
            <p class="mt-1 text-sm text-gray-900">${appointment.name}</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Email</label>
            <p class="mt-1 text-sm text-gray-900">${appointment.email}</p>
          </div>
          ${appointment.phone ? `
          <div>
            <label class="block text-sm font-medium text-gray-700">Teléfono</label>
            <p class="mt-1 text-sm text-gray-900">${appointment.phone}</p>
          </div>
          ` : ''}
          <div>
            <label class="block text-sm font-medium text-gray-700">Servicio</label>
            <p class="mt-1 text-sm text-gray-900">${appointment.service_type}</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Fecha</label>
            <p class="mt-1 text-sm text-gray-900">${appointment.date}</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Hora</label>
            <p class="mt-1 text-sm text-gray-900">${appointment.time}</p>
          </div>
          ${appointment.message ? `
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700">Mensaje</label>
            <p class="mt-1 text-sm text-gray-900 bg-gray-50 p-3 rounded">${appointment.message}</p>
          </div>
          ` : ''}
          <div>
            <label class="block text-sm font-medium text-gray-700">Estado</label>
            <select id="statusSelect" class="mt-1 border border-gray-300 rounded-md px-3 py-2 w-full">
              <option value="pending" ${appointment.status === 'pending' ? 'selected' : ''}>Pendiente</option>
              <option value="confirmed" ${appointment.status === 'confirmed' ? 'selected' : ''}>Confirmada</option>
              <option value="completed" ${appointment.status === 'completed' ? 'selected' : ''}>Completada</option>
              <option value="cancelled" ${appointment.status === 'cancelled' ? 'selected' : ''}>Cancelada</option>
              <option value="no_show" ${appointment.status === 'no_show' ? 'selected' : ''}>No se presentó</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Link de reunión</label>
            <input type="url" id="meetingLinkInput" value="${appointment.meeting_link || ''}" class="mt-1 border border-gray-300 rounded-md px-3 py-2 w-full" placeholder="https://meet.google.com/...">
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700">Fecha de creación</label>
            <p class="mt-1 text-sm text-gray-900">${new Date(appointment.created_at).toLocaleString('es-ES')}</p>
          </div>
        </div>
      `;
      
      modal.classList.remove('hidden');
    }

    async function updateAppointmentStatus() {
      const statusSelect = document.getElementById('statusSelect');
      const meetingLinkInput = document.getElementById('meetingLinkInput');
      const newStatus = statusSelect.value;
      const meetingLink = meetingLinkInput.value;
      
      try {
        const response = await fetch('/api/admin/appointments', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: selectedAppointmentId,
            status: newStatus,
            meetingLink: meetingLink
          })
        });

        const result = await response.json();
        
        if (result.success) {
          document.getElementById('appointmentModal').classList.add('hidden');
          loadAppointments(currentPage, currentStatusFilter, currentDateFilter);
          loadStats();
        } else {
          alert('Error actualizando la cita: ' + result.error);
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error de conexión');
      }
    }

    function changePage(page) {
      currentPage = page;
      loadAppointments(page, currentStatusFilter, currentDateFilter);
    }

    function getStatusColor(status) {
      const colors = {
        'pending': 'bg-yellow-100 text-yellow-800',
        'confirmed': 'bg-blue-100 text-blue-800',
        'completed': 'bg-green-100 text-green-800',
        'cancelled': 'bg-red-100 text-red-800',
        'no_show': 'bg-gray-100 text-gray-800'
      };
      return colors[status] || 'bg-gray-100 text-gray-800';
    }

    function getStatusText(status) {
      const texts = {
        'pending': 'Pendiente',
        'confirmed': 'Confirmada',
        'completed': 'Completada',
        'cancelled': 'Cancelada',
        'no_show': 'No se presentó'
      };
      return texts[status] || status;
    }

    // Event listeners
    document.getElementById('statusFilter').addEventListener('change', (e) => {
      currentStatusFilter = e.target.value;
      currentPage = 1;
      loadAppointments(1, currentStatusFilter, currentDateFilter);
    });

    document.getElementById('dateFilter').addEventListener('change', (e) => {
      currentDateFilter = e.target.value;
      currentPage = 1;
      loadAppointments(1, currentStatusFilter, currentDateFilter);
    });

    document.getElementById('refreshBtn').addEventListener('click', () => {
      loadAppointments(currentPage, currentStatusFilter, currentDateFilter);
      loadStats();
    });

    document.getElementById('closeModal').addEventListener('click', () => {
      document.getElementById('appointmentModal').classList.add('hidden');
    });

    document.getElementById('closeModalBtn').addEventListener('click', () => {
      document.getElementById('appointmentModal').classList.add('hidden');
    });

    document.getElementById('updateStatusBtn').addEventListener('click', updateAppointmentStatus);

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        const response = await fetch('/api/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'logout' })
        });
        if (response.ok) {
          window.location.href = '/admin/login';
        }
      } catch (error) {
        console.error('Error logging out:', error);
      }
    });

    // Load data on page load
    document.addEventListener('DOMContentLoaded', () => {
      loadAppointments();
      loadStats();
    });
  </script>
</body>
</html>