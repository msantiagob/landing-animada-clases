---
export const prerender = false;

import { authHelpers } from '../../lib/auth';
import '../../assets/styles/tailwind.css';

// Verificar autenticación
const authData = authHelpers.requireAuthFromCookies(Astro.request);
if (!authData) {
  return Astro.redirect('/admin/login');
}

const user = authHelpers.getUserById(authData.userId);
if (!user) {
  return Astro.redirect('/admin/login');
}

const metadata = {
  title: 'Gestión de Formularios - Admin Sonmyd',
  robots: {
    index: false,
    follow: false,
  },
};
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{metadata.title}</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    .sidebar-link.active {
      @apply bg-blue-100 text-blue-700 border-r-4 border-blue-700;
    }
  </style>
</head>
<body class="bg-gray-100">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="w-64 bg-white shadow-lg">
      <div class="p-6 border-b">
        <h2 class="text-xl font-bold text-gray-800">Admin Sonmyd</h2>
        <p class="text-sm text-gray-600">Bienvenido, {user.name}</p>
      </div>
      
      <nav class="mt-6">
        <a href="/admin/dashboard" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 5 4-4 4 4"></path>
          </svg>
          Dashboard
        </a>
        
        <a href="/admin/forms" class="sidebar-link active flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.34a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          Formularios
        </a>
        
        <a href="/admin/appointments" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v14a2 2 0 002 2z"></path>
          </svg>
          Citas
        </a>
        
        <a href="/admin/blog" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Blog
        </a>
        
        <a href="/admin/emails" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
          </svg>
          Emails
        </a>
      </nav>
      
      <!-- Logout -->
      <div class="absolute bottom-0 w-64 p-6 border-t">
        <button id="logoutBtn" class="flex items-center text-gray-700 hover:text-red-600">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          Cerrar Sesión
        </button>
      </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1 overflow-auto">
      <!-- Header -->
      <div class="bg-white shadow-sm p-6 border-b">
        <div class="flex justify-between items-center">
          <div>
            <h1 class="text-2xl font-bold text-gray-800">Gestión de Formularios</h1>
            <p class="text-gray-600">Administra los formularios de contacto recibidos</p>
          </div>
          
          <!-- Filters -->
          <div class="flex space-x-4">
            <select id="statusFilter" class="border border-gray-300 rounded-lg px-3 py-2 text-sm">
              <option value="">Todos los estados</option>
              <option value="new">Nuevos</option>
              <option value="in_progress">En proceso</option>
              <option value="resolved">Resueltos</option>
              <option value="closed">Cerrados</option>
            </select>
            
            <button id="refreshBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 text-sm">
              Actualizar
            </button>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="p-6">
        <!-- Loading State -->
        <div id="loadingState" class="flex justify-center items-center py-12">
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
          <span class="ml-3 text-gray-600">Cargando formularios...</span>
        </div>

        <!-- Forms Table -->
        <div id="formsContainer" class="bg-white rounded-lg shadow hidden">
          <div class="px-6 py-4 border-b">
            <h3 class="text-lg font-semibold text-gray-800">Formularios de Contacto</h3>
          </div>
          
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Contacto</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mensaje</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                </tr>
              </thead>
              <tbody id="formsTableBody" class="bg-white divide-y divide-gray-200">
                <!-- Forms will be loaded here -->
              </tbody>
            </table>
          </div>
          
          <!-- Pagination -->
          <div id="paginationContainer" class="px-6 py-4 border-t bg-gray-50">
            <!-- Pagination will be loaded here -->
          </div>
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="text-center py-12 hidden">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.34a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No hay formularios</h3>
          <p class="mt-1 text-sm text-gray-500">No se encontraron formularios con los filtros aplicados.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Detail Modal -->
  <div id="formModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full">
    <div class="relative top-20 mx-auto p-5 border w-11/12 md:w-3/4 lg:w-1/2 shadow-lg rounded-md bg-white">
      <div class="mt-3">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold text-gray-800">Detalles del Formulario</h3>
          <button id="closeModal" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <div id="formDetails" class="space-y-4">
          <!-- Form details will be loaded here -->
        </div>
        
        <div class="mt-6 flex justify-end space-x-3">
          <button id="closeModalBtn" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400">
            Cerrar
          </button>
          <button id="updateStatusBtn" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
            Actualizar Estado
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentPage = 1;
    let currentFilter = '';
    let selectedFormId = null;

    // Load forms data
    async function loadForms(page = 1, status = '') {
      const loadingState = document.getElementById('loadingState');
      const formsContainer = document.getElementById('formsContainer');
      const emptyState = document.getElementById('emptyState');

      loadingState.classList.remove('hidden');
      formsContainer.classList.add('hidden');
      emptyState.classList.add('hidden');

      try {
        const params = new URLSearchParams({
          page: page.toString(),
          limit: '20'
        });

        if (status) {
          params.append('status', status);
        }

        const response = await fetch(`/api/admin/forms?${params}`);
        const data = await response.json();

        if (data.success && data.forms.length > 0) {
          displayForms(data.forms);
          displayPagination(data.pagination);
          formsContainer.classList.remove('hidden');
        } else {
          emptyState.classList.remove('hidden');
        }
      } catch (error) {
        console.error('Error loading forms:', error);
        emptyState.classList.remove('hidden');
      } finally {
        loadingState.classList.add('hidden');
      }
    }

    function displayForms(forms) {
      const tbody = document.getElementById('formsTableBody');
      tbody.innerHTML = '';

      forms.forEach(form => {
        const row = document.createElement('tr');
        row.className = 'hover:bg-gray-50 cursor-pointer';
        row.onclick = () => showFormDetails(form);
        
        row.innerHTML = `
          <td class="px-6 py-4 whitespace-nowrap">
            <div>
              <div class="text-sm font-medium text-gray-900">${form.name}</div>
              <div class="text-sm text-gray-500">${form.email}</div>
              ${form.phone ? `<div class="text-xs text-gray-400">${form.phone}</div>` : ''}
              ${form.company ? `<div class="text-xs text-gray-400">${form.company}</div>` : ''}
            </div>
          </td>
          <td class="px-6 py-4">
            <div class="text-sm text-gray-900 max-w-xs truncate">${form.message}</div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            ${new Date(form.created_at).toLocaleDateString('es-ES', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
              hour: '2-digit',
              minute: '2-digit'
            })}
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <span class="px-2 py-1 text-xs rounded-full ${getStatusColor(form.status)}">${getStatusText(form.status)}</span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
            <button onclick="event.stopPropagation(); showFormDetails(${JSON.stringify(form).replace(/"/g, '&quot;')})" class="text-blue-600 hover:text-blue-900">Ver</button>
          </td>
        `;
        
        tbody.appendChild(row);
      });
    }

    function displayPagination(pagination) {
      const container = document.getElementById('paginationContainer');
      container.innerHTML = `
        <div class="flex items-center justify-between">
          <div class="text-sm text-gray-700">
            Mostrando ${((pagination.page - 1) * pagination.limit) + 1} a ${Math.min(pagination.page * pagination.limit, pagination.total)} de ${pagination.total} resultados
          </div>
          <div class="flex space-x-2">
            <button onclick="changePage(${pagination.page - 1})" ${!pagination.hasPrev ? 'disabled' : ''} class="px-3 py-1 border rounded text-sm ${!pagination.hasPrev ? 'text-gray-400 cursor-not-allowed' : 'text-gray-700 hover:bg-gray-100'}">
              Anterior
            </button>
            <span class="px-3 py-1 text-sm text-gray-700">
              Página ${pagination.page} de ${pagination.totalPages}
            </span>
            <button onclick="changePage(${pagination.page + 1})" ${!pagination.hasNext ? 'disabled' : ''} class="px-3 py-1 border rounded text-sm ${!pagination.hasNext ? 'text-gray-400 cursor-not-allowed' : 'text-gray-700 hover:bg-gray-100'}">
              Siguiente
            </button>
          </div>
        </div>
      `;
    }

    function showFormDetails(form) {
      selectedFormId = form.id;
      const modal = document.getElementById('formModal');
      const details = document.getElementById('formDetails');
      
      details.innerHTML = `
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Nombre</label>
            <p class="mt-1 text-sm text-gray-900">${form.name}</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Email</label>
            <p class="mt-1 text-sm text-gray-900">${form.email}</p>
          </div>
          ${form.phone ? `
          <div>
            <label class="block text-sm font-medium text-gray-700">Teléfono</label>
            <p class="mt-1 text-sm text-gray-900">${form.phone}</p>
          </div>
          ` : ''}
          ${form.company ? `
          <div>
            <label class="block text-sm font-medium text-gray-700">Empresa</label>
            <p class="mt-1 text-sm text-gray-900">${form.company}</p>
          </div>
          ` : ''}
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700">Mensaje</label>
            <p class="mt-1 text-sm text-gray-900 bg-gray-50 p-3 rounded">${form.message}</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Estado Actual</label>
            <select id="statusSelect" class="mt-1 border border-gray-300 rounded-md px-3 py-2 w-full">
              <option value="new" ${form.status === 'new' ? 'selected' : ''}>Nuevo</option>
              <option value="in_progress" ${form.status === 'in_progress' ? 'selected' : ''}>En proceso</option>
              <option value="resolved" ${form.status === 'resolved' ? 'selected' : ''}>Resuelto</option>
              <option value="closed" ${form.status === 'closed' ? 'selected' : ''}>Cerrado</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Fecha de recepción</label>
            <p class="mt-1 text-sm text-gray-900">${new Date(form.created_at).toLocaleString('es-ES')}</p>
          </div>
          ${form.ip_address ? `
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700">Información técnica</label>
            <p class="mt-1 text-xs text-gray-500">IP: ${form.ip_address} | Página: ${form.source_page || 'N/A'}</p>
          </div>
          ` : ''}
        </div>
      `;
      
      modal.classList.remove('hidden');
    }

    async function updateFormStatus() {
      const statusSelect = document.getElementById('statusSelect');
      const newStatus = statusSelect.value;
      
      try {
        const response = await fetch('/api/admin/forms', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: selectedFormId,
            status: newStatus
          })
        });

        const result = await response.json();
        
        if (result.success) {
          document.getElementById('formModal').classList.add('hidden');
          loadForms(currentPage, currentFilter);
        } else {
          alert('Error actualizando el estado: ' + result.error);
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error de conexión');
      }
    }

    function changePage(page) {
      currentPage = page;
      loadForms(page, currentFilter);
    }

    function getStatusColor(status) {
      const colors = {
        'new': 'bg-blue-100 text-blue-800',
        'in_progress': 'bg-yellow-100 text-yellow-800',
        'resolved': 'bg-green-100 text-green-800',
        'closed': 'bg-gray-100 text-gray-800'
      };
      return colors[status] || 'bg-gray-100 text-gray-800';
    }

    function getStatusText(status) {
      const texts = {
        'new': 'Nuevo',
        'in_progress': 'En proceso',
        'resolved': 'Resuelto',
        'closed': 'Cerrado'
      };
      return texts[status] || status;
    }

    // Event listeners
    document.getElementById('statusFilter').addEventListener('change', (e) => {
      currentFilter = e.target.value;
      currentPage = 1;
      loadForms(1, currentFilter);
    });

    document.getElementById('refreshBtn').addEventListener('click', () => {
      loadForms(currentPage, currentFilter);
    });

    document.getElementById('closeModal').addEventListener('click', () => {
      document.getElementById('formModal').classList.add('hidden');
    });

    document.getElementById('closeModalBtn').addEventListener('click', () => {
      document.getElementById('formModal').classList.add('hidden');
    });

    document.getElementById('updateStatusBtn').addEventListener('click', updateFormStatus);

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        const response = await fetch('/api/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'logout' })
        });
        if (response.ok) {
          window.location.href = '/admin/login';
        }
      } catch (error) {
        console.error('Error logging out:', error);
      }
    });

    // Load data on page load
    document.addEventListener('DOMContentLoaded', () => {
      loadForms();
    });
  </script>
</body>
</html>