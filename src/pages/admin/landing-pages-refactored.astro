---
export const prerender = false;

import { authHelpers } from '../../lib/auth';
import '../../assets/styles/tailwind.css';
import '../../assets/styles/admin.css';

// Components
import Sidebar from '../../components/admin/Sidebar.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import StatsCards from '../../components/admin/StatsCards.astro';
import PageBuilderModal from '../../components/admin/PageBuilderModal.astro';

// Verificar autenticación
const authData = authHelpers.requireAuthFromCookies(Astro.request);
if (!authData) {
  return Astro.redirect('/admin/login');
}

const user = authHelpers.getUserById(authData.userId);
if (!user) {
  return Astro.redirect('/admin/login');
}

const metadata = {
  title: 'Gestión de Landing Pages - Admin Sonmyd',
  robots: {
    index: false,
    follow: false,
  },
};

// Header configuration
const headerActions = [
  { id: 'newPageBtn', label: 'Nueva Página', variant: 'primary' as const },
  { id: 'pageBuilderBtn', label: 'Constructor de Páginas', variant: 'gradient' as const, icon: '🛠️' },
  { id: 'templatesBtn', label: 'Plantillas', variant: 'secondary' as const }
];

// Stats configuration
const statsData = [
  {
    id: 'totalPages',
    title: 'Total Páginas',
    value: '-',
    color: 'blue' as const,
    icon: 'M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z'
  },
  {
    id: 'publishedPages',
    title: 'Publicadas',
    value: '-',
    color: 'green' as const,
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
  },
  {
    id: 'monthlyViews',
    title: 'Visitas del Mes',
    value: '-',
    color: 'yellow' as const,
    icon: 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z'
  },
  {
    id: 'conversions',
    title: 'Conversiones',
    value: '-',
    color: 'purple' as const,
    icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6'
  }
];
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{metadata.title}</title>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body class="bg-gray-100">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <Sidebar user={user} currentPath="/admin/landing-pages" />

    <!-- Main Content -->
    <div class="flex-1 overflow-auto">
      <!-- Header -->
      <PageHeader 
        title="Gestión de Landing Pages" 
        description="Administra las páginas de aterrizaje y conversión"
        actions={headerActions}
      />

      <!-- Content -->
      <div class="p-6">
        <!-- Stats Cards -->
        <StatsCards stats={statsData} />

        <!-- Filter Bar -->
        <div class="bg-white rounded-lg shadow p-4 mb-6">
          <div class="flex flex-wrap gap-4 items-center">
            <div class="flex items-center space-x-2">
              <label class="text-sm font-medium text-gray-700">Estado:</label>
              <select id="statusFilter" class="px-3 py-2 border border-gray-300 rounded-md text-sm">
                <option value="">Todos</option>
                <option value="published">Publicadas</option>
                <option value="draft">Borradores</option>
                <option value="archived">Archivadas</option>
              </select>
            </div>
            <div class="flex items-center space-x-2">
              <label class="text-sm font-medium text-gray-700">Tipo:</label>
              <select id="typeFilter" class="px-3 py-2 border border-gray-300 rounded-md text-sm">
                <option value="">Todos</option>
                <option value="landing">Landing Page</option>
                <option value="sales">Sales Page</option>
                <option value="capture">Lead Capture</option>
              </select>
            </div>
            <div class="flex-1">
              <input 
                type="text" 
                id="searchPages" 
                placeholder="Buscar páginas..." 
                class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm"
              />
            </div>
          </div>
        </div>

        <!-- Pages Grid -->
        <div id="pagesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Las páginas se cargarán dinámicamente -->
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden text-center py-12">
          <div class="mx-auto w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mb-4">
            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-medium text-gray-900 mb-2">No hay páginas creadas</h3>
          <p class="text-gray-500 mb-4">Comienza creando tu primera landing page</p>
          <button class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
            Crear Primera Página
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Page Creation Modal -->
  <div id="pageModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full z-50">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
      <div class="mt-3 text-center">
        <h3 class="text-lg font-medium text-gray-900">Crear/Editar Página</h3>
        <form id="pageForm" class="mt-4 space-y-4">
          <div class="text-left">
            <label class="block text-sm font-medium text-gray-700 mb-1">Nombre de la página</label>
            <input type="text" id="pageName" class="w-full px-3 py-2 border border-gray-300 rounded-md">
          </div>
          <div class="text-left">
            <label class="block text-sm font-medium text-gray-700 mb-1">Slug (URL)</label>
            <input type="text" id="pageSlug" class="w-full px-3 py-2 border border-gray-300 rounded-md">
          </div>
          <div class="text-left">
            <label class="block text-sm font-medium text-gray-700 mb-1">Tipo</label>
            <select id="pageType" class="w-full px-3 py-2 border border-gray-300 rounded-md">
              <option value="landing">Landing Page</option>
              <option value="sales">Sales Page</option>
              <option value="capture">Lead Capture</option>
            </select>
          </div>
          <div class="text-left">
            <label class="block text-sm font-medium text-gray-700 mb-1">Estado</label>
            <select id="pageStatus" class="w-full px-3 py-2 border border-gray-300 rounded-md">
              <option value="draft">Borrador</option>
              <option value="published">Publicada</option>
              <option value="archived">Archivada</option>
            </select>
          </div>
          <div class="text-left">
            <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
            <textarea id="pageDescription" class="w-full px-3 py-2 border border-gray-300 rounded-md h-20"></textarea>
          </div>
          <div class="flex gap-2 pt-4">
            <button type="submit" class="flex-1 bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">
              Guardar
            </button>
            <button type="button" id="closePageModal" class="flex-1 bg-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-400">
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Templates Modal -->
  <div id="templatesModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full z-50">
    <div class="relative top-10 mx-auto p-5 border w-11/12 max-w-4xl shadow-lg rounded-md bg-white">
      <div class="mt-3">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-medium text-gray-900">Plantillas de Páginas</h3>
          <button id="closeTemplatesModal" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Template cards will be loaded here -->
        </div>
      </div>
    </div>
  </div>

  <!-- Page Builder Modal -->
  <PageBuilderModal />

  <!-- JavaScript -->
  <script>
    // This would contain the JavaScript from the original file
    // For now, we'll keep it as a placeholder
    console.log('Landing pages admin initialized');
    
    // Initialize the page when DOM is ready
    document.addEventListener('DOMContentLoaded', function() {
      // Load initial data
      loadStats();
      loadPages();
      
      // Setup event listeners
      setupEventListeners();
    });

    function loadStats() {
      // Placeholder for stats loading
      console.log('Loading stats...');
    }

    function loadPages() {
      // Placeholder for pages loading
      console.log('Loading pages...');
    }

    function setupEventListeners() {
      // Placeholder for event listeners setup
      console.log('Setting up event listeners...');
    }
  </script>
</body>
</html>