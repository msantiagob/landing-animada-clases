---
export const prerender = false;

import { authHelpers } from '../../lib/auth';
import '../../assets/styles/tailwind.css';
import fs from 'fs';
import path from 'path';
import matter from 'gray-matter';

// Verificar autenticación
const authData = authHelpers.requireAuthFromCookies(Astro.request);
if (!authData) {
  return Astro.redirect('/admin/login');
}

const user = authHelpers.getUserById(authData.userId);
if (!user) {
  return Astro.redirect('/admin/login');
}

const metadata = {
  title: 'Gestión de Blog - Admin Sonmyd',
  robots: {
    index: false,
    follow: false,
  },
};

// Función para obtener todos los posts
function getAllPosts() {
  const postsDirectory = path.join(process.cwd(), 'src', 'data', 'post');
  const filenames = fs.readdirSync(postsDirectory);
  
  const posts = filenames
    .filter(name => name.endsWith('.md') || name.endsWith('.mdx'))
    .map(filename => {
      const filePath = path.join(postsDirectory, filename);
      const fileContent = fs.readFileSync(filePath, 'utf8');
      const { data, content } = matter(fileContent);
      
      return {
        filename,
        slug: filename.replace(/\.(md|mdx)$/, ''),
        ...data,
        content,
        publishDate: data.publishDate || new Date(),
        lastModified: fs.statSync(filePath).mtime
      };
    })
    .sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
  
  return posts;
}

let posts = [];
let error = null;

try {
  posts = getAllPosts();
} catch (err) {
  error = err.message;
}
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{metadata.title}</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    .sidebar-link.active {
      @apply bg-blue-100 text-blue-700 border-r-4 border-blue-700;
    }
    .editor-container {
      height: 400px;
    }
    .draft-badge {
      @apply bg-yellow-100 text-yellow-800;
    }
    .published-badge {
      @apply bg-green-100 text-green-800;
    }
  </style>
</head>
<body class="bg-gray-100">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="w-64 bg-white shadow-lg">
      <div class="p-6 border-b">
        <h2 class="text-xl font-bold text-gray-800">Admin Sonmyd</h2>
        <p class="text-sm text-gray-600">Bienvenido, {user.name}</p>
      </div>
      
      <nav class="mt-6">
        <a href="/admin/dashboard" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 5 4-4 4 4"></path>
          </svg>
          Dashboard
        </a>
        
        <a href="/admin/forms" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.34a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          Formularios
        </a>
        
        <a href="/admin/appointments" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v14a2 2 0 002 2z"></path>
          </svg>
          Citas
        </a>
        
        <a href="/admin/blog" class="sidebar-link active flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Blog
        </a>
        
        <a href="/admin/emails" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
          </svg>
          Emails
        </a>
        
        <a href="/admin/landing-pages" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
          </svg>
          Landing Pages
        </a>
      </nav>
      
      <!-- Logout -->
      <div class="absolute bottom-0 w-64 p-6 border-t">
        <button id="logoutBtn" class="flex items-center text-gray-700 hover:text-red-600">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          Cerrar Sesión
        </button>
      </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1 overflow-auto">
      <!-- Header -->
      <div class="bg-white shadow-sm p-6 border-b">
        <div class="flex justify-between items-center">
          <div>
            <h1 class="text-2xl font-bold text-gray-800">Gestión de Blog</h1>
            <p class="text-gray-600">Administra los posts del blog</p>
          </div>
          
          <div class="flex space-x-4">
            <button id="newPostBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 text-sm">
              Nuevo Post
            </button>
            <button id="refreshBtn" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 text-sm">
              Actualizar
            </button>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="p-6">
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 rounded-full bg-blue-100 text-blue-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">Total Posts</h3>
                <p class="text-2xl font-bold text-gray-900">{posts.length}</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 rounded-full bg-green-100 text-green-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">Publicados</h3>
                <p class="text-2xl font-bold text-gray-900">{posts.filter(p => p.publishDate <= new Date()).length}</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 rounded-full bg-yellow-100 text-yellow-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">Programados</h3>
                <p class="text-2xl font-bold text-gray-900">{posts.filter(p => p.publishDate > new Date()).length}</p>
              </div>
            </div>
          </div>
        </div>

        {error && (
          <div class="mb-6 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
            <p><strong>Error:</strong> {error}</p>
          </div>
        )}

        <!-- Posts Table -->
        <div class="bg-white rounded-lg shadow">
          <div class="px-6 py-4 border-b">
            <h3 class="text-lg font-semibold text-gray-800">Posts del Blog</h3>
          </div>
          
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Título</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Categoría</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                {posts.map(post => (
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4">
                      <div>
                        <div class="text-sm font-medium text-gray-900">{post.title || post.filename}</div>
                        <div class="text-sm text-gray-500">{post.slug}</div>
                        {post.excerpt && (
                          <div class="text-xs text-gray-400 mt-1 max-w-md truncate">{post.excerpt}</div>
                        )}
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded">{post.category || 'Sin categoría'}</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class={`px-2 py-1 text-xs rounded ${post.publishDate <= new Date() ? 'published-badge' : 'draft-badge'}`}>
                        {post.publishDate <= new Date() ? 'Publicado' : 'Programado'}
                      </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <div>{new Date(post.publishDate).toLocaleDateString('es-ES')}</div>
                      <div class="text-xs text-gray-400">
                        Mod: {new Date(post.lastModified).toLocaleDateString('es-ES')}
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                      <div class="flex space-x-2">
                        <a href={`/blog/${post.slug}`} target="_blank" class="text-blue-600 hover:text-blue-900">Ver</a>
                        <button onclick={`editPost('${post.filename}')`} class="text-green-600 hover:text-green-900">Editar</button>
                        <button onclick={`deletePost('${post.filename}')`} class="text-red-600 hover:text-red-900">Eliminar</button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Post Modal -->
  <div id="editPostModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full">
    <div class="relative top-10 mx-auto p-5 border w-11/12 md:w-4/5 lg:w-3/4 shadow-lg rounded-md bg-white">
      <div class="mt-3">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold text-gray-800" id="modalTitle">Editar Post</h3>
          <button id="closeModal" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <form id="postForm" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Título</label>
              <input type="text" id="postTitle" class="w-full border border-gray-300 rounded-md px-3 py-2" required>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
              <input type="text" id="postSlug" class="w-full border border-gray-300 rounded-md px-3 py-2" required>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Categoría</label>
              <input type="text" id="postCategory" class="w-full border border-gray-300 rounded-md px-3 py-2">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Fecha de publicación</label>
              <input type="datetime-local" id="postPublishDate" class="w-full border border-gray-300 rounded-md px-3 py-2">
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Extracto</label>
            <textarea id="postExcerpt" rows="3" class="w-full border border-gray-300 rounded-md px-3 py-2"></textarea>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Imagen (URL)</label>
            <input type="url" id="postImage" class="w-full border border-gray-300 rounded-md px-3 py-2">
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Tags (separados por comas)</label>
            <input type="text" id="postTags" class="w-full border border-gray-300 rounded-md px-3 py-2">
          </div>
          
          <!-- SEO Section -->
          <div class="border-t pt-4">
            <h4 class="text-md font-medium text-gray-700 mb-3">🔍 Configuración SEO</h4>
            <div class="grid grid-cols-1 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Meta título (SEO)</label>
                <input type="text" id="postMetaTitle" class="w-full border border-gray-300 rounded-md px-3 py-2" maxlength="60">
                <p class="text-xs text-gray-500 mt-1">Máximo 60 caracteres. Si está vacío, usará el título del post.</p>
              </div>
              
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Meta descripción (SEO)</label>
                <textarea id="postMetaDescription" rows="2" class="w-full border border-gray-300 rounded-md px-3 py-2" maxlength="160"></textarea>
                <p class="text-xs text-gray-500 mt-1">Máximo 160 caracteres. Si está vacío, usará el extracto.</p>
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">URL canónica (opcional)</label>
                  <input type="url" id="postCanonical" class="w-full border border-gray-300 rounded-md px-3 py-2">
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Autor</label>
                  <input type="text" id="postAuthor" class="w-full border border-gray-300 rounded-md px-3 py-2" value="Sonmyd">
                </div>
              </div>
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Contenido (Markdown)</label>
            <textarea id="postContent" rows="15" class="w-full border border-gray-300 rounded-md px-3 py-2 font-mono text-sm"></textarea>
          </div>
          
          <div class="flex justify-end space-x-3">
            <button type="button" id="cancelBtn" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400">
              Cancelar
            </button>
            <button type="submit" id="saveBtn" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
              Guardar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    let isEditMode = false;
    let currentFilename = null;

    // Edit post function
    function editPost(filename) {
      isEditMode = true;
      currentFilename = filename;
      document.getElementById('modalTitle').textContent = 'Editar Post';
      
      // Load post data
      fetch(`/api/admin/blog?filename=${filename}`)
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            populateForm(data.post);
            document.getElementById('editPostModal').classList.remove('hidden');
          } else {
            alert('Error cargando el post: ' + data.error);
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('Error de conexión');
        });
    }

    // Delete post function
    function deletePost(filename) {
      if (confirm('¿Estás seguro de que quieres eliminar este post?')) {
        fetch('/api/admin/blog', {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ filename })
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            location.reload();
          } else {
            alert('Error eliminando el post: ' + data.error);
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('Error de conexión');
        });
      }
    }

    // New post function
    function newPost() {
      isEditMode = false;
      currentFilename = null;
      document.getElementById('modalTitle').textContent = 'Nuevo Post';
      
      // Clear form
      document.getElementById('postForm').reset();
      document.getElementById('postPublishDate').value = new Date().toISOString().slice(0, 16);
      
      document.getElementById('editPostModal').classList.remove('hidden');
    }

    // Populate form with post data
    function populateForm(post) {
      document.getElementById('postTitle').value = post.title || '';
      document.getElementById('postSlug').value = post.slug || '';
      document.getElementById('postCategory').value = post.category || '';
      document.getElementById('postExcerpt').value = post.excerpt || '';
      document.getElementById('postImage').value = post.image || '';
      document.getElementById('postTags').value = post.tags ? post.tags.join(', ') : '';
      document.getElementById('postContent').value = post.content || '';
      
      // SEO fields
      document.getElementById('postMetaTitle').value = post.metaTitle || '';
      document.getElementById('postMetaDescription').value = post.metaDescription || '';
      document.getElementById('postCanonical').value = post.canonical || '';
      document.getElementById('postAuthor').value = post.author || 'Sonmyd';
      
      if (post.publishDate) {
        const date = new Date(post.publishDate);
        document.getElementById('postPublishDate').value = date.toISOString().slice(0, 16);
      }
    }

    // Generate slug from title
    function generateSlug(title) {
      return title
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .trim();
    }

    // Event listeners
    document.getElementById('postTitle').addEventListener('input', function() {
      if (!isEditMode) {
        document.getElementById('postSlug').value = generateSlug(this.value);
      }
    });

    document.getElementById('newPostBtn').addEventListener('click', newPost);

    document.getElementById('refreshBtn').addEventListener('click', () => {
      location.reload();
    });

    document.getElementById('closeModal').addEventListener('click', () => {
      document.getElementById('editPostModal').classList.add('hidden');
    });

    document.getElementById('cancelBtn').addEventListener('click', () => {
      document.getElementById('editPostModal').classList.add('hidden');
    });

    document.getElementById('postForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = {
        title: document.getElementById('postTitle').value,
        slug: document.getElementById('postSlug').value,
        category: document.getElementById('postCategory').value,
        excerpt: document.getElementById('postExcerpt').value,
        image: document.getElementById('postImage').value,
        tags: document.getElementById('postTags').value.split(',').map(t => t.trim()).filter(t => t),
        content: document.getElementById('postContent').value,
        publishDate: document.getElementById('postPublishDate').value,
        // SEO fields
        metaTitle: document.getElementById('postMetaTitle').value,
        metaDescription: document.getElementById('postMetaDescription').value,
        canonical: document.getElementById('postCanonical').value,
        author: document.getElementById('postAuthor').value
      };

      const method = isEditMode ? 'PUT' : 'POST';
      const body = isEditMode ? 
        JSON.stringify({ ...formData, filename: currentFilename }) :
        JSON.stringify(formData);

      try {
        const response = await fetch('/api/admin/blog', {
          method,
          headers: {
            'Content-Type': 'application/json',
          },
          body
        });

        const result = await response.json();
        
        if (result.success) {
          document.getElementById('editPostModal').classList.add('hidden');
          location.reload();
        } else {
          alert('Error guardando el post: ' + result.error);
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error de conexión');
      }
    });

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        const response = await fetch('/api/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'logout' })
        });
        if (response.ok) {
          window.location.href = '/admin/login';
        }
      } catch (error) {
        console.error('Error logging out:', error);
      }
    });

    // Make functions globally available
    window.editPost = editPost;
    window.deletePost = deletePost;
  </script>
</body>
</html>