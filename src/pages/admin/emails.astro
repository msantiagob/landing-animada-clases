---
export const prerender = false;

import { authHelpers } from '../../lib/auth';
import '../../assets/styles/tailwind.css';

// Verificar autenticación
const authData = authHelpers.requireAuthFromCookies(Astro.request);
if (!authData) {
  return Astro.redirect('/admin/login');
}

const user = authHelpers.getUserById(authData.userId);
if (!user) {
  return Astro.redirect('/admin/login');
}

const metadata = {
  title: 'Gestión de Emails - Admin Sonmyd',
  robots: {
    index: false,
    follow: false,
  },
};
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{metadata.title}</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    .sidebar-link.active {
      @apply bg-blue-100 text-blue-700 border-r-4 border-blue-700;
    }
    .template-preview {
      min-height: 300px;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      background: white;
    }
  </style>
</head>
<body class="bg-gray-100">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="w-64 bg-white shadow-lg">
      <div class="p-6 border-b">
        <h2 class="text-xl font-bold text-gray-800">Admin Sonmyd</h2>
        <p class="text-sm text-gray-600">Bienvenido, {user.name}</p>
      </div>
      
      <nav class="mt-6">
        <a href="/admin/dashboard" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 5 4-4 4 4"></path>
          </svg>
          Dashboard
        </a>
        
        <a href="/admin/forms" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.34a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          Formularios
        </a>
        
        <a href="/admin/appointments" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v14a2 2 0 002 2z"></path>
          </svg>
          Citas
        </a>
        
        <a href="/admin/blog" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Blog
        </a>
        
        <a href="/admin/emails" class="sidebar-link active flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
          </svg>
          Emails
        </a>
        
        <a href="/admin/landing-pages" class="sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
          </svg>
          Landing Pages
        </a>
      </nav>
      
      <!-- Logout -->
      <div class="absolute bottom-0 w-64 p-6 border-t">
        <button id="logoutBtn" class="flex items-center text-gray-700 hover:text-red-600">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          Cerrar Sesión
        </button>
      </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1 overflow-auto">
      <!-- Header -->
      <div class="bg-white shadow-sm p-6 border-b">
        <div class="flex justify-between items-center">
          <div>
            <h1 class="text-2xl font-bold text-gray-800">Gestión de Emails</h1>
            <p class="text-gray-600">Administra plantillas de email y campañas</p>
          </div>
          
          <div class="flex space-x-4">
            <button id="newTemplateBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 text-sm">
              Nueva Plantilla
            </button>
            <button id="sendCampaignBtn" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 text-sm">
              Enviar Campaña
            </button>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="p-6">
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 rounded-full bg-blue-100 text-blue-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">Emails Enviados</h3>
                <p id="sentCount" class="text-2xl font-bold text-gray-900">-</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 rounded-full bg-green-100 text-green-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">Entregados</h3>
                <p id="deliveredCount" class="text-2xl font-bold text-gray-900">-</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 rounded-full bg-yellow-100 text-yellow-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">Abiertos</h3>
                <p id="openedCount" class="text-2xl font-bold text-gray-900">-</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 rounded-full bg-purple-100 text-purple-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-medium text-gray-500">Clicks</h3>
                <p id="clickedCount" class="text-2xl font-bold text-gray-900">-</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Tabs -->
        <div class="bg-white rounded-lg shadow mb-6">
          <div class="border-b border-gray-200">
            <nav class="-mb-px flex">
              <button id="templatesTab" class="tab-button active py-4 px-6 text-sm font-medium border-b-2 border-blue-500 text-blue-600">
                Plantillas
              </button>
              <button id="campaignsTab" class="tab-button py-4 px-6 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">
                Campañas
              </button>
              <button id="subscribersTab" class="tab-button py-4 px-6 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">
                Suscriptores
              </button>
            </nav>
          </div>

          <!-- Templates Tab Content -->
          <div id="templatesContent" class="tab-content p-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg font-semibold text-gray-800">Plantillas de Email</h3>
              <button id="newTemplateBtn2" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 text-sm">
                Nueva Plantilla
              </button>
            </div>
            
            <div id="templatesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              <!-- Templates will be loaded here -->
            </div>
          </div>

          <!-- Campaigns Tab Content -->
          <div id="campaignsContent" class="tab-content hidden p-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg font-semibold text-gray-800">Campañas de Email</h3>
              <button id="newCampaignBtn" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 text-sm">
                Nueva Campaña
              </button>
            </div>
            
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Campaña</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Enviados</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                  </tr>
                </thead>
                <tbody id="campaignsTableBody" class="bg-white divide-y divide-gray-200">
                  <!-- Campaigns will be loaded here -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Subscribers Tab Content -->
          <div id="subscribersContent" class="tab-content hidden p-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg font-semibold text-gray-800">Lista de Suscriptores</h3>
              <div class="flex space-x-2">
                <button id="importSubscribersBtn" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 text-sm">
                  Importar
                </button>
                <button id="exportSubscribersBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 text-sm">
                  Exportar
                </button>
              </div>
            </div>
            
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nombre</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                  </tr>
                </thead>
                <tbody id="subscribersTableBody" class="bg-white divide-y divide-gray-200">
                  <!-- Subscribers will be loaded here -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Template Modal -->
  <div id="templateModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full">
    <div class="relative top-10 mx-auto p-5 border w-11/12 md:w-4/5 lg:w-3/4 shadow-lg rounded-md bg-white">
      <div class="mt-3">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold text-gray-800" id="templateModalTitle">Nueva Plantilla</h3>
          <button id="closeTemplateModal" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <form id="templateForm" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Nombre de la plantilla</label>
              <input type="text" id="templateName" class="w-full border border-gray-300 rounded-md px-3 py-2" required>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Asunto</label>
              <input type="text" id="templateSubject" class="w-full border border-gray-300 rounded-md px-3 py-2" required>
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Contenido HTML</label>
            <textarea id="templateContent" rows="15" class="w-full border border-gray-300 rounded-md px-3 py-2 font-mono text-sm" required></textarea>
          </div>
          
          <div class="flex justify-end space-x-3">
            <button type="button" id="cancelTemplateBtn" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400">
              Cancelar
            </button>
            <button type="button" id="previewTemplateBtn" class="px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700">
              Vista Previa
            </button>
            <button type="submit" id="saveTemplateBtn" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
              Guardar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Campaign Modal -->
  <div id="campaignModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full">
    <div class="relative top-10 mx-auto p-5 border w-11/12 md:w-3/4 shadow-lg rounded-md bg-white">
      <div class="mt-3">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold text-gray-800">Nueva Campaña</h3>
          <button id="closeCampaignModal" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <form id="campaignForm" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Nombre de la campaña</label>
              <input type="text" id="campaignName" class="w-full border border-gray-300 rounded-md px-3 py-2" required>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Plantilla</label>
              <select id="campaignTemplate" class="w-full border border-gray-300 rounded-md px-3 py-2" required>
                <option value="">Seleccionar plantilla</option>
              </select>
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Destinatarios</label>
            <select id="campaignRecipients" class="w-full border border-gray-300 rounded-md px-3 py-2" required>
              <option value="all">Todos los suscriptores</option>
              <option value="active">Solo suscriptores activos</option>
              <option value="recent">Suscriptores recientes (último mes)</option>
            </select>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Programar envío</label>
            <input type="datetime-local" id="campaignSchedule" class="w-full border border-gray-300 rounded-md px-3 py-2">
            <p class="text-xs text-gray-500 mt-1">Dejar vacío para enviar inmediatamente</p>
          </div>
          
          <div class="flex justify-end space-x-3">
            <button type="button" id="cancelCampaignBtn" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400">
              Cancelar
            </button>
            <button type="submit" id="saveCampaignBtn" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
              Crear Campaña
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    let currentTab = 'templates';
    
    // Tab switching
    document.querySelectorAll('.tab-button').forEach(button => {
      button.addEventListener('click', (e) => {
        const tabId = e.target.id.replace('Tab', '');
        switchTab(tabId);
      });
    });

    function switchTab(tabId) {
      // Update buttons
      document.querySelectorAll('.tab-button').forEach(btn => {
        btn.classList.remove('active', 'border-blue-500', 'text-blue-600');
        btn.classList.add('border-transparent', 'text-gray-500');
      });
      
      document.getElementById(tabId + 'Tab').classList.add('active', 'border-blue-500', 'text-blue-600');
      document.getElementById(tabId + 'Tab').classList.remove('border-transparent', 'text-gray-500');

      // Update content
      document.querySelectorAll('.tab-content').forEach(content => {
        content.classList.add('hidden');
      });
      
      document.getElementById(tabId + 'Content').classList.remove('hidden');
      currentTab = tabId;

      // Load data for the current tab
      loadTabData(tabId);
    }

    async function loadTabData(tab) {
      try {
        switch(tab) {
          case 'templates':
            loadTemplates();
            break;
          case 'campaigns':
            loadCampaigns();
            break;
          case 'subscribers':
            loadSubscribers();
            break;
        }
      } catch (error) {
        console.error(`Error loading ${tab} data:`, error);
      }
    }

    async function loadStats() {
      // Mock data - replace with actual API call
      document.getElementById('sentCount').textContent = '1,234';
      document.getElementById('deliveredCount').textContent = '1,198';
      document.getElementById('openedCount').textContent = '456';
      document.getElementById('clickedCount').textContent = '123';
    }

    async function loadTemplates() {
      const grid = document.getElementById('templatesGrid');
      
      // Mock templates - replace with actual API call
      const templates = [
        { id: 1, name: 'Bienvenida', subject: 'Bienvenido a Sonmyd', lastModified: new Date() },
        { id: 2, name: 'Newsletter', subject: 'Newsletter mensual', lastModified: new Date() },
        { id: 3, name: 'Recordatorio cita', subject: 'Recordatorio de tu próxima cita', lastModified: new Date() }
      ];

      grid.innerHTML = templates.map(template => `
        <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
          <div class="flex justify-between items-start mb-3">
            <h4 class="font-semibold text-gray-900">${template.name}</h4>
            <div class="flex space-x-1">
              <button onclick="editTemplate(${template.id})" class="text-blue-600 hover:text-blue-800 text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
              </button>
              <button onclick="deleteTemplate(${template.id})" class="text-red-600 hover:text-red-800 text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            </div>
          </div>
          <p class="text-sm text-gray-600 mb-2">${template.subject}</p>
          <p class="text-xs text-gray-400">Modificado: ${template.lastModified.toLocaleDateString('es-ES')}</p>
        </div>
      `).join('');
    }

    async function loadCampaigns() {
      const tbody = document.getElementById('campaignsTableBody');
      
      // Mock campaigns - replace with actual API call
      const campaigns = [
        { id: 1, name: 'Newsletter Enero', status: 'sent', sent: 1200, date: new Date() },
        { id: 2, name: 'Promoción especial', status: 'draft', sent: 0, date: new Date() }
      ];

      tbody.innerHTML = campaigns.map(campaign => `
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm font-medium text-gray-900">${campaign.name}</div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <span class="px-2 py-1 text-xs rounded-full ${campaign.status === 'sent' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'}">
              ${campaign.status === 'sent' ? 'Enviada' : 'Borrador'}
            </span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${campaign.sent}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${campaign.date.toLocaleDateString('es-ES')}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
            <button onclick="viewCampaign(${campaign.id})" class="text-blue-600 hover:text-blue-900 mr-3">Ver</button>
            ${campaign.status === 'draft' ? `<button onclick="sendCampaign(${campaign.id})" class="text-green-600 hover:text-green-900">Enviar</button>` : ''}
          </td>
        </tr>
      `).join('');
    }

    async function loadSubscribers() {
      const tbody = document.getElementById('subscribersTableBody');
      
      // Mock subscribers - replace with actual API call
      const subscribers = [
        { id: 1, email: 'usuario@email.com', name: 'Juan Pérez', status: 'active', date: new Date() },
        { id: 2, email: 'maria@email.com', name: 'María García', status: 'unsubscribed', date: new Date() }
      ];

      tbody.innerHTML = subscribers.map(subscriber => `
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${subscriber.email}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${subscriber.name}</td>
          <td class="px-6 py-4 whitespace-nowrap">
            <span class="px-2 py-1 text-xs rounded-full ${subscriber.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
              ${subscriber.status === 'active' ? 'Activo' : 'Desuscrito'}
            </span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${subscriber.date.toLocaleDateString('es-ES')}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
            <button onclick="editSubscriber(${subscriber.id})" class="text-blue-600 hover:text-blue-900 mr-3">Editar</button>
            ${subscriber.status === 'active' ? `<button onclick="unsubscribeUser(${subscriber.id})" class="text-red-600 hover:text-red-900">Desuscribir</button>` : ''}
          </td>
        </tr>
      `).join('');
    }

    // Modal functions
    function showTemplateModal(template = null) {
      const modal = document.getElementById('templateModal');
      const title = document.getElementById('templateModalTitle');
      
      if (template) {
        title.textContent = 'Editar Plantilla';
        document.getElementById('templateName').value = template.name;
        document.getElementById('templateSubject').value = template.subject;
        document.getElementById('templateContent').value = template.content || '';
      } else {
        title.textContent = 'Nueva Plantilla';
        document.getElementById('templateForm').reset();
      }
      
      modal.classList.remove('hidden');
    }

    function showCampaignModal() {
      document.getElementById('campaignModal').classList.remove('hidden');
    }

    // Global functions
    function editTemplate(id) {
      // Mock template data - replace with actual API call
      const template = { id, name: 'Template ' + id, subject: 'Subject ' + id, content: '<h1>Template content</h1>' };
      showTemplateModal(template);
    }

    function deleteTemplate(id) {
      if (confirm('¿Estás seguro de que quieres eliminar esta plantilla?')) {
        // Call API to delete template
        console.log('Deleting template', id);
        loadTemplates();
      }
    }

    function editSubscriber(id) {
      console.log('Editing subscriber', id);
    }

    function unsubscribeUser(id) {
      if (confirm('¿Estás seguro de que quieres desuscribir a este usuario?')) {
        console.log('Unsubscribing user', id);
        loadSubscribers();
      }
    }

    function viewCampaign(id) {
      console.log('Viewing campaign', id);
    }

    function sendCampaign(id) {
      if (confirm('¿Estás seguro de que quieres enviar esta campaña?')) {
        console.log('Sending campaign', id);
        loadCampaigns();
      }
    }

    // Event listeners
    document.getElementById('newTemplateBtn').addEventListener('click', () => showTemplateModal());
    document.getElementById('newTemplateBtn2').addEventListener('click', () => showTemplateModal());
    document.getElementById('sendCampaignBtn').addEventListener('click', showCampaignModal);
    document.getElementById('newCampaignBtn').addEventListener('click', showCampaignModal);

    document.getElementById('closeTemplateModal').addEventListener('click', () => {
      document.getElementById('templateModal').classList.add('hidden');
    });

    document.getElementById('cancelTemplateBtn').addEventListener('click', () => {
      document.getElementById('templateModal').classList.add('hidden');
    });

    document.getElementById('closeCampaignModal').addEventListener('click', () => {
      document.getElementById('campaignModal').classList.add('hidden');
    });

    document.getElementById('cancelCampaignBtn').addEventListener('click', () => {
      document.getElementById('campaignModal').classList.add('hidden');
    });

    document.getElementById('templateForm').addEventListener('submit', (e) => {
      e.preventDefault();
      // Save template logic here
      console.log('Saving template');
      document.getElementById('templateModal').classList.add('hidden');
      loadTemplates();
    });

    document.getElementById('campaignForm').addEventListener('submit', (e) => {
      e.preventDefault();
      // Save campaign logic here
      console.log('Saving campaign');
      document.getElementById('campaignModal').classList.add('hidden');
      loadCampaigns();
    });

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        const response = await fetch('/api/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'logout' })
        });
        if (response.ok) {
          window.location.href = '/admin/login';
        }
      } catch (error) {
        console.error('Error logging out:', error);
      }
    });

    // Initialize page
    document.addEventListener('DOMContentLoaded', () => {
      loadStats();
      loadTabData('templates');
    });

    // Make functions globally available
    window.editTemplate = editTemplate;
    window.deleteTemplate = deleteTemplate;
    window.editSubscriber = editSubscriber;
    window.unsubscribeUser = unsubscribeUser;
    window.viewCampaign = viewCampaign;
    window.sendCampaign = sendCampaign;
  </script>
</body>
</html>