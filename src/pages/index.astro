---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import ServiceArea from '~/components/widgets/ServiceArea.astro';
import LeadCapture from '~/components/widgets/LeadCapture.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Button from '~/components/ui/Button.astro';
import WhatsAppButton from '~/components/ui/WhatsAppButton.astro';
import Image from '~/components/common/Image.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { BUSINESS } from '~/data/business';
import { HUBS, LANDINGS, SILOS } from '~/data/landings';
import type { SiloId } from '~/data/landings';
import { getSeoImageMeta } from '~/data/seo-images';
import { HUB_LINK_LABEL, getHub, landingPath, landingsBySilo, landingsForHub } from '~/utils/landings';
import { faqSchema, itemListSchema } from '~/utils/seo';
import { getSeoImage } from '~/utils/seo-images';
import { formatList } from '~/utils/service-area';

/**
 * Inicio.
 *
 * Es la puerta de entrada a los tres hubs (clases, servicios y marketing) y
 * reparte enlaces hacia todas las landings del registro. Todo lo que lista sale
 * de `src/data/landings.ts`: una landing nueva aparece aquí sin tocar esta página.
 *
 * No lleva cifras, clientes ni reseñas: ninguna se ha verificado. Los datos del
 * negocio (ciudad, teléfono, municipios) salen de `src/data/business.ts`.
 */

const homeImage = getSeoImage('home');
const medellinImage = getSeoImage('medellin');

// La imagen social se declara como `~/assets/...` y `adaptOpenGraphImages` la
// resuelve al renderizar: es la misma convención que usa `landingMetadata()`.
const socialImage = getSeoImageMeta('home');
if (!socialImage) throw new Error('Missing SEO image metadata for "home"');

const metadata = {
  title: 'Software, IA y clases de programación en Medellín | Sonmyd',
  description:
    'Sonmyd, en Medellín: desarrollamos software, apps, páginas web, bots y automatizaciones con IA, y enseñamos programación, IA, AWS y Linux. Escríbenos.',
  ignoreTitleTemplate: true,
  canonical: '/',
  openGraph: {
    images: [{ url: `~/assets/images/seo/${socialImage.file}`, width: socialImage.width, height: socialImage.height }],
  },
};

const courseHub = getHub('clases-de-programacion');
const servicesHub = getHub('servicios');
const marketingHub = getHub('marketing-digital');

const courses = landingsForHub(courseHub.slug);

// Los silos que cuelgan del hub de servicios (marketing tiene su propio hub y su propia sección).
const serviceGroups = (Object.keys(SILOS) as SiloId[])
  .filter((silo) => SILOS[silo].hub === servicesHub.slug)
  .map((silo) => ({ id: silo, name: SILOS[silo].name, landings: landingsBySilo(silo) }));

const marketing = landingsBySilo('marketing');

const COUNTRY_NAME = 'Colombia';

const faqs = [
  {
    question: '¿Qué hace Sonmyd exactamente?',
    answer:
      'Dos cosas que se complementan: construimos y enseñamos. Desarrollamos software a medida, páginas web, apps, bots, agentes de IA, automatizaciones, servidores, seguridad y campañas de marketing digital, y damos clases 1 a 1 de programación, inteligencia artificial, AWS, Linux, n8n y marketing digital. Puedes empezar aprendiendo y terminar contratando, o al revés.',
  },
  {
    question: '¿Las clases son presenciales o en línea?',
    answer:
      'Ambas. Damos clases 1 a 1 en persona en Medellín y municipios cercanos, y también en línea y en vivo para estudiantes de toda Colombia. El plan se arma a partir de tu nivel actual y de lo que quieres lograr.',
  },
  {
    question: '¿Atienden fuera de Medellín?',
    answer: `Estamos en Medellín y atendemos en persona en ${formatList(BUSINESS.areaServed)}. Si estás en otra ciudad, trabajamos de forma remota con clientes y estudiantes de toda Colombia.`,
  },
  {
    question: '¿Cuánto cuesta?',
    answer:
      'Depende de lo que necesites, y no damos un número sin haber entendido el problema. En los servicios, primero acotamos la versión más pequeña que ya te sirve y presentamos alcance, plazo y precio por escrito. En las clases, escríbenos y te contamos cómo se arma el plan y cuánto cuesta.',
  },
  {
    question: '¿Necesito saber de tecnología para empezar?',
    answer:
      'No. Las clases parten de tu nivel actual, incluso desde cero. Y en los proyectos te explicamos en lenguaje claro lo que haga falta para que puedas decidir bien.',
  },
  {
    question: '¿Cómo empiezo?',
    answer:
      'Agenda una asesoría gratuita, escríbenos por WhatsApp o deja tus datos en el formulario. Nos cuentas qué necesitas y te decimos si podemos ayudarte y cómo. Si no somos los indicados para tu caso, también te lo decimos.',
  },
];

// Clases compartidas por las tarjetas de landings: la tarjeta entera es clicable
// con un enlace extendido (`after:absolute after:inset-0`) y el ancla es el
// nombre de la landing destino, que describe adónde lleva el enlace.
const cardClass = 'card relative focus-within:ring-2 focus-within:ring-[color:var(--aw-color-cta)]';
const cardLinkClass =
  'underline-offset-4 hover:text-primary hover:underline focus:outline-none after:absolute after:inset-0';
const seeAllClass = 'btn-secondary';
---

<Layout metadata={metadata}>
  <StructuredData
    schema={[
      faqSchema(faqs),
      itemListSchema(
        [...HUBS, ...LANDINGS].map(({ name, slug }) => ({
          name,
          path: landingPath(slug),
        }))
      ),
    ]}
  />

  <!-- Hero ************************** -->

  <Hero tagline="Medellín, Colombia" image={homeImage}>
    <Fragment slot="title">
      Desarrollo de software, IA y clases de programación <span class="text-accent">en Medellín</span>
    </Fragment>

    <Fragment slot="subtitle">
      Desarrollamos software, apps, páginas web, bots y automatizaciones con IA, y enseñamos programación, IA, AWS y
      Linux en clases 1 a 1. Hablas con quien hace el trabajo, no con un vendedor.
    </Fragment>

    <Fragment slot="actions">
      <div class="flex w-full sm:w-auto">
        <Button
          variant="primary"
          text="Agenda una asesoría gratuita"
          href="/booking"
          icon="tabler:calendar-plus"
          class="w-full sm:w-auto"
        />
      </div>
      <div class="flex w-full sm:w-auto">
        <WhatsAppButton
          location="home-hero"
          variant="secondary"
          message="Hola, quiero información sobre las clases y los servicios de Sonmyd."
          class="w-full sm:w-auto"
        />
      </div>
    </Fragment>

    <Fragment slot="trust">
      <span>Asesoría inicial gratuita</span>
      <span>·</span>
      <span>Clases 1 a 1, en Medellín o en línea</span>
      <span>·</span>
      <span>Si no somos los indicados, te lo decimos</span>
    </Fragment>
  </Hero>

  <!-- Dos caminos ******************* -->

  <WidgetWrapper id="caminos" containerClass="max-w-6xl">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-surface"></div>
    </Fragment>

    <Headline
      tagline="Cómo podemos ayudarte"
      title="Aprende a hacerlo tú o deja que lo hagamos por ti"
      subtitle="Elige por dónde empezar. Puedes pasar de un camino al otro cuando quieras: lo que enseñamos es lo mismo que construimos."
    />

    <div class="grid gap-6 md:grid-cols-2">
      <article
        class="card relative flex h-full flex-col focus-within:ring-2 focus-within:ring-[color:var(--aw-color-cta)]"
      >
        <Icon name="tabler:school" class="mb-4 h-11 w-11 rounded-lg bg-subtle p-2.5 text-primary" aria-hidden="true" />
        <h3 class="text-2xl font-semibold text-heading">Aprende</h3>
        <p class="mt-3 text-muted">
          Clases 1 a 1 de inteligencia artificial, Python, JavaScript, desarrollo web y de apps, AWS, Linux, n8n y
          marketing digital. En Medellín o en línea, con proyectos reales y a tu ritmo.
        </p>
        <p class="mt-auto pt-6">
          <a
            href={landingPath(courseHub.slug)}
            class="inline-flex items-center gap-2 font-semibold text-primary underline-offset-4 hover:underline focus:outline-none after:absolute after:inset-0"
          >
            Ver las clases de programación
            <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
          </a>
        </p>
      </article>

      <article
        class="card relative flex h-full flex-col focus-within:ring-2 focus-within:ring-[color:var(--aw-color-cta)]"
      >
        <Icon name="tabler:code" class="mb-4 h-11 w-11 rounded-lg bg-subtle p-2.5 text-primary" aria-hidden="true" />
        <h3 class="text-2xl font-semibold text-heading">Lo hacemos por ti</h3>
        <p class="mt-3 text-muted">
          Software a medida, páginas web, apps, bots, agentes de IA, automatizaciones, servidores, seguridad y marketing
          digital. Tú nos cuentas el problema; nosotros lo construimos y lo medimos.
        </p>
        <p class="mt-auto pt-6">
          <a
            href={landingPath(servicesHub.slug)}
            class="inline-flex items-center gap-2 font-semibold text-primary underline-offset-4 hover:underline focus:outline-none after:absolute after:inset-0"
          >
            Ver los servicios
            <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
          </a>
        </p>
      </article>
    </div>
  </WidgetWrapper>

  <!-- Clases ************************ -->

  <WidgetWrapper id="clases" containerClass="max-w-6xl">
    <Headline
      tagline="Clases"
      title="Clases de programación 1 a 1 en Medellín y en línea"
      subtitle="Elige un tema o cuéntanos tu objetivo y armamos el plan contigo."
    />

    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        courses.map((course) => (
          <li class={cardClass}>
            <h3 class="text-lg font-semibold text-heading">
              <a href={landingPath(course.slug)} class={cardLinkClass}>
                {course.name}
              </a>
            </h3>
            <p class="mt-2 text-muted">{course.summary}</p>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-center">
      <a href={landingPath(courseHub.slug)} class={seeAllClass}>
        {HUB_LINK_LABEL[courseHub.slug]}
        <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    </p>
  </WidgetWrapper>

  <!-- Servicios, por silo *********** -->

  <WidgetWrapper id="servicios" containerClass="max-w-6xl">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-surface"></div>
    </Fragment>

    <Headline
      tagline="Servicios"
      title="Software, IA y tecnología para tu negocio"
      subtitle="Desarrollo, automatización con IA, nube y seguridad, hechos desde Medellín para empresas y personas de toda Colombia."
    />

    <div class="space-y-12">
      {
        serviceGroups.map((group) => (
          <div>
            <h3 class="mb-5 text-xl font-bold text-heading">{group.name}</h3>
            <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {group.landings.map((landing) => (
                <li class={cardClass}>
                  <h4 class="text-lg font-semibold text-heading">
                    <a href={landingPath(landing.slug)} class={cardLinkClass}>
                      {landing.name}
                    </a>
                  </h4>
                  <p class="mt-2 text-muted">{landing.summary}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-10 text-center">
      <a href={landingPath(servicesHub.slug)} class={seeAllClass}>
        {HUB_LINK_LABEL[servicesHub.slug]}
        <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    </p>
  </WidgetWrapper>

  <!-- Marketing ********************* -->

  <WidgetWrapper id="marketing" containerClass="max-w-6xl">
    <Headline
      tagline="Marketing digital"
      title="Marketing digital para conseguir clientes"
      subtitle="Campañas en Meta Ads, Google Shopping, posicionamiento SEO y llamadas con IA, con medición para saber qué funciona."
    />

    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        marketing.map((landing) => (
          <li class={cardClass}>
            <h3 class="text-lg font-semibold text-heading">
              <a href={landingPath(landing.slug)} class={cardLinkClass}>
                {landing.name}
              </a>
            </h3>
            <p class="mt-2 text-muted">{landing.summary}</p>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-center">
      <a href={landingPath(marketingHub.slug)} class={seeAllClass}>
        {HUB_LINK_LABEL[marketingHub.slug]}
        <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    </p>
  </WidgetWrapper>

  <!-- Cómo trabajamos *************** -->

  <Steps
    id="como-trabajamos"
    tagline="Cómo trabajamos"
    title="Un proceso simple, con las reglas claras desde el inicio"
    items={[
      {
        title: '1. Hablamos de tu caso',
        description:
          'Nos cuentas qué necesitas o qué quieres aprender, por WhatsApp, por el formulario o en una asesoría gratuita. Escuchamos antes de proponer nada.',
        icon: 'tabler:messages',
      },
      {
        title: '2. Definimos el alcance',
        description:
          'Acotamos la versión más pequeña que ya te sirve y la dejamos por escrito: qué se hace, cuánto cuesta y en cuánto tiempo. En las clases, armamos el plan a partir de tu nivel y de tu objetivo.',
        icon: 'tabler:file-description',
      },
      {
        title: '3. Construimos o enseñamos, por etapas',
        description:
          'Avanzamos en entregas cortas para que veas resultados y puedas corregir el rumbo. En las clases se practica con proyectos reales, no con ejercicios de juguete.',
        icon: 'tabler:code',
      },
      {
        title: '4. Medimos y ajustamos',
        description:
          'Revisamos con datos si funcionó (clientes, ventas, horas ahorradas) y ajustamos lo que haga falta.',
        icon: 'tabler:chart-bar',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-surface"></div>
    </Fragment>
  </Steps>

  <!-- Por qué Sonmyd **************** -->

  <Features
    id="por-que-sonmyd"
    tagline="Por qué Sonmyd"
    title="Lo que nos diferencia, sin exagerar"
    subtitle="Cuatro razones concretas, sin cifras infladas ni promesas vacías."
    columns={2}
    items={[
      {
        title: 'Un ingeniero real, no un intermediario',
        description:
          'Santiago Bedoya, ingeniero de software e instructor, escribe el código y da las clases. No hay una capa de vendedores entre tú y el trabajo.',
        icon: 'tabler:user-check',
        callToAction: { text: 'Conoce a Santiago', href: '/autor' },
      },
      {
        title: 'Clases 1 a 1, a tu medida',
        description:
          'El plan se arma a partir de tu nivel y de lo que quieres lograr, con proyectos reales en lugar de ejercicios de juguete. En Medellín o en línea.',
        icon: 'tabler:school',
      },
      {
        title: 'Enseñamos y construimos',
        description:
          'Lo que enseñamos sale de lo que construimos todos los días, y lo que construimos lo puedes aprender a operar. Puedes empezar por una cosa y pasar a la otra.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Medimos lo que importa',
        description:
          'Antes de empezar acordamos cómo vamos a saber si funcionó (clientes, ventas, horas ahorradas) y lo revisamos con datos, no con opiniones.',
        icon: 'tabler:target-arrow',
      },
    ]}
  />

  <!-- Local: Medellín *************** -->

  <div class="bg-surface">
    <ServiceArea
      id="medellin"
      kind="servicio"
      message="Hola, quiero información sobre las clases y los servicios de Sonmyd en Medellín."
    />

    <WidgetWrapper containerClass="max-w-5xl pt-0 md:pt-0 lg:pt-0">
      <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <Image
          class="w-full rounded-2xl border border-line shadow-card-lg"
          widths={[400, 768, 1024]}
          sizes="(max-width: 1023px) 100vw, 480px"
          width={1024}
          height={576}
          {...medellinImage}
        />

        <address class="card not-italic">
          <p class="eyebrow">Datos del negocio</p>
          <p class="mt-3 text-xl font-semibold text-heading">{BUSINESS.name}</p>
          <p class="mt-1 text-muted">
            {BUSINESS.address.locality}, {BUSINESS.address.region}, {COUNTRY_NAME}
          </p>
          <p class="mt-3 text-default">
            WhatsApp: <strong class="font-semibold text-heading">{BUSINESS.telephone}</strong>
          </p>
          <p class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
            <a class="text-primary underline underline-offset-4" href="/contact">Formulario de contacto</a>
            <a class="text-primary underline underline-offset-4" href="/booking">Agenda una asesoría</a>
          </p>
        </address>
      </div>
    </WidgetWrapper>
  </div>

  <!-- FAQs ************************** -->

  <FAQs
    id="preguntas-frecuentes"
    tagline="Dudas comunes"
    title="Preguntas frecuentes"
    subtitle="Lo que suelen preguntar antes de escribirnos."
    classes={{ container: 'max-w-6xl' }}
    items={faqs.map(({ question, answer }) => ({ title: question, description: answer }))}
  />

  <!-- Captura de leads ************** -->

  <LeadCapture
    formId="lead-home"
    title="Empecemos por tu caso"
    subtitle="Cuéntanos si quieres aprender o que lo hagamos por ti, y qué quieres lograr. Te decimos si podemos ayudarte, cómo y qué implica. Si no somos los indicados, también te lo decimos."
    bullets={[
      'Primera consulta sin costo y sin compromiso',
      'Hablas con quien hace el trabajo, no con un vendedor',
      'Si no somos los indicados para tu caso, te lo decimos',
      'Tus datos no se venden ni se ceden a terceros',
    ]}
    button="Quiero que me contacten"
  />

  <!--
    Información de la aplicación. Google la lee sin ejecutar JavaScript para
    verificar la marca y el uso de Google Calendar en el OAuth: por eso es texto
    visible, siempre en el HTML y sin ningún mecanismo para ocultarlo.
  -->
  <section id="sobre-la-plataforma" aria-label="Acerca de la plataforma Sonmyd" class="border-t border-line bg-page">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-3 px-4 py-12 text-center sm:px-6">
      <p class="text-sm font-bold uppercase tracking-widest text-heading">Sonmyd</p>
      <p class="text-sm leading-relaxed text-muted">
        Plataforma de tecnología, automatización e inteligencia artificial que opera desde Medellín, Colombia:
        desarrollo de software, sitios web y aplicaciones, integraciones con WhatsApp Business y con Google Calendar
        para el agendamiento de citas, automatización de procesos empresariales y clases de programación.
      </p>
      <p class="text-sm leading-relaxed text-muted">
        Sonmyd accede a Google Calendar a través de OAuth, con la autorización del usuario, para crear y gestionar
        citas. Este sitio utiliza Google Analytics, a través de Google Tag Manager, para medir el tráfico web.
      </p>
      <nav aria-label="Información legal" class="flex items-center gap-3 text-sm text-muted">
        <a class="underline underline-offset-4 hover:text-heading" href="/privacidad">Política de privacidad</a>
        <span aria-hidden="true">·</span>
        <a class="underline underline-offset-4 hover:text-heading" href="/terminos">Términos y condiciones</a>
      </nav>
    </div>
  </section>
</Layout>
