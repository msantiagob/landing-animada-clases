---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Sonmyd - Soluciones Tecnológicas e IA | Transformamos tu Negocio',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Consulta Gratuita',
        href: '/contact',
        target: '_self',
        icon: 'tabler:download',
      },
      { text: 'Nuestros Servicios', href: '/servicios', variant: 'tertiary' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80', alt: 'Tecnología e Inteligencia Artificial' }}
  >
    <Fragment slot="title">
      Transformamos tu negocio con <span class="hidden xl:inline">soluciones tecnológicas de</span>
      <span class="text-accent "> Inteligencia Artificial</span> y desarrollo avanzado
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Sonmyd</span> lidera la innovación tecnológica con soluciones de IA, desarrollo web y automatizaciones empresariales.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">Sonmyd: Innovación que transforma.</span>
      Especializados en capacitaciones tecnológicas, desarrollo de aplicaciones multiplataforma y automatización de procesos empresariales.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="Nuestra Visión:" description="Innovación, Excelencia Técnica y Resultados Transformadores" />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Por qué elegirnos"
    title="Lo que obtienes con Sonmyd"
    subtitle="Somos líderes en soluciones tecnológicas empresariales. Expertos certificados con más de 500 proyectos exitosos y capacitaciones especializadas en las últimas tecnologías."
    items={[
      {
        title: 'Soluciones de Inteligencia Artificial',
        description:
          'Implementamos IA avanzada para automatizar procesos, optimizar operaciones y generar insights valiosos para tu negocio.',
        icon: 'tabler:brain',
      },
      {
        title: 'Desarrollo Web Multiplataforma',
        description:
          'Creamos aplicaciones web y móviles de alto rendimiento que funcionan perfectamente en cualquier dispositivo y plataforma.',
        icon: 'tabler:device-desktop',
      },
      {
        title: 'Capacitaciones Especializadas',
        description:
          'Formamos a tu equipo en las últimas tecnologías con programas personalizados y certificaciones reconocidas internacionalmente.',
        icon: 'tabler:school',
      },
      {
        title: 'Automatización de Procesos',
        description:
          'Optimizamos tus operaciones con sistemas automatizados que reducen costos, eliminan errores y aumentan la productividad empresarial.',
        icon: 'tabler:robot',
      },
      {
        title: 'Soporte Técnico Especializado',
        description:
          "Ofrecemos acompañamiento continuo con nuestro equipo de expertos, garantizando el éxito y evolución constante de tus proyectos tecnológicos.",
        icon: 'tabler:headset',
      },
      {
        title: 'Innovación Continua',
        description:
          'Mantenemos tu negocio a la vanguardia con las últimas tendencias tecnológicas y metodologías ágiles de desarrollo.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Nuestro enfoque"
    title="Metodología Sonmyd: ¡Donde la Innovación se Encuentra con Resultados!"
    items={[
      {
        title: 'Tecnologías de Vanguardia',
        description:
          'Utilizamos las últimas tecnologías en IA, cloud computing y frameworks modernos para garantizar soluciones escalables y futuras.',
      },
      {
        title: 'Metodologías Ágiles',
        description:
          'Implementamos Scrum y DevOps para entregas rápidas, comunicación transparente y adaptación continua a tus necesidades.',
      },
      {
        title: 'Equipo Multidisciplinario',
        description:
          'Contamos con especialistas en IA, desarrollo full-stack, UX/UI y arquitectura de software trabajando en sinergia para tu proyecto.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Innovación que impulsa resultados</h3>
      Obtén una ventaja competitiva con tecnologías de última generación y expertise comprobado
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'High level of customization',
        description: `Tailor the template effortlessly to match your brand's identity and requirements, making your website distinct and saving you time.`,
      },
      {
        title: 'Multiple layout possibilities',
        description:
          'Explore various layout options to find the structure that best presents your content, enhancing user engagement and navigation.',
      },
      {
        title: 'Fully responsive design',
        description:
          "Ensure your website's optimal performance on various devices and screen sizes, providing a consistent and enjoyable user experience.",
      },
      {
        title: 'Integration of media',
        description:
          'Seamlessly incorporate images, videos, and multimedia elements that enhance your content and engage visitors effectively.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Blueprint Image',
    }}
  >
    <Fragment slot="content">Transformamos tus ideas en soluciones tecnológicas que generan valor real.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Enhanced user engagement',
        description:
          'Captivate your audience with interactive elements, intuitive navigation, and visually appealing layouts, encouraging longer visits.',
      },
      {
        title: 'Continuous improvement',
        description:
          'Ensure your website stays aligned with the latest trends and technologies through regular updates and enhancements.',
      },
      {
        title: 'Time and resource efficiency',
        description:
          'Skip the time-consuming process of building a website from scratch and launch your online presence sooner with AstroWind.',
      },
      {
        title: 'Community support',
        description: `Join the growing AstroWind community for insights, resources, and assistance, ensuring you're never alone on your web development journey.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Astronauts Image',
    }}
  >
    <Fragment slot="content">Potenciamos tu negocio con herramientas que escalan contigo.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="Transforma tu negocio en 4 pasos simples con Sonmyd."
    items={[
      {
        title: 'Paso 1: <span class="font-medium">Consulta</span>',
        description:
          "Iniciamos con una consulta gratuita para entender tus necesidades. Analizamos tu negocio, objetivos y desafíos para diseñar la solución perfecta.",
        icon: 'tabler:messages',
      },
      {
        title: 'Paso 2: <span class="font-medium">Planificación</span>',
        description:
          "Desarrollamos un plan detallado con cronogramas, hitos y entregables claros. Tu proyecto queda completamente estructurado antes de iniciar.",
        icon: 'tabler:calendar-event',
      },
      {
        title: 'Paso 3: <span class="font-medium">Desarrollo</span>',
        description:
          'Nuestro equipo experto construye tu solución con las mejores prácticas, manteniéndote informado en cada etapa del proceso.',
        icon: 'tabler:code',
      },
      {
        title: 'Paso 4: <span class="font-medium">¡Lanzamiento y Soporte!</span>',
        description:
          'Implementamos tu solución y te acompañamos con soporte continuo, capacitación y actualizaciones.',
        icon: 'tabler:rocket',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Steps image',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Nuestros Servicios Principales"
    subtitle="Soluciones tecnológicas especializadas que transforman tu negocio y potencian tu crecimiento empresarial"
    tagline="Servicios"
    items={[
      {
        title: 'Inteligencia Artificial',
        description: "Implementamos chatbots, análisis predictivo y automatización inteligente para optimizar tus operaciones.",
        icon: 'flat-color-icons:template',
      },
      {
        title: 'Desarrollo Web',
        description:
          "Creamos aplicaciones web modernas, rápidas y escalables que destacan en el mercado digital.",
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'Apps Multiplataforma',
        description:
          'Desarrollamos aplicaciones móviles nativas y híbridas que funcionan perfectamente en iOS y Android.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'Automatización',
        description:
          "Optimizamos procesos empresariales con sistemas automatizados que ahorran tiempo y reducen errores.",
        icon: 'flat-color-icons:document',
      },
      {
        title: 'Capacitaciones',
        description:
          'Formamos a tu equipo en las últimas tecnologías con cursos especializados y certificaciones.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'Consultoría Técnica',
        description: 'Asesoramos en arquitectura de software, migraciones cloud y transformación digital.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'Soporte Técnico',
        description: 'Brindamos soporte 24/7 y mantenimiento continuo para garantizar el óptimo funcionamiento.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'Integraciones',
        description:
          'Conectamos tus sistemas existentes con nuevas tecnologías para crear un ecosistema digital unificado.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'Analytics & BI',
        description: "Implementamos soluciones de Business Intelligence para convertir tus datos en insights accionables.",
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Insights y Tendencias Tecnológicas"
    information={`The blog is used to display AstroWind documentation.
                        Each new article will be an important step that you will need to know to be an expert in creating a website using Astro + Tailwind CSS.
                        Astro is a very interesting technology. Thanks.
                `}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Preguntas Frecuentes"
    subtitle="Sumérgete en las siguientes preguntas para obtener información sobre las poderosas características que ofrece AstroWind y cómo puede elevar tu viaje de desarrollo web."
    tagline="Preguntas Frecuentes"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '¿Por qué elegir Sonmyd?',
        description:
          "Somos líderes en innovación tecnológica con un equipo de expertos certificados. Nuestra metodología ágil y enfoque en resultados garantiza el éxito de tu proyecto desde el primer día.",
      },
      {
        title: '¿Qué necesito para empezar?',
        description:
          'Space, the final frontier. These are the voyages of the Starship Enterprise. Its five-year mission: to explore strange new worlds. Many say exploration is part of our destiny, but it’s actually our duty to future generations.',
      },
      {
        title: '¿Cómo instalar la plantilla Astro + Tailwind CSS?',
        description:
          "Well, the way they make shows is, they make one show. That show's called a pilot. Then they show that show to the people who make shows, and on the strength of that one show they decide if they're going to make more shows.",
      },
      {
        title: '¿Qué es algo que no entiendes?',
        description:
          "A flower in my garden, a mystery in my panties. Heart attack never stopped old Big Bear. I didn't even know we were calling him Big Bear.",
      },
      {
        title: '¿Qué es algo que te gustaría volver a intentar?',
        description:
          "A business big enough that it could be listed on the NASDAQ goes belly up. Disappears! It ceases to exist without me. No, you clearly don't know who you're talking to, so let me clue you in.",
      },
      {
        title: 'Si solo pudieras hacer una pregunta a cada persona que conoces, ¿cuál sería esa pregunta?',
        description:
          "This is not about revenge. This is about justice. A lot of things can change in twelve years, Admiral. Well, that's certainly good to know. About four years. I got tired of hearing how young I looked.",
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Proyectos Exitosos', amount: '500+' },
      { title: 'Clientes Satisfechos', amount: '150+' },
      { title: 'Horas de Capacitación', amount: '10K+' },
      { title: 'Años de Experiencia', amount: '15+' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Consulta Gratuita',
        href: '/contact',
        target: '_self',
        icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">
      Sonmyd&nbsp;+&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">Tu Éxito</span>
    </Fragment>

    <Fragment slot="subtitle">
      Únete a las empresas líderes que ya transformaron su negocio con nuestras soluciones. <br class="hidden md:inline" />No
      dejes que la competencia te adelante. ¡Actúa ahora!
    </Fragment>
  </CallToAction>
</Layout>
