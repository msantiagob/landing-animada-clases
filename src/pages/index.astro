---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import LeadCapture from '~/components/widgets/LeadCapture.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { faqSchema, itemListSchema } from '~/utils/seo';

const metadata = {
  title: 'Clases de IA, Asistente de WhatsApp y Gestor de Llamadas | Sonmyd',
  description:
    'Clases de inteligencia artificial con profesor especializado, asistentes de WhatsApp con IA, llamadas de marketing automatizadas y gestor de llamadas 24/7 para empresas. En español.',
  ignoreTitleTemplate: true,
  canonical: '/',
};

const faqs = [
  {
    question: '¿Con quién trabajo exactamente?',
    answer:
      'Con Santiago Bedoya, que es quien da las clases y escribe el código. No hay una capa de vendedores entre vos y el trabajo. Para proyectos grandes se suma gente puntual, y se te dice quién y para qué.',
  },
  {
    question: '¿Cuánto cuesta?',
    answer:
      'Depende del alcance, y desconfiá de quien te tire un número sin haber entendido el problema. Lo que sí hacemos es acotar: definimos la versión más chica que ya te sirve, la presupuestamos con precisión y después discutimos el resto.',
  },
  {
    question: '¿Cuánto tardan?',
    answer:
      'Una automatización simple entre dos sistemas con API: de días a dos semanas. Un asistente de WhatsApp: de dos a cuatro semanas. Un sistema a medida con varias partes: de dos a cuatro meses hasta la primera versión usable. Los plazos van por escrito en la propuesta.',
  },
  {
    question: '¿Qué pasa si no son los indicados para mi caso?',
    answer:
      'Te lo decimos en la primera charla y, si podemos, te orientamos hacia dónde mirar. Tomar un proyecto que no encaja termina mal para los dos: vos pagás algo que no resuelve y nosotros entregamos algo de lo que no estamos orgullosos.',
  },
  {
    question: '¿El código y los accesos quedan míos?',
    answer:
      'Sí, sin asteriscos, y desde el primer día: repositorio, documentación y credenciales. Si mañana querés seguir con otro equipo, podés. Retener clientes por dependencia técnica es una forma pésima de hacer negocios.',
  },
  {
    question: '¿Necesito saber de tecnología para trabajar con ustedes?',
    answer:
      'No. Explicamos en castellano lo que hace falta para que puedas decidir, no para lucirnos. Y si querés entenderlo a fondo, para eso están las clases: el objetivo ahí es justamente que dejes de necesitarnos.',
  },
  {
    question: '¿Ofrecen soporte después de entregar?',
    answer:
      'Sí, con un alcance y un horario acordados por escrito. No prometemos soporte 24/7 porque no podríamos cumplirlo, y una promesa de disponibilidad que se rompe el primer domingo es peor que no haberla hecho.',
  },
];
---

<Layout metadata={metadata}>
  <StructuredData
    schema={[
      faqSchema(faqs),
      itemListSchema([
        { name: 'Clases de IA', path: '/clases-de-ia' },
        { name: 'Clases de Python', path: '/clases-de-python' },
        { name: 'Asistente de WhatsApp con IA', path: '/asistente-de-whatsapp' },
        { name: 'WhatsApp Business API', path: '/whatsapp-business-api' },
        { name: 'Llamadas de marketing con IA', path: '/llamadas-de-marketing' },
        { name: 'Gestor de llamadas', path: '/gestor-de-llamadas' },
        { name: 'Automatizaciones', path: '/automatizaciones' },
        { name: 'Desarrollo de software', path: '/desarrollo-de-software' },
        { name: 'Servidores y VPS', path: '/servidores-y-vps' },
        { name: 'Ciberseguridad', path: '/ciberseguridad' },
      ]),
    ]}
  />

  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      { variant: 'primary', text: 'Consulta gratuita', href: '#contacto', icon: 'tabler:calendar-plus' },
      { text: 'Ver todos los servicios', href: '/servicios', variant: 'tertiary' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1488590528505-98d2b5aba04b?auto=format&fit=crop&w=1600&q=80',
      alt: 'Inteligencia artificial y automatización aplicadas a empresas',
    }}
  >
    <Fragment slot="title">
      Te enseñamos <span class="text-accent">inteligencia artificial</span> o la implementamos por vos
    </Fragment>

    <Fragment slot="subtitle">
      Clases de IA y Python, asistentes de WhatsApp sobre la API oficial de Meta, automatizaciones, desarrollo de
      software, servidores y seguridad. En español, con quien hace el trabajo y no con un vendedor.
    </Fragment>

    <Fragment slot="trust">
      <span>Consulta inicial sin costo</span>
      <span>·</span>
      <span>Todo lo que construimos queda tuyo</span>
      <span>·</span>
      <span>Si no somos los indicados, te lo decimos</span>
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note
    title="Cómo trabajamos:"
    description="Conceptos antes que herramientas, entregas que podés usar y ningún proyecto que no te convenga"
  />

  <!-- Servicios principales: enlazado interno hacia las páginas que queremos posicionar -->

  <Features
    id="servicios-ia"
    tagline="Servicios de IA"
    title="Inteligencia artificial que trabaja para tu negocio"
    subtitle="Cuatro soluciones concretas, en español y funcionando desde el primer mes."
    columns={2}
    items={[
      {
        title: 'Clases de IA con profesor dedicado',
        description:
          'Clases particulares y capacitaciones para empresas. Aprendés inteligencia artificial aplicada a tu trabajo real, con un profesor que te corrige y te acompaña.',
        icon: 'tabler:school',
        callToAction: { text: 'Ver las clases de IA', href: '/clases-de-ia' },
      },
      {
        title: 'Asistente de WhatsApp con IA',
        description:
          'Responde, califica interesados y agenda reuniones las 24 horas sobre la API oficial de WhatsApp Business, integrado a tu CRM.',
        icon: 'tabler:brand-whatsapp',
        callToAction: { text: 'Ver el asistente de WhatsApp', href: '/asistente-de-whatsapp' },
      },
      {
        title: 'Llamadas de marketing con IA',
        description:
          'Campañas de llamadas salientes con agentes de voz que conversan en español natural, manejan objeciones y agendan reuniones a escala.',
        icon: 'tabler:phone-call',
        callToAction: { text: 'Ver las llamadas de marketing', href: '/llamadas-de-marketing' },
      },
      {
        title: 'Gestor de llamadas 24/7',
        description:
          'Recepcionista virtual que atiende cada llamada entrante, entiende el motivo, agenda turnos y deriva al área correcta. Ninguna llamada perdida.',
        icon: 'tabler:phone-incoming',
        callToAction: { text: 'Ver el gestor de llamadas', href: '/gestor-de-llamadas' },
      },
    ]}
  />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Por qué elegirnos"
    title="Lo que obtienes con Sonmyd"
    subtitle="Somos líderes en soluciones tecnológicas empresariales. Expertos certificados con más de 500 proyectos exitosos y capacitaciones especializadas en las últimas tecnologías."
    items={[
      {
        title: 'Soluciones de Inteligencia Artificial',
        description:
          'Implementamos IA avanzada para automatizar procesos, optimizar operaciones y generar insights valiosos para tu negocio.',
        icon: 'tabler:brain',
      },
      {
        title: 'Desarrollo Web Multiplataforma',
        description:
          'Creamos aplicaciones web y móviles de alto rendimiento que funcionan perfectamente en cualquier dispositivo y plataforma.',
        icon: 'tabler:device-desktop',
      },
      {
        title: 'Capacitaciones Especializadas',
        description:
          'Formamos a tu equipo en las últimas tecnologías con programas personalizados y certificaciones reconocidas internacionalmente.',
        icon: 'tabler:school',
      },
      {
        title: 'Automatización de Procesos',
        description:
          'Optimizamos tus operaciones con sistemas automatizados que reducen costos, eliminan errores y aumentan la productividad empresarial.',
        icon: 'tabler:robot',
      },
      {
        title: 'Soporte Técnico Especializado',
        description:
          'Ofrecemos acompañamiento continuo con nuestro equipo de expertos, garantizando el éxito y evolución constante de tus proyectos tecnológicos.',
        icon: 'tabler:headset',
      },
      {
        title: 'Innovación Continua',
        description:
          'Mantenemos tu negocio a la vanguardia con las últimas tendencias tecnológicas y metodologías ágiles de desarrollo.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Nuestro enfoque"
    title="Metodología Sonmyd: ¡Donde la Innovación se Encuentra con Resultados!"
    items={[
      {
        title: 'Tecnologías de Vanguardia',
        description:
          'Utilizamos las últimas tecnologías en IA, cloud computing y frameworks modernos para garantizar soluciones escalables y futuras.',
      },
      {
        title: 'Metodologías Ágiles',
        description:
          'Implementamos Scrum y DevOps para entregas rápidas, comunicación transparente y adaptación continua a tus necesidades.',
      },
      {
        title: 'Equipo Multidisciplinario',
        description:
          'Contamos con especialistas en IA, desarrollo full-stack, UX/UI y arquitectura de software trabajando en sinergia para tu proyecto.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Innovación que impulsa resultados
      </h3>
      Obtén una ventaja competitiva con tecnologías de última generación y expertise comprobado
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-surface"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Empezás con un caso, no con un contrato anual',
        description:
          'Arrancamos por el proceso que más te duele y lo ponemos a funcionar. Si no da resultado medible, no seguimos.',
      },
      {
        title: 'Todo queda documentado y auditable',
        description:
          'Conversaciones, llamadas y decisiones quedan registradas. Podés revisar qué respondió la IA y por qué.',
      },
      {
        title: 'Tu equipo aprende a operarlo',
        description:
          'No te dejamos dependiendo de nosotros: capacitamos a tu gente para que ajuste y mantenga lo implementado.',
      },
      {
        title: 'Integrado a lo que ya usás',
        description:
          'CRM, calendario, planillas y centralita actual. No hay que migrar nada ni cambiar el número de teléfono.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=2070&q=80',
      alt: 'Equipo de Sonmyd trabajando en una implementación de inteligencia artificial',
    }}
  >
    <Fragment slot="content">
      <h2 class="mb-2 text-2xl font-bold tracking-tight sm:text-3xl">Cómo trabajamos</h2>
      La inteligencia artificial solo sirve si baja a un proceso concreto. Por eso no vendemos licencias: implementamos una
      solución, la medimos y te enseñamos a operarla.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-surface"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="Transforma tu negocio en 4 pasos simples con Sonmyd."
    items={[
      {
        title: 'Paso 1: <span class="font-medium">Consulta</span>',
        description:
          'Iniciamos con una consulta gratuita para entender tus necesidades. Analizamos tu negocio, objetivos y desafíos para diseñar la solución perfecta.',
        icon: 'tabler:messages',
      },
      {
        title: 'Paso 2: <span class="font-medium">Planificación</span>',
        description:
          'Desarrollamos un plan detallado con cronogramas, hitos y entregables claros. Tu proyecto queda completamente estructurado antes de iniciar.',
        icon: 'tabler:calendar-event',
      },
      {
        title: 'Paso 3: <span class="font-medium">Desarrollo</span>',
        description:
          'Nuestro equipo experto construye tu solución con las mejores prácticas, manteniéndote informado en cada etapa del proceso.',
        icon: 'tabler:code',
      },
      {
        title: 'Paso 4: <span class="font-medium">¡Lanzamiento y Soporte!</span>',
        description: 'Implementamos tu solución y te acompañamos con soporte continuo, capacitación y actualizaciones.',
        icon: 'tabler:rocket',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Steps image',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Nuestros Servicios Principales"
    subtitle="Soluciones tecnológicas especializadas que transforman tu negocio y potencian tu crecimiento empresarial"
    tagline="Servicios"
    items={[
      {
        title: 'Inteligencia Artificial',
        description:
          'Implementamos chatbots, análisis predictivo y automatización inteligente para optimizar tus operaciones.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'Desarrollo Web',
        description: 'Creamos aplicaciones web modernas, rápidas y escalables que destacan en el mercado digital.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'Apps Multiplataforma',
        description:
          'Desarrollamos aplicaciones móviles nativas y híbridas que funcionan perfectamente en iOS y Android.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'Automatización',
        description:
          'Optimizamos procesos empresariales con sistemas automatizados que ahorran tiempo y reducen errores.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'Capacitaciones',
        description: 'Formamos a tu equipo en las últimas tecnologías con cursos especializados y certificaciones.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'Consultoría Técnica',
        description: 'Asesoramos en arquitectura de software, migraciones cloud y transformación digital.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'Soporte Técnico',
        description: 'Brindamos soporte 24/7 y mantenimiento continuo para garantizar el óptimo funcionamiento.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'Integraciones',
        description:
          'Conectamos tus sistemas existentes con nuevas tecnologías para crear un ecosistema digital unificado.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'Analytics & BI',
        description:
          'Implementamos soluciones de Business Intelligence para convertir tus datos en insights accionables.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-surface"></div>
    </Fragment>
  </Features2>

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Preguntas frecuentes"
    subtitle="Las dudas que aparecen antes de escribirnos, respondidas sin vueltas."
    tagline="Dudas comunes"
    classes={{ container: 'max-w-6xl' }}
    items={faqs.map(({ question, answer }) => ({ title: question, description: answer }))}
  />

  <!-- Captura de leads ************** -->

  <LeadCapture
    formId="lead-home"
    title="Empecemos por tu caso"
    subtitle="Contanos qué querés resolver y te decimos si podemos ayudarte, cómo y qué implica. Si no somos los indicados, también te lo decimos."
    button="Quiero que me contacten"
  />
</Layout>
