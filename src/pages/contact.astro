---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import LeadCapture from '~/components/widgets/LeadCapture.astro';
import Features from '~/components/widgets/Features.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { breadcrumbSchema } from '~/utils/seo';

const PATH = '/contact';

const metadata = {
  title: 'Contacto | Sonmyd',
  description:
    'Escribinos y te respondemos en menos de 24 horas hábiles. Primera consulta sin costo sobre clases de IA y Python, WhatsApp, automatizaciones, desarrollo, servidores y seguridad.',
  canonical: PATH,
};
---

<Layout metadata={metadata}>
  <StructuredData
    schema={[
      breadcrumbSchema([
        { name: 'Inicio', path: '/' },
        { name: 'Contacto', path: PATH },
      ]),
    ]}
  />

  <HeroText
    tagline="Contacto"
    title="Contanos qué querés resolver"
    subtitle="No hace falta que traigas la solución pensada. Con el problema bien descrito alcanza para empezar."
  />

  <LeadCapture
    id="form"
    formId="lead-contacto"
    title="Escribinos"
    subtitle="Leemos todo lo que entra y respondemos nosotros, no un formulario automático."
  />

  <Features
    title="Cómo trabajamos"
    subtitle="Para que sepas qué esperar antes de escribir."
    columns={3}
    items={[
      {
        title: 'Primera consulta sin costo',
        description:
          'Media hora para entender tu caso. Si no somos los indicados, te lo decimos ahí y te orientamos hacia dónde mirar.',
        icon: 'tabler:message-circle',
      },
      {
        title: 'Hablás con quien hace el trabajo',
        description:
          'No hay capa de vendedores. La persona que te responde es la que va a construir o enseñar lo que se acuerde.',
        icon: 'tabler:user-check',
      },
      {
        title: 'Propuesta concreta',
        description:
          'Alcance, plazo y precio por escrito. Si el alcance todavía es difuso, lo acotamos antes de poner un número.',
        icon: 'tabler:file-description',
      },
      {
        title: 'Respondemos en 24 horas hábiles',
        description:
          'Es el plazo real, no una promesa de marketing. Si vamos a demorar más, te avisamos que vamos a demorar más.',
        icon: 'tabler:clock',
      },
      {
        title: 'Correo electrónico',
        description: 'hola@sonmyd.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Ubicación',
        description: 'Bogotá, Colombia. Trabajamos de forma remota con toda Latinoamérica y España.',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
