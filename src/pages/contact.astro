---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contacto - Consulta Gratuita con Expertos en Tecnológica Sonmyd',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contacto" title="¡Transformemos tu negocio juntos!" />

  <ContactUs
    id="form"
    title="¡Solicita tu consulta gratuita ahora!"
    subtitle="Nuestros especialistas te contactarán en menos de 24 horas para analizar tu proyecto y diseñar una solución personalizada. Consulta inicial completamente gratuita y sin compromiso."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Nombre *',
        placeholder: 'Tu nombre completo'
      },
      {
        type: 'email',
        name: 'email',
        label: 'Correo Electrónico *',
        placeholder: 'tu@email.com'
      },
      {
        type: 'tel',
        name: 'phone',
        label: 'Teléfono (opcional)',
        placeholder: '+57 300 123 4567'
      },
      {
        type: 'text',
        name: 'company',
        label: 'Empresa (opcional)',
        placeholder: 'Nombre de tu empresa'
      },
    ]}
    textarea={{
      label: 'Mensaje *',
      placeholder: 'Cuéntanos sobre tu proyecto o necesidades específicas...',
      rows: 5
    }}
    disclaimer={{
      label:
        'Al enviar este formulario de contacto, reconoces y aceptas la recopilación de tu información personal.',
    }}
    description="Respuesta garantizada en menos de 4 horas hábiles. Consultas urgentes atendidas en tiempo real vía WhatsApp."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="¡Estamos aquí para ayudar!"
    items={[
      {
        title: 'Soporte general',
        description: `Consultas sobre proyectos de IA, desarrollo web, automatización de procesos, capacitaciones especializadas y asesoría en transformación digital.`,
      },
      {
        title: 'Consultoría Especializada',
        description:
          'Habla directamente con nuestros arquitectos de software para cotizaciones personalizadas, planificación de proyectos y análisis de factibilidad técnica.',
      },
      {
        title: 'Soporte técnico',
        description:
          'Soporte 24/7 para aplicaciones en producción, migraciones de datos, optimización de rendimiento, actualizaciones de seguridad y resolución de incidencias críticas.',
      },
      {
        title: 'Teléfono',
        description: '+57 (1) 234-5678',
        icon: 'tabler:headset',
      },
      {
        title: 'Correo Electrónico',
        description: 'hola@sonmyd.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Ubicación',
        description: 'Bogotá, Colombia - Centro de Innovación Tecnológica',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
