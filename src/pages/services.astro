---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Servicios de Sonmyd - Soluciones Tecnológicas Especializadas',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Servicios"
    title="Potencia tu negocio con nuestras soluciones tecnológicas avanzadas"
    subtitle="Descubre nuestro portafolio completo de servicios especializados en IA, desarrollo web, apps móviles y automatización. Soluciones personalizadas que transforman ideas en resultados tangibles para tu empresa."
    actions={[{ variant: 'primary', target: '_self', text: 'Solicitar Cotización', href: '/contact' }]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'AstroWind Hero Image',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Nuestros Servicios Especializados"
    subtitle="Ofrecemos un ecosistema completo de servicios tecnológicos diseñados para impulsar la transformación digital de tu empresa."
    columns={3}
    items={[
      {
        title: 'Inteligencia Artificial',
        description:
          'Desarrollamos chatbots inteligentes, sistemas de machine learning, análisis predictivo y automatización con IA que optimizan procesos y mejoran la toma de decisiones empresariales.',
        icon: 'tabler:brain',
      },
      {
        title: 'Desarrollo Web Full-Stack',
        description:
          'Creamos aplicaciones web escalables con React, Angular, Vue.js y backends robustos. Desde e-commerce hasta plataformas empresariales, garantizamos rendimiento y seguridad.',
        icon: 'tabler:code',
      },
      {
        title: 'Apps Multiplataforma',
        description: `Desarrollamos aplicaciones nativas y híbridas para iOS y Android usando React Native, Flutter y Xamarin. Experiencia de usuario óptima en todos los dispositivos.`,
        icon: 'tabler:device-mobile',
      },
      {
        title: 'Automatización de Procesos',
        description:
          'Implementamos RPA, workflows inteligentes y sistemas de automatización que reducen costos operativos, eliminan errores humanos y aumentan la productividad empresarial.',
        icon: 'tabler:robot',
      },
      {
        title: 'Blog',
        description:
          'With attention to typography, these templates empower effective content presentation for writers at any stage, ensuring visually engaging and user-friendly blogs.',
        icon: 'tabler:article',
      },
      {
        title: 'Capacitaciones Tecnológicas',
        description:
          'Programas de formación especializada en IA, desarrollo web, DevOps y metodologías ágiles. Certificaciones internacionales y talleres prácticos personalizados.',
        icon: 'tabler:school',
      },
      {
        title: 'Consultoría Digital',
        description:
          'Asesoramos en transformación digital, arquitectura de software, migración cloud y estrategias de innovación tecnológica para maximizar el ROI.',
        icon: 'tabler:chart-line',
      },
      {
        title: 'Soporte Técnico 24/7',
        description: `Brindamos mantenimiento preventivo, actualizaciones de seguridad, monitoreo en tiempo real y soporte especializado para garantizar la operación continua.`,
        icon: 'tabler:headset',
      },
      {
        title: 'Integraciones y APIs',
        description:
          'Conectamos tus sistemas existentes con nuevas tecnologías, desarrollamos APIs REST y GraphQL, e implementamos microservicios para ecosistemas unificados.',
        icon: 'tabler:plug-connected',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'Metodología Probada',
        description:
          'Aplicamos metodologías ágiles y DevOps con más de 15 años de experiencia, garantizando entregas puntuales y calidad excepcional.',
        icon: 'tabler:chart-line',
      },
      {
        title: 'Soluciones Personalizadas',
        description:
          'Cada proyecto se adapta específicamente a tus necesidades empresariales, usando las tecnologías más adecuadas para tu industria.',
        icon: 'tabler:settings',
      },
      {
        title: 'Equipo Multidisciplinario',
        description:
          'Contamos con especialistas certificados en IA, desarrollo full-stack, UX/UI y arquitectura de software trabajando en tu proyecto.',
        icon: 'tabler:users',
      },
      {
        title: 'Acompañamiento Continuo',
        description:
          'Te mantenemos informado en cada etapa del proyecto con demos, reportes de progreso y comunicación directa con el equipo.',
        icon: 'tabler:message-circle',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1525909002-1b05e0c869d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80',
      alt: 'Features Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Características Principales</h3>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'ROI Comprobado',
        description:
          'Nuestros clientes experimentan un retorno de inversión promedio del 300% en el primer año, optimizando procesos y aumentando la productividad.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'Escalabilidad Garantizada',
        description:
          'Diseñamos soluciones que crecen contigo. Arquitecturas robustas que soportan desde 100 hasta millones de usuarios sin comprometer el rendimiento.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Seguridad Enterprise',
        description:
          'Implementamos los más altos estándares de seguridad: encriptación end-to-end, autenticación multifactor y cumplimiento de normativas internacionales.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Tiempo de Mercado Rápido',
        description:
          'Metodologías ágiles que reducen el time-to-market hasta en un 50%, con entregas incrementales que generan valor desde la primera semana.',
        icon: 'tabler:clock',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664688-cf412ec27db2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      alt: 'Benefits Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Beneficios</h3>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Palabras de clientes reales"
    testimonials={[
      {
        testimonial: `The designs are not only visually appealing but also highly professional. The templates have saved me a significant amount of time while helping me make a lasting impression on my clients.`,
        name: 'Emily Kennedy',
        job: 'Desarrolladora Front-end',
        image: {
          src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
          alt: 'Emily Kennedy Image',
        },
      },
      {
        testimonial: `It beautifully showcases my work, with its clean and elegant design that lets my photographs shine. Customization was a breeze, even for a non-tech person like me. The result is a professional and immersive portfolio that's garnered numerous compliments.`,
        name: 'Sarah Hansen',
        job: 'Fotógrafa',
        image: {
          src: 'https://images.unsplash.com/photo-1561406636-b80293969660?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Sarah Hansen Image',
        },
      },
      {
        testimonial: `I discovered these templates and I'm impressed by their variety and quality. They've helped me establish a consistent brand image across my marketing and social platforms, elevating my business's overall appearance.`,
        name: 'Mark Wilkinson',
        job: 'Propietario de pequeña empresa',
        image: {
          src: 'https://images.unsplash.com/photo-1545167622-3a6ac756afa4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=824&q=80',
          alt: 'Mark Wilkinson Image',
        },
      },
    ]}
    callToAction={{
      target: '_blank',
      text: 'Más testimonios...',
      href: 'https://github.com/onwidget/astrowind',
      icon: 'tabler:chevron-right',
    }}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Comenzar a explorar',
        href: '/',
      },
    ]}
    title="Sumérgete en nuestra colección de plantillas"
    subtitle="Ya sea que estés en negocios, diseño o educación, nuestras plantillas están aquí para elevar tus proyectos."
  />
</Layout>
