---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  description?: string;
  theme?: string;
}

const {
  socialLinks = [],
  secondaryLinks = [],
  links = [],
  footNote = '',
  description = '',
  theme = 'light',
} = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-line not-prose bg-surface']}>
  <div
    class="relative mx-auto max-w-7xl px-4 sm:px-6 intersect-once intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
  >
    <div class="grid grid-cols-12 gap-8 py-14 md:py-16">
      <div class="col-span-12 lg:col-span-4">
        <a class="inline-block text-xl font-bold text-heading" href={getHomePermalink()}>{SITE?.name}</a>
        {description && <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted" set:html={description} />}
      </div>

      {
        links.map(({ title, links: columnLinks }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="mb-3 text-sm font-semibold text-heading">{title}</div>
            {columnLinks && Array.isArray(columnLinks) && columnLinks.length > 0 && (
              <ul class="space-y-2.5 text-sm">
                {columnLinks.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a
                      class="text-muted transition-colors duration-150 hover:text-heading"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>

    <div class="flex flex-col gap-4 border-t border-line py-6 md:flex-row md:items-center md:justify-between">
      <div class="text-sm text-muted">
        <Fragment set:html={footNote} />
      </div>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <div class="flex gap-x-4 text-sm">
          {
            secondaryLinks.map(({ text, href }) => (
              <a class="text-muted transition-colors duration-150 hover:text-heading" href={href} set:html={text} />
            ))
          }
        </div>

        {
          socialLinks?.length ? (
            <ul class="flex items-center gap-1">
              {socialLinks.map(({ ariaLabel, href, text, icon }) => (
                <li>
                  <a
                    class="inline-flex items-center rounded-lg p-2 text-muted transition-colors hover:bg-subtle hover:text-heading focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                    aria-label={ariaLabel}
                    href={href}
                  >
                    {icon && <Icon name={icon} class="h-5 w-5" />}
                    <Fragment set:html={text} />
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            ''
          )
        }
      </div>
    </div>
  </div>
</footer>
