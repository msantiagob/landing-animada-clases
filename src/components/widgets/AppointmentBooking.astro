---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';

const {
  title = 'Agenda tu Consulta Gratuita',
  subtitle = 'Selecciona el día y hora que mejor te convenga para tu consulta personalizada',
  tagline = 'Reserva tu Cita',
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
    <!-- Calendar Section -->
    <div class="card p-6 md:p-8">
      <h3 class="mb-5 text-lg font-semibold text-heading">Selecciona una fecha</h3>

      <!-- Calendar Navigation -->
      <div class="flex justify-between items-center mb-4">
        <button id="prevMonth" class="rounded-lg p-2 text-muted transition-colors hover:bg-subtle hover:text-heading">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <h4 id="currentMonth" class="text-base font-semibold text-heading"></h4>
        <button id="nextMonth" class="rounded-lg p-2 text-muted transition-colors hover:bg-subtle hover:text-heading">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>

      <!-- Calendar Grid -->
      <div class="grid grid-cols-7 gap-1 text-center text-sm">
        <div class="p-2 text-xs font-semibold uppercase tracking-wide text-muted">Dom</div>
        <div class="p-2 text-xs font-semibold uppercase tracking-wide text-muted">Lun</div>
        <div class="p-2 text-xs font-semibold uppercase tracking-wide text-muted">Mar</div>
        <div class="p-2 text-xs font-semibold uppercase tracking-wide text-muted">Mié</div>
        <div class="p-2 text-xs font-semibold uppercase tracking-wide text-muted">Jue</div>
        <div class="p-2 text-xs font-semibold uppercase tracking-wide text-muted">Vie</div>
        <div class="p-2 text-xs font-semibold uppercase tracking-wide text-muted">Sáb</div>
      </div>
      <div id="calendarDays" class="grid grid-cols-7 gap-1 mt-2">
        <!-- Calendar days will be generated here -->
      </div>

      <!-- Time Slots -->
      <div id="timeSlots" class="mt-6 hidden">
        <h4 class="mb-3 text-base font-semibold text-heading">Horarios disponibles</h4>
        <div id="availableSlots" class="grid grid-cols-2 gap-2">
          <!-- Time slots will be loaded here -->
        </div>
      </div>
    </div>

    <!-- Booking Form -->
    <div class="card p-6 md:p-8">
      <h3 class="mb-5 text-lg font-semibold text-heading">Información de contacto</h3>

      <!-- Success Message -->
      <div
        id="successMessage"
        class="hidden mb-6 rounded-lg border border-emerald-300 bg-emerald-50 p-4 text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-200"
      >
        <div class="flex">
          <svg class="w-5 h-5 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <div>
            <strong>¡Cita agendada correctamente!</strong>
            <p class="text-sm mt-1">Recibirás un email de confirmación con todos los detalles.</p>
          </div>
        </div>
      </div>

      <!-- Error Message -->
      <div
        id="errorMessage"
        class="hidden mb-6 rounded-lg border border-red-300 bg-red-50 p-4 text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200"
      >
        <div class="flex">
          <svg class="w-5 h-5 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
              clip-rule="evenodd"></path>
          </svg>
          <span id="errorText">Error al agendar la cita. Inténtalo más tarde.</span>
        </div>
      </div>

      <form id="appointmentForm" method="post" action="/api/appointments">
        <!-- Honeypot: oculto para personas, visible para bots. -->
        <div class="absolute left-[-9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
          <label for="website">No completar este campo</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="space-y-4">
          <div>
            <label for="name" class="field-label"> Nombre completo * </label>
            <input type="text" id="name" name="name" required class="field" placeholder="Tu nombre completo" />
          </div>

          <div>
            <label for="email" class="field-label"> Email * </label>
            <input type="email" id="email" name="email" required class="field" placeholder="tu@email.com" />
          </div>

          <div>
            <label for="phone" class="field-label"> Teléfono </label>
            <input type="tel" id="phone" name="phone" class="field" placeholder="+57 300 123 4567" />
          </div>

          <div>
            <label for="company" class="field-label"> Empresa </label>
            <input type="text" id="company" name="company" class="field" placeholder="Nombre de tu empresa" />
          </div>

          <div>
            <label for="serviceType" class="field-label"> Tipo de servicio * </label>
            <select id="serviceType" name="serviceType" required class="field">
              <option value="">Selecciona un servicio</option>
              <option value="Inteligencia Artificial">Inteligencia Artificial</option>
              <option value="Desarrollo Web">Desarrollo Web</option>
              <option value="Apps Multiplataforma">Apps Multiplataforma</option>
              <option value="Automatización">Automatización de Procesos</option>
              <option value="Capacitaciones">Capacitaciones Técnicas</option>
              <option value="Consultoría">Consultoría Digital</option>
              <option value="Otro">Otro</option>
            </select>
          </div>

          <div>
            <label for="message" class="field-label"> Mensaje adicional </label>
            <textarea
              id="message"
              name="message"
              rows="3"
              class="field"
              placeholder="Cuéntanos sobre tu proyecto o necesidades específicas..."></textarea>
          </div>

          <!-- Selected Date and Time Display -->
          <div id="selectedDateTime" class="hidden p-3 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
            <p class="text-sm font-medium text-blue-800 dark:text-blue-200">
              Fecha seleccionada: <span id="selectedDateText"></span>
            </p>
            <p class="text-sm font-medium text-blue-800 dark:text-blue-200">
              Hora seleccionada: <span id="selectedTimeText"></span>
            </p>
          </div>

          <button
            type="submit"
            id="submitBtn"
            disabled
            class="btn-primary w-full disabled:cursor-not-allowed disabled:opacity-50"
          >
            Confirmar Cita
          </button>
        </div>
      </form>
    </div>
  </div>
</WidgetWrapper>

<script>
  const currentDate = new Date();
  let selectedDate: Date | null = null;
  let selectedTime: string | null = null;
  let isSubmitting = false;

  // Formatea en la zona horaria del usuario. NO usar toISOString(): convierte a
  // UTC y, con offset negativo, devuelve el día anterior al elegido.
  const toLocalIsoDate = (date: Date) =>
    `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;

  const el = (id: string) => document.getElementById(id) as HTMLElement | null;

  // Initialize calendar
  function initCalendar() {
    updateCalendarHeader();
    generateCalendarDays();
  }

  function updateCalendarHeader() {
    const monthNames = [
      'Enero',
      'Febrero',
      'Marzo',
      'Abril',
      'Mayo',
      'Junio',
      'Julio',
      'Agosto',
      'Septiembre',
      'Octubre',
      'Noviembre',
      'Diciembre',
    ];

    const header = el('currentMonth');
    if (header) header.textContent = `${monthNames[currentDate.getMonth()]} ${currentDate.getFullYear()}`;
  }

  function generateCalendarDays() {
    const calendarDays = el('calendarDays');
    if (!calendarDays) return;

    calendarDays.innerHTML = '';

    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();
    const today = new Date();

    // First day of the month and number of days
    const firstDay = new Date(year, month, 1);
    const lastDay = new Date(year, month + 1, 0);
    const daysInMonth = lastDay.getDate();
    const startingDayOfWeek = firstDay.getDay();

    // Add empty cells for days before the first day of the month
    for (let i = 0; i < startingDayOfWeek; i++) {
      const emptyDay = document.createElement('div');
      emptyDay.className = 'p-2';
      calendarDays.appendChild(emptyDay);
    }

    // Add days of the month
    for (let day = 1; day <= daysInMonth; day++) {
      const dayDate = new Date(year, month, day);
      const dayElement = document.createElement('button');
      dayElement.className = 'p-2 rounded-lg text-sm font-medium transition-colors';
      dayElement.textContent = String(day);

      // Disable past dates and weekends
      const isWeekend = dayDate.getDay() === 0 || dayDate.getDay() === 6;
      const isPast = dayDate < today;

      if (isPast || isWeekend) {
        dayElement.className += ' text-muted/50 cursor-not-allowed';
        dayElement.disabled = true;
      } else {
        dayElement.className += ' text-default hover:bg-subtle';
        // Se pasa el propio botón. Antes el handler leía `window.event`, una API
        // global deprecada que solo funciona por accidente dentro de un handler
        // síncrono y que rompe en cuanto hay un await de por medio.
        dayElement.addEventListener('click', () => selectDate(dayDate, dayElement));
      }

      calendarDays.appendChild(dayElement);
    }
  }

  async function selectDate(date: Date, dayElement: HTMLButtonElement) {
    selectedDate = date;
    selectedTime = null;

    // Update visual selection
    document.querySelectorAll<HTMLButtonElement>('#calendarDays button').forEach((btn) => {
      btn.classList.remove('bg-blue-600', 'text-white');
      if (!btn.disabled) {
        btn.classList.add('text-default', 'hover:bg-subtle');
      }
    });

    dayElement.classList.remove('text-default', 'hover:bg-subtle');
    dayElement.classList.add('bg-blue-600', 'text-white');

    // Load available time slots
    await loadTimeSlots(date);

    // Show time slots section
    el('timeSlots')?.classList.remove('hidden');

    updateSelectedDateTime();
  }

  async function loadTimeSlots(date: Date) {
    const dateString = toLocalIsoDate(date);

    try {
      const response = await fetch(`/api/appointments?date=${dateString}`);
      const data = await response.json();

      if (data.success) {
        displayTimeSlots(data.availableSlots);
      } else {
        console.error('Error loading time slots:', data.error);
      }
    } catch (error) {
      console.error('Error:', error);
    }
  }

  function displayTimeSlots(slots: string[]) {
    const container = el('availableSlots');
    if (!container) return;

    container.innerHTML = '';

    if (slots.length === 0) {
      container.innerHTML = '<p class="col-span-2 text-sm text-muted">No hay horarios disponibles para esta fecha</p>';
      return;
    }

    slots.forEach((time: string) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className =
        'rounded-lg border border-line p-2 text-sm font-medium text-default transition-colors hover:bg-subtle';
      button.textContent = time;
      button.addEventListener('click', () => selectTime(time, button));

      container.appendChild(button);
    });
  }

  function selectTime(time: string, buttonElement: HTMLButtonElement) {
    selectedTime = time;

    // Update visual selection
    document.querySelectorAll('#availableSlots button').forEach((btn) => {
      btn.classList.remove('bg-blue-600', 'text-white', 'border-blue-600');
      btn.classList.add('border-line', 'hover:bg-subtle');
    });

    buttonElement.classList.remove('border-line', 'hover:bg-subtle');
    buttonElement.classList.add('bg-blue-600', 'text-white', 'border-blue-600');

    updateSelectedDateTime();

    // Enable submit button
    const submitBtn = el('submitBtn') as HTMLButtonElement | null;
    if (submitBtn) submitBtn.disabled = false;
  }

  function updateSelectedDateTime() {
    const selectedDateTimeDiv = el('selectedDateTime');
    const selectedDateText = el('selectedDateText');
    const selectedTimeText = el('selectedTimeText');

    if (selectedDate && selectedDateTimeDiv && selectedDateText && selectedTimeText) {
      selectedDateText.textContent = selectedDate.toLocaleDateString('es-ES', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });

      if (selectedTime) {
        selectedTimeText.textContent = selectedTime;
        selectedDateTimeDiv.classList.remove('hidden');
      } else {
        selectedDateTimeDiv.classList.add('hidden');
      }
    }
  }

  const showBookingError = (message: string) => {
    const errorText = el('errorText');
    if (errorText) errorText.textContent = message;
    el('errorMessage')?.classList.remove('hidden');
  };

  // Form submission
  const appointmentForm = el('appointmentForm') as HTMLFormElement | null;

  appointmentForm?.addEventListener('submit', async function (e) {
    e.preventDefault();

    // Prevenir envíos duplicados
    if (isSubmitting) {
      return;
    }

    if (!selectedDate || !selectedTime) {
      showBookingError('Por favor selecciona una fecha y hora.');
      return;
    }

    const submitBtn = el('submitBtn') as HTMLButtonElement | null;
    if (!submitBtn) return;

    isSubmitting = true;

    const formData = new FormData(this);
    const appointmentData = {
      name: formData.get('name'),
      email: formData.get('email'),
      phone: formData.get('phone'),
      company: formData.get('company'),
      serviceType: formData.get('serviceType'),
      date: toLocalIsoDate(selectedDate),
      time: selectedTime,
      message: formData.get('message'),
      duration: 60,
      website: formData.get('website') || '',
    };

    // Hide previous messages
    el('successMessage')?.classList.add('hidden');
    el('errorMessage')?.classList.add('hidden');

    // Loading state
    const originalText = submitBtn.textContent;
    submitBtn.textContent = 'Agendando...';
    submitBtn.disabled = true;

    try {
      // Asegurar que siempre se use POST
      const response = await fetch('/api/appointments', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(appointmentData),
      });

      // El motivo real (turno ocupado, validación, rate limit) viene en el
      // cuerpo aun con 400/409/429. Cortar por !response.ok lo ocultaba.
      const result = await response.json();

      if (result.success) {
        el('successMessage')?.classList.remove('hidden');
        this.reset();
        selectedDate = null;
        selectedTime = null;
        el('selectedDateTime')?.classList.add('hidden');
        el('timeSlots')?.classList.add('hidden');

        // Reset calendar selection
        document.querySelectorAll<HTMLButtonElement>('#calendarDays button').forEach((btn) => {
          btn.classList.remove('bg-blue-600', 'text-white');
          if (!btn.disabled) {
            btn.classList.add('text-default', 'hover:bg-subtle');
          }
        });
      } else {
        showBookingError(result.error);
      }
    } catch (error) {
      console.error('Error:', error);
      showBookingError('Error de conexión. Inténtalo más tarde.');
    } finally {
      submitBtn.textContent = originalText;
      if (selectedDate && selectedTime) {
        submitBtn.disabled = false;
      }
      isSubmitting = false;
    }
  });

  // Navigation events. Cambiar de mes descarta la selección previa: la fecha
  // elegida ya no está visible en la grilla.
  const goToMonth = (offset: number) => {
    currentDate.setMonth(currentDate.getMonth() + offset);
    generateCalendarDays();
    updateCalendarHeader();

    el('timeSlots')?.classList.add('hidden');
    selectedDate = null;
    selectedTime = null;
    el('selectedDateTime')?.classList.add('hidden');

    const submitBtn = el('submitBtn') as HTMLButtonElement | null;
    if (submitBtn) submitBtn.disabled = true;
  };

  el('prevMonth')?.addEventListener('click', () => goToMonth(-1));
  el('nextMonth')?.addEventListener('click', () => goToMonth(1));

  // Initialize calendar on page load
  document.addEventListener('DOMContentLoaded', initCalendar);
</script>
