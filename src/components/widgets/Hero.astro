---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),
  // Franja de confianza opcional bajo las llamadas a la acción: garantías,
  // cifras o condiciones. En un sitio comercial es lo que sostiene el clic.
  trust = await Astro.slots.render('trust'),

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// La imagen del hero es el elemento LCP de cada landing: se carga sin diferir
// (`loading="eager"`) y con prioridad alta (`fetchpriority="high"`). Ambos
// atributos van ANTES de `{...image}` a propósito: una página puede
// sobrescribirlos si su imagen no es el LCP.
---

<section class="relative md:-mt-[76px] not-prose" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="pt-12 pb-14 md:pt-16 md:pb-20">
      <div class="text-center pb-10 md:pb-12 max-w-4xl mx-auto">
        {tagline && <p class="eyebrow mb-4" set:html={tagline} />}
        {title && <h1 class="text-4xl sm:text-5xl font-bold leading-[1.1] mb-6 font-heading" set:html={title} />}
        <div class="max-w-2xl mx-auto">
          {subtitle && <p class="text-lg sm:text-xl text-muted leading-relaxed mb-8" set:html={subtitle} />}
          {
            actions && (
              <div class="flex flex-col sm:flex-row sm:justify-center gap-3">
                {Array.isArray(actions) ? (
                  actions.map((action) => (
                    <div class="flex w-full sm:w-auto">
                      <Button {...(action || {})} class="w-full sm:w-auto" />
                    </div>
                  ))
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }
          {
            trust && (
              <div class="mt-7 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-muted">
                <Fragment set:html={trust} />
              </div>
            )
          }
        </div>
        {content && <Fragment set:html={content} />}
      </div>
      <div>
        {
          image && (
            <div class="relative m-auto max-w-5xl">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class="mx-auto w-full rounded-2xl border border-line shadow-card-lg"
                  widths={[400, 768, 1024, 2040]}
                  sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                  loading="eager"
                  fetchpriority="high"
                  width={1024}
                  height={576}
                  {...image}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
