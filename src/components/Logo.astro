---
import { SITE } from 'astrowind:config';

/**
 * El logo se IMPORTA en vez de escribirse como ruta literal.
 *
 * Antes apuntaba a "/src/assets/favicons/web-app-manifest-192x192.png": esa
 * ruta solo existe en desarrollo. En producción el build emite el archivo
 * hasheado bajo /_astro/, así que el logo daba 404 en todas las páginas.
 * Importarlo hace que Astro resuelva la URL final y falle el build si el
 * archivo se mueve, en vez de romperse en silencio.
 */
import logo from '~/assets/favicons/web-app-manifest-192x192.png';
---

<span class="flex items-center self-center ml-2 rtl:ml-0 rtl:mr-2">
  <img
    src={logo.src}
    alt={`Logo de ${SITE?.name}`}
    width="32"
    height="32"
    class="w-8 h-8 mr-2"
    loading="eager"
    decoding="async"
  />
  <span class="text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white">
    {SITE?.name}
  </span>
</span>
