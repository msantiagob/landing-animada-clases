---
export interface Props {
  user: { name: string };
  currentPath?: string;
}

const { user, currentPath = '' } = Astro.props;

const navigationItems = [
  {
    href: '/admin/dashboard',
    label: 'Dashboard',
    icon: 'M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z m8 5 4-4 4 4'
  },
  {
    href: '/admin/forms',
    label: 'Formularios',
    icon: 'M3 8l7.89 4.34a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
  },
  {
    href: '/admin/appointments',
    label: 'Citas',
    icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v14a2 2 0 002 2z'
  },
  {
    href: '/admin/blog',
    label: 'Blog',
    icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z'
  },
  {
    href: '/admin/emails',
    label: 'Emails',
    icon: 'M12 19l9 2-9-18-9 18 9-2zm0 0v-8'
  },
  {
    href: '/admin/landing-pages',
    label: 'Landing Pages',
    icon: 'M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z'
  }
];
---

<div class="w-64 bg-white shadow-lg">
  <div class="p-6 border-b">
    <h2 class="text-xl font-bold text-gray-800">Admin Sonmyd</h2>
    <p class="text-sm text-gray-600">Bienvenido, {user.name}</p>
  </div>
  
  <nav class="mt-6">
    {navigationItems.map((item) => (
      <a 
        href={item.href} 
        class={`sidebar-link flex items-center px-6 py-3 text-gray-700 hover:bg-gray-100 ${
          currentPath === item.href ? 'active' : ''
        }`}
      >
        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}></path>
        </svg>
        {item.label}
      </a>
    ))}
  </nav>
  
  <!-- Logout -->
  <div class="absolute bottom-0 w-64 p-6 border-t">
    <button id="logoutBtn" class="flex items-center text-gray-700 hover:text-red-600">
      <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
      </svg>
      Cerrar Sesión
    </button>
  </div>
</div>

<style>
  .sidebar-link.active {
    @apply bg-blue-100 text-blue-700 border-r-4 border-blue-700;
  }
</style>