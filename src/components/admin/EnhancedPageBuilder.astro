---
import SuperButton from '../ui/SuperButton.astro';
import Modal from '../ui/Modal.astro';
import EnhancedForm from '../ui/EnhancedForm.astro';

interface Props {
  pageId?: string;
  pageData?: any;
}

const { pageId, pageData } = Astro.props;

// Form fields for component configuration
const componentConfigFields = [
  {
    name: 'title',
    label: 'Title',
    type: 'text' as const,
    placeholder: 'Enter component title',
    required: true,
    width: 'full' as const
  },
  {
    name: 'subtitle',
    label: 'Subtitle',
    type: 'text' as const,
    placeholder: 'Enter subtitle (optional)',
    width: 'full' as const
  },
  {
    name: 'description',
    label: 'Description',
    type: 'textarea' as const,
    placeholder: 'Enter description',
    width: 'full' as const,
    validation: {
      maxLength: 500
    }
  },
  {
    name: 'variant',
    label: 'Style Variant',
    type: 'select' as const,
    options: [
      { value: 'modern', label: 'Modern' },
      { value: 'gradient', label: 'Gradient' },
      { value: 'neon', label: 'Neon' },
      { value: 'glass', label: 'Glass' }
    ],
    width: 'half' as const
  },
  {
    name: 'animate',
    label: 'Enable Animations',
    type: 'checkbox' as const,
    options: [
      { value: 'true', label: 'Enable animations' }
    ],
    width: 'half' as const
  }
];
---

<div class="enhanced-page-builder bg-white dark:bg-gray-900 rounded-2xl shadow-xl border border-gray-200 dark:border-gray-700">
  <!-- Builder Header -->
  <div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
    <div>
      <h3 class="text-xl font-bold text-gray-900 dark:text-white">Enhanced Page Builder</h3>
      <p class="text-sm text-gray-600 dark:text-gray-400">Build stunning landing pages with our new components</p>
    </div>
    <div class="flex space-x-3">
      <SuperButton
        variant="secondary"
        size="md"
        text="Preview"
        icon="tabler:eye"
        class="preview-btn"
      />
      <SuperButton
        variant="primary"
        size="md"
        text="Save Page"
        icon="tabler:device-floppy"
        class="save-btn"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 p-6">
    <!-- Enhanced Components Panel -->
    <div class="lg:col-span-1">
      <div class="sticky top-4 space-y-6">
        <div>
          <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-4 flex items-center">
            <svg class="w-4 h-4 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            Components
          </h4>
        </div>
        
        <!-- Hero Components -->
        <div class="component-category">
          <h5 class="text-xs font-medium text-gray-700 dark:text-gray-300 mb-3 uppercase tracking-wide">Hero Sections</h5>
          <div class="space-y-2">
            <div class="draggable-component group p-4 bg-gradient-to-r from-blue-50 to-purple-50 dark:from-blue-900/20 dark:to-purple-900/20 rounded-xl cursor-move border border-gray-200 dark:border-gray-700 hover:border-blue-500 hover:shadow-lg transition-all duration-300"
                 data-component="enhanced-hero">
              <div class="flex items-center mb-2">
                <div class="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-900 dark:text-white">Enhanced Hero</div>
                  <div class="text-xs text-gray-600 dark:text-gray-400">Advanced hero with features</div>
                </div>
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-500">✨ Images, videos, animations</div>
            </div>
            
            <div class="draggable-component group p-4 bg-gradient-to-r from-green-50 to-teal-50 dark:from-green-900/20 dark:to-teal-900/20 rounded-xl cursor-move border border-gray-200 dark:border-gray-700 hover:border-green-500 hover:shadow-lg transition-all duration-300"
                 data-component="cyber-hero">
              <div class="flex items-center mb-2">
                <div class="w-8 h-8 bg-green-500 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-900 dark:text-white">Cyber Hero</div>
                  <div class="text-xs text-gray-600 dark:text-gray-400">Futuristic tech hero</div>
                </div>
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-500">🚀 Particles, glow effects</div>
            </div>
          </div>
        </div>

        <!-- Content Components -->
        <div class="component-category">
          <h5 class="text-xs font-medium text-gray-700 dark:text-gray-300 mb-3 uppercase tracking-wide">Content</h5>
          <div class="space-y-2">
            <div class="draggable-component group p-4 bg-gradient-to-r from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 rounded-xl cursor-move border border-gray-200 dark:border-gray-700 hover:border-purple-500 hover:shadow-lg transition-all duration-300"
                 data-component="tech-cards">
              <div class="flex items-center mb-2">
                <div class="w-8 h-8 bg-purple-500 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-900 dark:text-white">Tech Cards</div>
                  <div class="text-xs text-gray-600 dark:text-gray-400">Modern feature cards</div>
                </div>
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-500">💎 Multiple variants, animations</div>
            </div>
            
            <div class="draggable-component group p-4 bg-gradient-to-r from-yellow-50 to-orange-50 dark:from-yellow-900/20 dark:to-orange-900/20 rounded-xl cursor-move border border-gray-200 dark:border-gray-700 hover:border-yellow-500 hover:shadow-lg transition-all duration-300"
                 data-component="stats-section">
              <div class="flex items-center mb-2">
                <div class="w-8 h-8 bg-yellow-500 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-900 dark:text-white">Stats Section</div>
                  <div class="text-xs text-gray-600 dark:text-gray-400">Animated statistics</div>
                </div>
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-500">📊 Counter animations, icons</div>
            </div>
          </div>
        </div>

        <!-- Form Components -->
        <div class="component-category">
          <h5 class="text-xs font-medium text-gray-700 dark:text-gray-300 mb-3 uppercase tracking-wide">Forms & CTAs</h5>
          <div class="space-y-2">
            <div class="draggable-component group p-4 bg-gradient-to-r from-indigo-50 to-blue-50 dark:from-indigo-900/20 dark:to-blue-900/20 rounded-xl cursor-move border border-gray-200 dark:border-gray-700 hover:border-indigo-500 hover:shadow-lg transition-all duration-300"
                 data-component="enhanced-form">
              <div class="flex items-center mb-2">
                <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-900 dark:text-white">Enhanced Form</div>
                  <div class="text-xs text-gray-600 dark:text-gray-400">Advanced form with validation</div>
                </div>
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-500">✅ Validation, multi-step, conditional</div>
            </div>
            
            <div class="draggable-component group p-4 bg-gradient-to-r from-pink-50 to-rose-50 dark:from-pink-900/20 dark:to-rose-900/20 rounded-xl cursor-move border border-gray-200 dark:border-gray-700 hover:border-pink-500 hover:shadow-lg transition-all duration-300"
                 data-component="pricing-section">
              <div class="flex items-center mb-2">
                <div class="w-8 h-8 bg-pink-500 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-900 dark:text-white">Pricing Section</div>
                  <div class="text-xs text-gray-600 dark:text-gray-400">Professional pricing tables</div>
                </div>
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-500">💰 Cards, table, comparison views</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Enhanced Canvas -->
    <div class="lg:col-span-2">
      <div class="border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-2xl min-h-[700px] p-6 bg-gradient-to-br from-gray-50 to-white dark:from-gray-800 dark:to-gray-900">
        <div id="enhancedCanvas" class="space-y-6 min-h-full">
          <!-- Drop zone message -->
          <div id="emptyCanvas" class="flex flex-col items-center justify-center h-full text-gray-500 dark:text-gray-400">
            <div class="text-center">
              <div class="w-24 h-24 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center mx-auto mb-6">
                <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Build Your Landing Page</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">Drag components from the left panel to start building</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Enhanced Properties Panel -->
    <div class="lg:col-span-1">
      <div class="sticky top-4">
        <div class="bg-gray-50 dark:bg-gray-800 rounded-2xl p-6 border border-gray-200 dark:border-gray-700">
          <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-4 flex items-center">
            <svg class="w-4 h-4 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100-4m0 4v2m0-6V4"/>
            </svg>
            Properties
          </h4>
          
          <div id="propertiesPanel" class="space-y-4">
            <div class="text-center py-8">
              <div class="w-16 h-16 bg-gray-200 dark:bg-gray-700 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/>
                </svg>
              </div>
              <p class="text-sm text-gray-600 dark:text-gray-400">Select a component to edit its properties</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Component Configuration Modal -->
<Modal
  id="componentConfigModal"
  title="Configure Component"
  size="lg"
  closable={true}
  backdrop={true}
  animation="slide"
>
  <EnhancedForm
    id="componentConfigForm"
    fields={componentConfigFields}
    submitButton={{
      text: "Apply Changes",
      variant: "primary",
      size: "lg"
    }}
    variant="modal"
  />
</Modal>

<!-- Enhanced Component Templates -->
<template id="enhanced-hero-template">
  <div class="component-wrapper group border-2 border-gray-200 dark:border-gray-700 rounded-2xl p-6 bg-gradient-to-br from-blue-50 to-purple-50 dark:from-blue-900/20 dark:to-purple-900/20 relative hover:border-blue-500 transition-all duration-300"
       data-component="enhanced-hero">
    <div class="component-controls absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity">
      <div class="flex space-x-1">
        <button class="edit-component p-2 text-gray-500 hover:text-blue-600 bg-white dark:bg-gray-800 rounded-lg shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
        </button>
        <button class="remove-component p-2 text-gray-500 hover:text-red-600 bg-white dark:bg-gray-800 rounded-lg shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
        </button>
      </div>
    </div>
    
    <div class="text-center">
      <div class="inline-flex items-center space-x-2 mb-4">
        <div class="w-2 h-2 bg-yellow-400 rounded-full"></div>
        <span class="text-sm font-medium text-yellow-600 dark:text-yellow-400 editable" data-field="subtitle">AI-Powered Solution</span>
      </div>
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4 editable" data-field="title">
        Transform Your Business Today
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 editable" data-field="description">
        Discover the power of our innovative platform designed to streamline your workflow and boost productivity.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button class="px-8 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-xl font-semibold hover:from-blue-700 hover:to-purple-700 transition-all duration-300 transform hover:scale-105 editable" data-field="primaryCta">
          Get Started Free
        </button>
        <button class="px-8 py-3 bg-white/10 backdrop-blur-sm text-gray-700 dark:text-gray-300 rounded-xl font-semibold hover:bg-white/20 transition-all duration-300 editable" data-field="secondaryCta">
          Watch Demo
        </button>
      </div>
    </div>
  </div>
</template>

<template id="tech-cards-template">
  <div class="component-wrapper group border-2 border-gray-200 dark:border-gray-700 rounded-2xl p-6 bg-white dark:bg-gray-900 relative hover:border-purple-500 transition-all duration-300"
       data-component="tech-cards">
    <div class="component-controls absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity">
      <div class="flex space-x-1">
        <button class="edit-component p-2 text-gray-500 hover:text-blue-600 bg-white dark:bg-gray-800 rounded-lg shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
        </button>
        <button class="remove-component p-2 text-gray-500 hover:text-red-600 bg-white dark:bg-gray-800 rounded-lg shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
        </button>
      </div>
    </div>
    
    <div class="text-center mb-8">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4 editable" data-field="title">
        Powerful Features
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 editable" data-field="description">
        Everything you need to succeed in one platform
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-gradient-to-br from-blue-50 to-purple-50 dark:from-blue-900/20 dark:to-purple-900/20 rounded-2xl p-6 text-center">
        <div class="w-16 h-16 bg-blue-500 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Lightning Fast</h3>
        <p class="text-gray-600 dark:text-gray-400">Optimized for speed and performance</p>
      </div>
      
      <div class="bg-gradient-to-br from-green-50 to-teal-50 dark:from-green-900/20 dark:to-teal-900/20 rounded-2xl p-6 text-center">
        <div class="w-16 h-16 bg-green-500 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Reliable</h3>
        <p class="text-gray-600 dark:text-gray-400">99.9% uptime guarantee</p>
      </div>
      
      <div class="bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 rounded-2xl p-6 text-center">
        <div class="w-16 h-16 bg-purple-500 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Scalable</h3>
        <p class="text-gray-600 dark:text-gray-400">Grows with your business</p>
      </div>
    </div>
  </div>
</template>

<template id="enhanced-form-template">
  <div class="component-wrapper group border-2 border-gray-200 dark:border-gray-700 rounded-2xl p-6 bg-white dark:bg-gray-900 relative hover:border-indigo-500 transition-all duration-300"
       data-component="enhanced-form">
    <div class="component-controls absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity">
      <div class="flex space-x-1">
        <button class="edit-component p-2 text-gray-500 hover:text-blue-600 bg-white dark:bg-gray-800 rounded-lg shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
        </button>
        <button class="remove-component p-2 text-gray-500 hover:text-red-600 bg-white dark:bg-gray-800 rounded-lg shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
        </button>
      </div>
    </div>
    
    <div class="text-center mb-8">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4 editable" data-field="title">
        Get Started Today
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 editable" data-field="description">
        Fill out the form below and we'll get back to you within 24 hours
      </p>
    </div>
    
    <form class="space-y-6 max-w-2xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Name</label>
          <input type="text" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Your name">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Email</label>
          <input type="email" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="your@email.com">
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Message</label>
        <textarea rows="4" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Tell us about your project..."></textarea>
      </div>
      <div class="text-center">
        <button type="submit" class="px-8 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-xl font-semibold hover:from-blue-700 hover:to-purple-700 transition-all duration-300 transform hover:scale-105">
          Send Message
        </button>
      </div>
    </form>
  </div>
</template>

<script>
  class EnhancedPageBuilder {
    constructor() {
      this.canvas = document.getElementById('enhancedCanvas');
      this.emptyCanvas = document.getElementById('emptyCanvas');
      this.propertiesPanel = document.getElementById('propertiesPanel');
      this.selectedComponent = null;
      this.pageData = [];
      
      this.init();
    }

    init() {
      this.initDragAndDrop();
      this.initEventListeners();
      this.initComponentTemplates();
    }

    initDragAndDrop() {
      const draggableComponents = document.querySelectorAll('.draggable-component');
      draggableComponents.forEach(component => {
        component.draggable = true;
        component.addEventListener('dragstart', this.handleDragStart.bind(this));
      });

      this.canvas.addEventListener('dragover', this.handleDragOver.bind(this));
      this.canvas.addEventListener('drop', this.handleDrop.bind(this));
    }

    initEventListeners() {
      const saveBtn = document.querySelector('.save-btn');
      const previewBtn = document.querySelector('.preview-btn');
      
      if (saveBtn) {
        saveBtn.addEventListener('click', this.savePage.bind(this));
      }
      
      if (previewBtn) {
        previewBtn.addEventListener('click', this.previewPage.bind(this));
      }
    }

    initComponentTemplates() {
      // Initialize component templates with enhanced functionality
      const templates = ['enhanced-hero', 'tech-cards', 'enhanced-form'];
      
      templates.forEach(templateId => {
        const template = document.getElementById(`${templateId}-template`);
        if (template) {
          // Add component-specific initialization
          this.initComponentTemplate(templateId, template);
        }
      });
    }

    initComponentTemplate(templateId, template) {
      // Add template-specific initialization logic
      console.log(`Initializing template: ${templateId}`);
    }

    handleDragStart(e) {
      e.dataTransfer.setData('text/plain', e.target.dataset.component);
      e.target.style.opacity = '0.5';
    }

    handleDragOver(e) {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'copy';
    }

    handleDrop(e) {
      e.preventDefault();
      const componentType = e.dataTransfer.getData('text/plain');
      this.addComponent(componentType);
      
      // Reset drag source opacity
      document.querySelectorAll('.draggable-component').forEach(comp => {
        comp.style.opacity = '1';
      });
    }

    addComponent(componentType) {
      const template = document.getElementById(`${componentType}-template`);
      if (!template) return;

      const component = template.content.cloneNode(true);
      
      // Add enhanced event listeners
      const wrapper = component.querySelector('.component-wrapper');
      wrapper.addEventListener('click', this.selectComponent.bind(this));
      
      // Enhanced remove button
      const removeBtn = component.querySelector('.remove-component');
      removeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        this.removeComponent(e);
      });
      
      // Enhanced edit button
      const editBtn = component.querySelector('.edit-component');
      editBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        this.editComponent(e);
      });

      // Add to canvas with animation
      this.canvas.appendChild(component);
      this.emptyCanvas.style.display = 'none';

      // Update page data
      this.pageData.push({
        type: componentType,
        id: Date.now(),
        data: this.getDefaultComponentData(componentType)
      });

      // Add entrance animation
      const addedComponent = this.canvas.lastElementChild;
      addedComponent.style.opacity = '0';
      addedComponent.style.transform = 'translateY(20px)';
      
      setTimeout(() => {
        addedComponent.style.transition = 'all 0.3s ease';
        addedComponent.style.opacity = '1';
        addedComponent.style.transform = 'translateY(0)';
      }, 100);
    }

    selectComponent(e) {
      // Enhanced selection with visual feedback
      const prevSelected = this.canvas.querySelector('.selected');
      if (prevSelected) {
        prevSelected.classList.remove('selected');
      }

      const component = e.currentTarget;
      component.classList.add('selected');
      this.selectedComponent = component;

      // Update properties panel with enhanced UI
      this.updatePropertiesPanel(component);
    }

    removeComponent(e) {
      e.stopPropagation();
      const component = e.target.closest('.component-wrapper');
      
      // Add exit animation
      component.style.transition = 'all 0.3s ease';
      component.style.opacity = '0';
      component.style.transform = 'translateY(-20px)';
      
      setTimeout(() => {
        component.remove();
        
        // Show empty canvas if no components
        if (this.canvas.children.length === 1) {
          this.emptyCanvas.style.display = 'flex';
        }
      }, 300);
    }

    editComponent(e) {
      e.stopPropagation();
      const component = e.target.closest('.component-wrapper');
      this.selectComponent({ currentTarget: component });
      
      // Open configuration modal
      const openModal = window.openComponentConfigModal;
      if (openModal) {
        openModal();
      }
    }

    updatePropertiesPanel(component) {
      const componentType = component.dataset.component;
      
      let html = `
        <div class="mb-6">
          <h5 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">${this.getComponentDisplayName(componentType)}</h5>
          <p class="text-sm text-gray-600 dark:text-gray-400">${this.getComponentDescription(componentType)}</p>
        </div>
      `;
      
      const properties = this.getComponentProperties(componentType);
      
      properties.forEach(prop => {
        html += `
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              ${prop.label}
            </label>
            ${this.renderPropertyInput(prop)}
          </div>
        `;
      });
      
      html += `
        <div class="pt-4 border-t border-gray-200 dark:border-gray-700">
          <button class="w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors" onclick="openComponentConfigModal()">
            Advanced Settings
          </button>
        </div>
      `;
      
      this.propertiesPanel.innerHTML = html;
    }

    getComponentDisplayName(componentType) {
      const names = {
        'enhanced-hero': 'Enhanced Hero',
        'tech-cards': 'Tech Cards',
        'enhanced-form': 'Enhanced Form',
        'pricing-section': 'Pricing Section',
        'stats-section': 'Stats Section'
      };
      return names[componentType] || 'Component';
    }

    getComponentDescription(componentType) {
      const descriptions = {
        'enhanced-hero': 'Advanced hero section with images, videos, and animations',
        'tech-cards': 'Modern feature cards with multiple variants',
        'enhanced-form': 'Professional form with validation and advanced features',
        'pricing-section': 'Comprehensive pricing tables with multiple layouts',
        'stats-section': 'Animated statistics with icons and counters'
      };
      return descriptions[componentType] || 'A component for your landing page';
    }

    renderPropertyInput(prop) {
      switch (prop.type) {
        case 'text':
          return `<input type="text" class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent" value="${prop.value}" data-field="${prop.field}">`;
        case 'textarea':
          return `<textarea class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent" rows="3" data-field="${prop.field}">${prop.value}</textarea>`;
        case 'select':
          return `<select class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent" data-field="${prop.field}">
            ${prop.options.map(opt => `<option value="${opt.value}" ${opt.value === prop.value ? 'selected' : ''}>${opt.label}</option>`).join('')}
          </select>`;
        case 'color':
          return `<input type="color" class="w-full h-10 border border-gray-300 dark:border-gray-600 rounded-lg" value="${prop.value}" data-field="${prop.field}">`;
        case 'checkbox':
          return `<div class="flex items-center">
            <input type="checkbox" class="w-4 h-4 text-blue-600 rounded focus:ring-blue-500" ${prop.value ? 'checked' : ''} data-field="${prop.field}">
            <label class="ml-2 text-sm text-gray-700 dark:text-gray-300">Enable</label>
          </div>`;
        default:
          return '';
      }
    }

    getDefaultComponentData(componentType) {
      const defaults = {
        'enhanced-hero': {
          title: 'Transform Your Business Today',
          subtitle: 'AI-Powered Solution',
          description: 'Discover the power of our innovative platform',
          primaryCta: 'Get Started Free',
          secondaryCta: 'Watch Demo'
        },
        'tech-cards': {
          title: 'Powerful Features',
          description: 'Everything you need to succeed',
          cards: []
        },
        'enhanced-form': {
          title: 'Get Started Today',
          description: 'Fill out the form below',
          fields: []
        }
      };
      
      return defaults[componentType] || {};
    }

    getComponentProperties(componentType) {
      const properties = {
        'enhanced-hero': [
          { field: 'title', label: 'Title', type: 'text', value: 'Transform Your Business Today' },
          { field: 'subtitle', label: 'Subtitle', type: 'text', value: 'AI-Powered Solution' },
          { field: 'description', label: 'Description', type: 'textarea', value: 'Discover the power of our innovative platform' },
          { field: 'animate', label: 'Animations', type: 'checkbox', value: true }
        ],
        'tech-cards': [
          { field: 'title', label: 'Section Title', type: 'text', value: 'Powerful Features' },
          { field: 'description', label: 'Description', type: 'textarea', value: 'Everything you need to succeed' },
          { field: 'variant', label: 'Card Style', type: 'select', value: 'modern', options: [
            { value: 'modern', label: 'Modern' },
            { value: 'gradient', label: 'Gradient' },
            { value: 'neon', label: 'Neon' },
            { value: 'glass', label: 'Glass' }
          ]}
        ],
        'enhanced-form': [
          { field: 'title', label: 'Form Title', type: 'text', value: 'Get Started Today' },
          { field: 'description', label: 'Description', type: 'textarea', value: 'Fill out the form below' },
          { field: 'variant', label: 'Form Style', type: 'select', value: 'default', options: [
            { value: 'default', label: 'Default' },
            { value: 'inline', label: 'Inline' },
            { value: 'modal', label: 'Modal' }
          ]}
        ]
      };
      
      return properties[componentType] || [];
    }

    savePage() {
      const pageData = {
        components: this.pageData,
        timestamp: Date.now()
      };
      
      console.log('Saving enhanced page:', pageData);
      
      // Show success notification
      this.showNotification('Page saved successfully!', 'success');
    }

    previewPage() {
      // Generate preview URL
      const previewUrl = '#';
      window.open(previewUrl, '_blank');
    }

    showNotification(message, type = 'info') {
      // Create notification element
      const notification = document.createElement('div');
      notification.className = `fixed top-4 right-4 z-50 p-4 rounded-lg shadow-lg transition-all duration-300 ${
        type === 'success' ? 'bg-green-500' : 'bg-blue-500'
      } text-white`;
      notification.textContent = message;
      
      document.body.appendChild(notification);
      
      // Remove after 3 seconds
      setTimeout(() => {
        notification.style.opacity = '0';
        setTimeout(() => {
          document.body.removeChild(notification);
        }, 300);
      }, 3000);
    }
  }

  // Initialize enhanced page builder
  document.addEventListener('DOMContentLoaded', () => {
    new EnhancedPageBuilder();
  });
</script>

<style>
  .component-wrapper {
    transition: all 0.3s ease;
  }

  .component-wrapper:hover {
    transform: translateY(-2px);
  }

  .component-wrapper.selected {
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  .component-wrapper:hover .component-controls {
    opacity: 1;
  }

  .editable {
    cursor: pointer;
    outline: none;
    border: 2px solid transparent;
    border-radius: 4px;
    transition: border-color 0.2s;
  }

  .editable:hover {
    border-color: #3b82f6;
  }

  .draggable-component {
    transition: all 0.3s ease;
  }

  .draggable-component:hover {
    transform: translateY(-2px);
  }

  .draggable-component:active {
    transform: scale(0.95);
  }

  /* Enhanced animations */
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .component-category {
    animation: slideIn 0.3s ease;
  }

  .component-category:nth-child(2) {
    animation-delay: 0.1s;
  }

  .component-category:nth-child(3) {
    animation-delay: 0.2s;
  }

  .component-category:nth-child(4) {
    animation-delay: 0.3s;
  }
</style>