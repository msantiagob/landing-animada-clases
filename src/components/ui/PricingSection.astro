---
import { twMerge } from 'tailwind-merge';
import SuperButton from './SuperButton.astro';

interface PricingPlan {
  name: string;
  price: string;
  period: string;
  description: string;
  features: Array<{
    text: string;
    included: boolean;
    highlight?: boolean;
  }>;
  button: {
    text: string;
    href?: string;
    variant?: 'primary' | 'secondary' | 'glow' | 'neon';
    action?: 'link' | 'modal' | 'form';
    modalId?: string;
    formId?: string;
  };
  badge?: {
    text: string;
    color: 'blue' | 'green' | 'purple' | 'pink' | 'yellow';
  };
  popular?: boolean;
}

interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  plans: PricingPlan[];
  billingToggle?: {
    monthly: string;
    yearly: string;
    discount?: string;
  };
  variant?: 'cards' | 'table' | 'comparison';
  columns?: 1 | 2 | 3 | 4;
  animations?: boolean;
  class?: string;
}

const {
  title,
  subtitle,
  description,
  plans,
  billingToggle,
  variant = 'cards',
  columns = 3,
  animations = true,
  class: className = '',
} = Astro.props;

const columnClasses = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 md:grid-cols-2',
  3: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-4'
};

const badgeColors = {
  blue: 'bg-blue-100 text-blue-800 border-blue-200',
  green: 'bg-green-100 text-green-800 border-green-200',
  purple: 'bg-purple-100 text-purple-800 border-purple-200',
  pink: 'bg-pink-100 text-pink-800 border-pink-200',
  yellow: 'bg-yellow-100 text-yellow-800 border-yellow-200'
};
---

<section class={twMerge(`py-20 relative overflow-hidden`, className)}>
  <!-- Background Pattern -->
  <div class="absolute inset-0 bg-gradient-to-br from-blue-50/50 via-purple-50/50 to-pink-50/50 dark:from-blue-900/20 dark:via-purple-900/20 dark:to-pink-900/20"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    {(title || subtitle || description) && (
      <div class={`text-center mb-16 ${animations ? 'animate-slide-up' : ''}`}>
        {subtitle && (
          <p class="text-sm font-semibold text-blue-600 dark:text-blue-400 tracking-wide uppercase mb-2">
            {subtitle}
          </p>
        )}
        {title && (
          <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mb-4">
            {title}
          </h2>
        )}
        {description && (
          <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
            {description}
          </p>
        )}
      </div>
    )}

    <!-- Billing Toggle -->
    {billingToggle && (
      <div class={`flex justify-center mb-12 ${animations ? 'animate-slide-up animation-delay-200' : ''}`}>
        <div class="bg-white dark:bg-gray-800 rounded-full p-1 shadow-lg border border-gray-200 dark:border-gray-700">
          <button
            class="billing-toggle px-6 py-2 rounded-full text-sm font-medium transition-all duration-200 bg-blue-600 text-white"
            data-period="monthly"
          >
            {billingToggle.monthly}
          </button>
          <button
            class="billing-toggle px-6 py-2 rounded-full text-sm font-medium transition-all duration-200 text-gray-700 dark:text-gray-300"
            data-period="yearly"
          >
            {billingToggle.yearly}
            {billingToggle.discount && (
              <span class="ml-1 text-xs bg-green-100 text-green-800 px-2 py-1 rounded">
                {billingToggle.discount}
              </span>
            )}
          </button>
        </div>
      </div>
    )}

    <!-- Pricing Plans -->
    {variant === 'cards' && (
      <div class={`grid ${columnClasses[columns]} gap-8`}>
        {plans.map((plan, index) => (
          <div class={`
            relative bg-white dark:bg-gray-900 rounded-2xl shadow-xl border border-gray-200 dark:border-gray-700
            ${plan.popular ? 'ring-2 ring-blue-500 transform scale-105' : ''}
            hover:shadow-2xl transition-all duration-300 hover:-translate-y-1
            ${animations ? 'animate-slide-up' : ''}
          `}
          style={animations ? `animation-delay: ${index * 200}ms` : ''}
          >
            {/* Popular Badge */}
            {plan.popular && (
              <div class="absolute -top-3 left-1/2 transform -translate-x-1/2">
                <span class="bg-gradient-to-r from-blue-600 to-purple-600 text-white px-4 py-1 rounded-full text-sm font-medium">
                  Most Popular
                </span>
              </div>
            )}

            {/* Custom Badge */}
            {plan.badge && (
              <div class="absolute top-4 right-4">
                <span class={`
                  ${badgeColors[plan.badge.color]} border px-3 py-1 rounded-full text-xs font-medium
                  dark:bg-opacity-20 dark:text-opacity-90
                `}>
                  {plan.badge.text}
                </span>
              </div>
            )}

            <div class="p-8">
              {/* Plan Header */}
              <div class="text-center mb-8">
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
                  {plan.name}
                </h3>
                <p class="text-gray-600 dark:text-gray-400 mb-4">
                  {plan.description}
                </p>
                <div class="flex items-baseline justify-center">
                  <span class="text-4xl font-bold text-gray-900 dark:text-white">
                    {plan.price}
                  </span>
                  <span class="text-gray-600 dark:text-gray-400 ml-1">
                    {plan.period}
                  </span>
                </div>
              </div>

              {/* Features */}
              <ul class="space-y-3 mb-8">
                {plan.features.map((feature, featureIndex) => (
                  <li class="flex items-center">
                    <div class={`
                      w-5 h-5 rounded-full flex items-center justify-center mr-3
                      ${feature.included 
                        ? feature.highlight 
                          ? 'bg-green-500' 
                          : 'bg-blue-500'
                        : 'bg-gray-300 dark:bg-gray-600'
                      }
                    `}>
                      {feature.included ? (
                        <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                      ) : (
                        <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                        </svg>
                      )}
                    </div>
                    <span class={`
                      text-sm ${feature.included 
                        ? 'text-gray-700 dark:text-gray-300' 
                        : 'text-gray-500 dark:text-gray-500 line-through'
                      }
                      ${feature.highlight ? 'font-semibold' : ''}
                    `}>
                      {feature.text}
                    </span>
                  </li>
                ))}
              </ul>

              {/* CTA Button */}
              <SuperButton
                variant={plan.button.variant || (plan.popular ? 'primary' : 'secondary')}
                size="lg"
                text={plan.button.text}
                href={plan.button.action === 'link' ? plan.button.href : undefined}
                class="w-full"
                {...(plan.button.action !== 'link' ? { 
                  'data-action': plan.button.action,
                  'data-target': plan.button.modalId || plan.button.formId
                } : {})}
              />
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Comparison Table -->
    {variant === 'table' && (
      <div class={`overflow-x-auto ${animations ? 'animate-slide-up' : ''}`}>
        <table class="w-full bg-white dark:bg-gray-900 rounded-2xl shadow-xl border border-gray-200 dark:border-gray-700">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <th class="text-left p-6 text-gray-900 dark:text-white font-semibold">Features</th>
              {plans.map((plan, index) => (
                <th class={`text-center p-6 ${plan.popular ? 'bg-blue-50 dark:bg-blue-900/20' : ''}`}>
                  <div class="text-gray-900 dark:text-white font-semibold">{plan.name}</div>
                  <div class="text-2xl font-bold text-gray-900 dark:text-white mt-2">{plan.price}</div>
                  <div class="text-sm text-gray-600 dark:text-gray-400">{plan.period}</div>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {/* Generate comparison rows based on all features */}
            {plans[0].features.map((_, featureIndex) => (
              <tr class="border-b border-gray-200 dark:border-gray-700">
                <td class="p-6 text-gray-700 dark:text-gray-300">
                  {plans[0].features[featureIndex].text}
                </td>
                {plans.map((plan, planIndex) => (
                  <td class={`text-center p-6 ${plan.popular ? 'bg-blue-50 dark:bg-blue-900/20' : ''}`}>
                    {plan.features[featureIndex]?.included ? (
                      <svg class="w-5 h-5 text-green-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                    ) : (
                      <svg class="w-5 h-5 text-gray-400 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                      </svg>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <!-- FAQ Section -->
    <div class={`mt-20 text-center ${animations ? 'animate-slide-up animation-delay-600' : ''}`}>
      <p class="text-gray-600 dark:text-gray-400 mb-4">
        ¿Tienes preguntas sobre nuestros planes?
      </p>
      <SuperButton
        variant="tertiary"
        size="md"
        text="Contactar Ventas"
        href="/contact"
        icon="tabler:message-circle"
      />
    </div>
  </div>
</section>

<script>
  // Billing toggle functionality
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButtons = document.querySelectorAll('.billing-toggle');
    
    toggleButtons.forEach(button => {
      button.addEventListener('click', () => {
        const period = button.getAttribute('data-period');
        
        // Update button states
        toggleButtons.forEach(btn => {
          btn.classList.remove('bg-blue-600', 'text-white');
          btn.classList.add('text-gray-700', 'dark:text-gray-300');
        });
        button.classList.add('bg-blue-600', 'text-white');
        button.classList.remove('text-gray-700', 'dark:text-gray-300');
        
        // Update pricing (if needed)
        // This would be implemented based on your pricing logic
        console.log('Billing period changed to:', period);
      });
    });

    // Enhanced button functionality
    const actionButtons = document.querySelectorAll('[data-action]');
    
    actionButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const action = button.getAttribute('data-action');
        const target = button.getAttribute('data-target');
        
        if (action === 'modal' && target) {
          const openFunction = window[`open${target.charAt(0).toUpperCase() + target.slice(1)}`];
          if (openFunction) openFunction();
        }
        
        if (action === 'form' && target) {
          const formElement = document.getElementById(target);
          if (formElement) {
            formElement.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });
  });
</script>

<style>
  .animation-delay-200 { animation-delay: 200ms; }
  .animation-delay-400 { animation-delay: 400ms; }
  .animation-delay-600 { animation-delay: 600ms; }
</style>