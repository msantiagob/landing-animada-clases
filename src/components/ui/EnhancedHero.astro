---
import { twMerge } from 'tailwind-merge';
import SuperButton from './SuperButton.astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  image?: {
    src: string;
    alt: string;
    position?: 'left' | 'right' | 'background';
    overlay?: boolean;
  };
  video?: {
    src: string;
    poster?: string;
    autoplay?: boolean;
    loop?: boolean;
    muted?: boolean;
  };
  primaryButton?: {
    text: string;
    href: string;
    icon?: string;
    variant?: 'primary' | 'glow' | 'neon';
    action?: 'link' | 'modal' | 'form';
    modalId?: string;
    formId?: string;
  };
  secondaryButton?: {
    text: string;
    href: string;
    icon?: string;
    variant?: 'secondary' | 'glass' | 'tertiary';
    action?: 'link' | 'modal' | 'form';
    modalId?: string;
    formId?: string;
  };
  features?: Array<{
    icon: string;
    text: string;
    highlight?: boolean;
  }>;
  socialProof?: {
    title: string;
    items: Array<{
      logo: string;
      alt: string;
    }>;
  };
  background?: 'gradient' | 'tech' | 'cyber' | 'matrix' | 'light' | 'image' | 'video';
  particles?: boolean;
  animations?: boolean;
  textAlign?: 'left' | 'center' | 'right';
  height?: 'screen' | 'auto' | 'tall';
  class?: string;
}

const {
  title,
  subtitle,
  description,
  image,
  video,
  primaryButton,
  secondaryButton,
  features,
  socialProof,
  background = 'gradient',
  particles = false,
  animations = true,
  textAlign = 'center',
  height = 'screen',
  class: className = '',
} = Astro.props;

const heightClasses = {
  screen: 'min-h-screen',
  auto: 'min-h-[60vh]',
  tall: 'min-h-[80vh]'
};

const backgroundClasses = {
  gradient: 'bg-gradient-to-br from-blue-900 via-purple-900 to-pink-900',
  tech: 'bg-tech',
  cyber: 'bg-cyber',
  matrix: 'bg-matrix',
  light: 'bg-gradient-to-br from-blue-50 via-purple-50 to-pink-50',
  image: 'bg-cover bg-center',
  video: 'relative overflow-hidden'
};

const textAlignClasses = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right'
};

const containerClasses = {
  left: 'justify-start',
  center: 'justify-center',
  right: 'justify-end'
};

const buttonHandler = (button: any) => {
  if (button.action === 'modal' && button.modalId) {
    return `onclick="open${button.modalId.charAt(0).toUpperCase() + button.modalId.slice(1)}()"`;
  }
  if (button.action === 'form' && button.formId) {
    return `onclick="document.getElementById('${button.formId}').scrollIntoView({behavior: 'smooth'})"`;
  }
  return '';
};
---

<section 
  class={twMerge(
    `relative ${heightClasses[height]} ${backgroundClasses[background]} 
     flex items-center justify-center overflow-hidden`,
    className
  )}
  style={background === 'image' && image?.src ? `background-image: url('${image.src}')` : ''}
>
  <!-- Background Video -->
  {video && background === 'video' && (
    <video
      class="absolute inset-0 w-full h-full object-cover"
      poster={video.poster}
      autoplay={video.autoplay}
      loop={video.loop}
      muted={video.muted}
      playsinline
    >
      <source src={video.src} type="video/mp4" />
    </video>
  )}

  <!-- Background Overlay -->
  {(background === 'image' || background === 'video') && image?.overlay && (
    <div class="absolute inset-0 bg-black/40 dark:bg-black/60"></div>
  )}

  <!-- Particles Effect -->
  {particles && (
    <div class="absolute inset-0 particles opacity-30"></div>
  )}

  <!-- Geometric Shapes -->
  {animations && (
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute w-64 h-64 bg-blue-500/10 rounded-full blur-3xl animate-float top-1/4 left-1/4"></div>
      <div class="absolute w-48 h-48 bg-purple-500/10 rounded-full blur-3xl animate-float animation-delay-2000 top-1/3 right-1/3"></div>
      <div class="absolute w-32 h-32 bg-pink-500/10 rounded-full blur-3xl animate-float animation-delay-4000 bottom-1/4 left-1/3"></div>
    </div>
  )}

  <!-- Content Container -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class={`grid ${image && image.position !== 'background' ? 'lg:grid-cols-2' : 'grid-cols-1'} gap-12 items-center`}>
      
      <!-- Text Content -->
      <div class={`${textAlignClasses[textAlign]} ${image?.position === 'right' ? 'lg:order-1' : ''}`}>
        {subtitle && (
          <div class={`inline-flex items-center space-x-2 mb-4 ${animations ? 'animate-slide-up' : ''}`}>
            <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <span class="text-sm font-medium text-yellow-400 dark:text-yellow-300">{subtitle}</span>
          </div>
        )}

        <h1 class={`text-4xl sm:text-5xl lg:text-6xl font-bold text-white dark:text-white mb-6 
                   ${animations ? 'animate-slide-up animation-delay-200' : ''}`}>
          <span class="text-gradient">{title}</span>
        </h1>

        {description && (
          <p class={`text-xl text-gray-200 dark:text-gray-300 mb-8 max-w-2xl 
                     ${textAlign === 'center' ? 'mx-auto' : ''} 
                     ${animations ? 'animate-slide-up animation-delay-400' : ''}`}>
            {description}
          </p>
        )}

        <!-- Action Buttons -->
        {(primaryButton || secondaryButton) && (
          <div class={`flex flex-col sm:flex-row gap-4 ${containerClasses[textAlign]} 
                      ${animations ? 'animate-slide-up animation-delay-600' : ''}`}>
            {primaryButton && (
              <SuperButton
                variant={primaryButton.variant || 'primary'}
                size="lg"
                text={primaryButton.text}
                href={primaryButton.action === 'link' ? primaryButton.href : undefined}
                icon={primaryButton.icon}
                pulse={true}
                {...(primaryButton.action !== 'link' ? { 
                  'data-action': primaryButton.action,
                  'data-target': primaryButton.modalId || primaryButton.formId
                } : {})}
              />
            )}
            {secondaryButton && (
              <SuperButton
                variant={secondaryButton.variant || 'secondary'}
                size="lg"
                text={secondaryButton.text}
                href={secondaryButton.action === 'link' ? secondaryButton.href : undefined}
                icon={secondaryButton.icon}
                {...(secondaryButton.action !== 'link' ? { 
                  'data-action': secondaryButton.action,
                  'data-target': secondaryButton.modalId || secondaryButton.formId
                } : {})}
              />
            )}
          </div>
        )}

        <!-- Features -->
        {features && (
          <div class={`flex flex-wrap gap-6 mt-8 ${containerClasses[textAlign]} 
                      ${animations ? 'animate-slide-up animation-delay-800' : ''}`}>
            {features.map((feature, index) => (
              <div class="flex items-center space-x-2">
                <div class={`w-5 h-5 rounded-full ${feature.highlight ? 'bg-green-500' : 'bg-blue-500'} 
                           flex items-center justify-center`}>
                  <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <span class="text-sm text-gray-300 dark:text-gray-400">{feature.text}</span>
              </div>
            ))}
          </div>
        )}

        <!-- Social Proof -->
        {socialProof && (
          <div class={`mt-12 ${textAlign === 'center' ? 'text-center' : ''} 
                      ${animations ? 'animate-slide-up animation-delay-1000' : ''}`}>
            <p class="text-sm text-gray-400 dark:text-gray-500 mb-4">{socialProof.title}</p>
            <div class="flex flex-wrap items-center gap-6 justify-center">
              {socialProof.items.map((item, index) => (
                <img
                  src={item.logo}
                  alt={item.alt}
                  class="h-8 opacity-60 hover:opacity-100 transition-opacity duration-300 filter grayscale hover:grayscale-0"
                  loading="lazy"
                />
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Image Content -->
      {image && image.position !== 'background' && (
        <div class={`relative ${animations ? 'animate-slide-right animation-delay-400' : ''}`}>
          <div class="relative">
            {image.src.endsWith('.mp4') ? (
              <video
                class="w-full h-auto rounded-2xl shadow-2xl"
                poster={image.alt}
                autoplay
                loop
                muted
                playsinline
              >
                <source src={image.src} type="video/mp4" />
              </video>
            ) : (
              <img
                src={image.src}
                alt={image.alt}
                class="w-full h-auto rounded-2xl shadow-2xl"
                loading="lazy"
              />
            )}
            
            <!-- Decorative elements -->
            {animations && (
              <>
                <div class="absolute -top-4 -right-4 w-24 h-24 bg-gradient-to-br from-blue-500 to-purple-500 rounded-full blur-2xl opacity-20 animate-pulse"></div>
                <div class="absolute -bottom-4 -left-4 w-32 h-32 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full blur-2xl opacity-20 animate-pulse animation-delay-2000"></div>
              </>
            )}
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- Scroll Indicator -->
  {height === 'screen' && (
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </div>
  )}
</section>

<script>
  // Enhanced button functionality
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('[data-action]');
    
    buttons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const action = button.getAttribute('data-action');
        const target = button.getAttribute('data-target');
        
        if (action === 'modal' && target) {
          const openFunction = window[`open${target.charAt(0).toUpperCase() + target.slice(1)}`];
          if (openFunction) openFunction();
        }
        
        if (action === 'form' && target) {
          const formElement = document.getElementById(target);
          if (formElement) {
            formElement.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });
  });
</script>

<style>
  .animation-delay-200 { animation-delay: 200ms; }
  .animation-delay-400 { animation-delay: 400ms; }
  .animation-delay-600 { animation-delay: 600ms; }
  .animation-delay-800 { animation-delay: 800ms; }
  .animation-delay-1000 { animation-delay: 1000ms; }
  .animation-delay-2000 { animation-delay: 2000ms; }
  .animation-delay-4000 { animation-delay: 4000ms; }
</style>