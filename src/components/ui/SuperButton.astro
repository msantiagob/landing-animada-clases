---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';

interface Props {
  variant?: 'primary' | 'secondary' | 'glow' | 'neon' | 'glass';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  text: string;
  icon?: string;
  iconPosition?: 'left' | 'right';
  href?: string;
  target?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  pulse?: boolean;
  loading?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  text,
  icon,
  iconPosition = 'right',
  href,
  target,
  type,
  disabled = false,
  pulse = false,
  loading = false,
  class: className = '',
} = Astro.props;

const variants = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  glow: 'btn-glow',
  neon: 'btn-neon',
  glass: 'btn-glass',
};

const sizes = {
  sm: 'py-2 px-4 text-sm',
  md: 'py-3 px-6 text-base',
  lg: 'py-4 px-8 text-lg',
  xl: 'py-5 px-10 text-xl',
};

const baseClasses =
  'relative inline-flex items-center justify-center font-semibold transition-all duration-300 transform focus:outline-none focus:ring-2 focus:ring-offset-2';
const pulseClass = pulse ? 'animate-pulse-glow' : '';
const disabledClass = disabled ? 'opacity-50 cursor-not-allowed' : '';

const classes = twMerge(baseClasses, variants[variant], sizes[size], pulseClass, disabledClass, className);

const iconClasses = size === 'sm' ? 'w-4 h-4' : size === 'lg' ? 'w-6 h-6' : size === 'xl' ? 'w-7 h-7' : 'w-5 h-5';
const iconSpacing = iconPosition === 'left' ? 'mr-2' : 'ml-2';
---

{
  type === 'button' || type === 'submit' || type === 'reset' ? (
    <button type={type} class={classes} disabled={disabled || loading}>
      {loading && (
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-white" />
        </div>
      )}
      <span class={loading ? 'opacity-0' : ''}>
        {icon && iconPosition === 'left' && <Icon name={icon} class={twMerge(iconClasses, iconSpacing)} />}
        {text}
        {icon && iconPosition === 'right' && <Icon name={icon} class={twMerge(iconClasses, iconSpacing)} />}
      </span>
    </button>
  ) : (
    <a href={href} class={classes} {...(target ? { target, rel: 'noopener noreferrer' } : {})}>
      {icon && iconPosition === 'left' && <Icon name={icon} class={twMerge(iconClasses, iconSpacing)} />}
      {text}
      {icon && iconPosition === 'right' && <Icon name={icon} class={twMerge(iconClasses, iconSpacing)} />}
    </a>
  )
}
