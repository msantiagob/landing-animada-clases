---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';

interface Props {
  title: string;
  description: string;
  icon?: string;
  variant?: 'modern' | 'gradient' | 'neon' | 'glass';
  size?: 'sm' | 'md' | 'lg';
  animate?: boolean;
  hover?: boolean;
  glow?: boolean;
  class?: string;
}

const {
  title,
  description,
  icon,
  variant = 'modern',
  size = 'md',
  animate = true,
  hover = true,
  glow = false,
  class: className = '',
} = Astro.props;

const variants = {
  modern: 'card-modern',
  gradient: 'card-gradient',
  neon: 'card-neon',
  glass: 'glass rounded-3xl',
};

const sizes = {
  sm: 'p-6',
  md: 'p-8',
  lg: 'p-10',
};

const animateClass = animate ? 'animate-slide-up' : '';
const hoverClass = hover ? 'hover-lift' : '';
const glowClass = glow ? 'hover-glow' : '';

const classes = twMerge(
  'relative',
  variants[variant],
  sizes[size],
  animateClass,
  hoverClass,
  glowClass,
  className
);
---

<div class={classes}>
  {icon && (
    <div class="flex items-center justify-center w-16 h-16 mb-6 mx-auto">
      <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-600 rounded-2xl flex items-center justify-center animate-float">
        <Icon name={icon} class="w-8 h-8 text-white" />
      </div>
    </div>
  )}
  
  <h3 class="text-2xl font-bold mb-4 text-gradient text-center">
    {title}
  </h3>
  
  <p class="text-gray-300 leading-relaxed text-center mb-6">
    {description}
  </p>
  
  <div class="flex justify-center">
    <slot />
  </div>
  
  <!-- Decorative elements -->
  {variant === 'neon' && (
    <div class="absolute -top-1 -right-1 w-4 h-4 bg-cyan-400 rounded-full opacity-50 animate-pulse"></div>
  )}
  
  {variant === 'gradient' && (
    <div class="absolute -bottom-2 -left-2 w-8 h-8 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full opacity-30 blur-sm"></div>
  )}
</div>