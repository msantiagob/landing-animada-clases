---
import { Icon } from 'astro-icon/components';
import SuperButton from './SuperButton.astro';
import { twMerge } from 'tailwind-merge';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  primaryButton?: {
    text: string;
    href: string;
    icon?: string;
  };
  secondaryButton?: {
    text: string;
    href: string;
    icon?: string;
  };
  background?: 'tech' | 'cyber' | 'matrix';
  particles?: boolean;
  class?: string;
}

const {
  title,
  subtitle,
  description,
  primaryButton,
  secondaryButton,
  background = 'tech',
  particles = true,
  class: className = '',
} = Astro.props;

const backgroundClasses = {
  tech: 'bg-tech',
  cyber: 'bg-cyber',
  matrix: 'bg-matrix',
};

const containerClasses = twMerge(
  'relative min-h-screen flex items-center justify-center overflow-hidden',
  backgroundClasses[background],
  particles ? 'particles' : '',
  className
);
---

<section class={containerClasses}>
  <!-- Floating geometric shapes -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-20 left-20 w-20 h-20 border-2 border-white/20 rounded-full animate-float"></div>
    <div class="absolute top-40 right-32 w-16 h-16 border-2 border-purple-400/30 rounded-lg animate-float" style="animation-delay: 1s;"></div>
    <div class="absolute bottom-32 left-32 w-12 h-12 border-2 border-cyan-400/40 rounded-full animate-float" style="animation-delay: 2s;"></div>
    <div class="absolute bottom-20 right-20 w-24 h-24 border-2 border-pink-400/25 rounded-2xl animate-float" style="animation-delay: 3s;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="max-w-5xl mx-auto">
      <!-- Subtitle -->
      {subtitle && (
        <div class="mb-8 animate-fade-in">
          <span class="inline-flex items-center px-6 py-3 rounded-full bg-white/10 backdrop-blur-xl border border-white/20 text-white/90 text-lg font-medium">
            <Icon name="tabler:star" class="w-5 h-5 mr-2 text-yellow-400" />
            {subtitle}
          </span>
        </div>
      )}
      
      <!-- Main title -->
      <h1 class="text-6xl md:text-8xl lg:text-9xl font-black mb-8 animate-slide-up">
        <span class="text-gradient">{title}</span>
      </h1>
      
      <!-- Description -->
      <p class="text-xl md:text-2xl lg:text-3xl text-white/90 mb-12 max-w-4xl mx-auto leading-relaxed animate-slide-up" style="animation-delay: 0.2s;">
        {description}
      </p>
      
      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center animate-slide-up" style="animation-delay: 0.4s;">
        {primaryButton && (
          <SuperButton
            variant="glow"
            size="xl"
            text={primaryButton.text}
            href={primaryButton.href}
            icon={primaryButton.icon}
            pulse={true}
          />
        )}
        
        {secondaryButton && (
          <SuperButton
            variant="glass"
            size="xl"
            text={secondaryButton.text}
            href={secondaryButton.href}
            icon={secondaryButton.icon}
          />
        )}
      </div>
    </div>
  </div>

  <!-- Bottom gradient overlay -->
  <div class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-t from-black/50 to-transparent"></div>
  
  <!-- Animated grid -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 50px 50px; animation: gridMove 20s linear infinite;"></div>
  </div>
</section>

<style>
  @keyframes gridMove {
    0% { transform: translate(0, 0); }
    100% { transform: translate(50px, 50px); }
  }
</style>